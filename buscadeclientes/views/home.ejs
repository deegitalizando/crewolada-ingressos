<%- include('partials/head', { title: 'Nova busca' }) %>
<%- include('partials/nav', { active: 'home' }) %>
<div class="container">
  <h1>Encontrar clientes potenciais</h1>
  <p class="subtitle">Escolha o segmento e a regiao. A ferramenta busca os negocios no Google Maps e ja aponta quais nao tem site, tem site generico (so rede social) ou desatualizado.</p>

  <% if (!env.googleMaps) { %>
    <div class="alert error">
      A chave do Google Maps (GOOGLE_MAPS_API_KEY) ainda nao esta configurada no .env. Configure-a antes de buscar
      (veja o README para o passo a passo).
    </div>
  <% } %>
  <% if (typeof error !== 'undefined' && error) { %>
    <div class="alert error"><%= error %></div>
  <% } %>

  <div class="card">
    <form method="post" action="/buscas">
      <div class="form-row">
        <div>
          <label>Segmento</label>
          <select name="segmentKey" id="segmentKey">
            <% segments.forEach(function(s) { %>
              <option value="<%= s.key %>"><%= s.label %></option>
            <% }) %>
            <option value="personalizado">Outro (digitar termo)</option>
          </select>
        </div>
        <div id="customKeywordWrap" style="display:none;">
          <label>Qual termo buscar?</label>
          <input type="text" name="customKeyword" placeholder="ex: estudio de tatuagem" />
        </div>
      </div>

      <div class="form-row">
        <div>
          <label>Regiao (cidade, bairro ou endereco)</label>
          <input type="text" name="location" placeholder="ex: Bangu, Rio de Janeiro - RJ" required />
        </div>
        <div>
          <label>Raio de busca (km)</label>
          <input type="number" name="radiusKm" min="1" max="50" value="5" />
        </div>
      </div>

      <button class="btn" type="submit">Buscar negocios</button>
    </form>
  </div>

  <h2>Buscas recentes</h2>
  <% if (!searches.length) { %>
    <p class="muted">Nenhuma busca ainda.</p>
  <% } else { %>
    <div class="card" style="padding:0;">
      <table>
        <thead>
          <tr><th>Segmento</th><th>Regiao</th><th>Status</th><th>Resultados</th><th>Data</th><th></th></tr>
        </thead>
        <tbody>
          <% searches.forEach(function(s) { %>
            <tr>
              <td><%= s.segmentLabel %></td>
              <td><%= s.location.query %> (<%= s.radiusKm %>km)</td>
              <td>
                <% if (s.status === 'processando') { %><span class="spinner"></span> processando<% } %>
                <% if (s.status === 'concluida') { %>concluida<% } %>
                <% if (s.status === 'erro') { %><span style="color:#dc2626;">erro</span><% } %>
              </td>
              <td><%= s.processedCount %>/<%= s.totalFound %></td>
              <td class="muted"><%= new Date(s.createdAt).toLocaleString('pt-BR') %></td>
              <td><a href="/buscas/<%= s.id %>">ver resultados &rarr;</a></td>
            </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  <% } %>
</div>
<script>
  const select = document.getElementById('segmentKey');
  const wrap = document.getElementById('customKeywordWrap');
  function syncCustom() {
    wrap.style.display = select.value === 'personalizado' ? 'block' : 'none';
  }
  select.addEventListener('change', syncCustom);
  syncCustom();
</script>
</body>
</html>
