<%- include('partials/head', { title: 'Editar site - ' + lead.name }) %>
<%- include('partials/nav', { active: 'leads' }) %>
<div class="container">
  <p><a href="/leads/<%= lead.id %>">&larr; voltar para o lead</a></p>
  <h1>Editar landing page - <%= lead.name %></h1>

  <div class="card">
    <form method="post" action="/leads/<%= lead.id %>/editar">
      <label>Titulo principal (headline)</label>
      <input type="text" name="headline" value="<%= lead.site.headline %>" />

      <label>Subtitulo</label>
      <input type="text" name="subheadline" value="<%= lead.site.subheadline %>" />

      <label>Texto "Sobre"</label>
      <textarea name="aboutText" rows="4"><%= lead.site.aboutText %></textarea>

      <label>Diferenciais (um por linha)</label>
      <textarea name="highlights" rows="4"><%= (lead.site.highlights || []).join('\n') %></textarea>

      <div class="form-row">
        <div>
          <label>Cor principal</label>
          <input type="color" name="primaryColor" value="<%= lead.site.primaryColor %>" />
        </div>
        <div>
          <label>Texto do botao de WhatsApp</label>
          <input type="text" name="ctaLabel" value="<%= lead.site.ctaLabel %>" />
        </div>
      </div>

      <label>Mensagem pre-preenchida no botao de WhatsApp</label>
      <input type="text" name="ctaMessage" value="<%= lead.site.ctaMessage %>" />

      <div class="form-row">
        <div>
          <label><input type="checkbox" name="showGallery" style="width:auto;display:inline;" <%= lead.site.showGallery ? 'checked' : '' %> /> Mostrar galeria de fotos</label>
        </div>
        <div>
          <label><input type="checkbox" name="showMap" style="width:auto;display:inline;" <%= lead.site.showMap ? 'checked' : '' %> /> Mostrar mapa</label>
        </div>
      </div>

      <button class="btn" type="submit">Salvar alteracoes</button>
    </form>
  </div>

  <div class="card">
    <h2>Previa atual</h2>
    <iframe class="preview-frame" src="/p/<%= lead.id %>"></iframe>
  </div>
</div>
</body>
</html>
