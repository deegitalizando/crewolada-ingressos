# Porta em que este app roda (sera acessado via proxy reverso em /buscadeclientes)
PORT=3100

# URL publica onde a ferramenta fica acessivel (sem barra no final), usada para
# montar o link de previa que e enviado ao cliente por WhatsApp/e-mail.
# Ex: https://deegitalizando.com/buscadeclientes
BASE_URL=https://deegitalizando.com/buscadeclientes

# Login simples para acessar a ferramenta (ela fica publica so a rota /p/:slug,
# que e a previa do site enviada ao lead - o resto exige login)
ADMIN_LOGIN=troque-este-login
ADMIN_PASSWORD=troque-esta-senha

# ---------------------------------------------------------------------------
# Google Maps Platform - https://console.cloud.google.com/
# Precisa habilitar (com faturamento ativo): "Geocoding API" e "Places API".
# ---------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=SUA_CHAVE_AQUI

# Quantos resultados buscar por pagina no Google Places (max 20 por pagina,
# ate 3 paginas = 60 resultados por busca "carregando mais").
PLACES_PAGE_SIZE=20

# Inclui avaliacoes/reviews do Google (campo "Atmosphere Data", cobrado a parte
# pelo Google). Deixe "false" se quiser economizar na fatura do Google.
INCLUDE_REVIEWS=false

# ---------------------------------------------------------------------------
# Envio de WhatsApp - dois modos possiveis (escolha um em MESSAGING_MODE):
#
#  "n8n"      (recomendado, reaproveita seu n8n + Evolution API ja configurados)
#             Crie um workflow com um node Webhook + um node da Evolution API
#             (igual ao workflow "WORKFLOW CREWOLADA" que ja existe na sua VPS),
#             recebendo { telefone, mensagem, leadId, nomeNegocio } e chamando
#             "Send Text" da Evolution API com esses dados.
#
#  "evolution_direct"  (chama a Evolution API direto, sem passar pelo n8n)
# ---------------------------------------------------------------------------
MESSAGING_MODE=n8n

# Usado quando MESSAGING_MODE=n8n
N8N_PROSPECCAO_WHATSAPP_WEBHOOK_URL=https://n8n-n8n.wmbyj1.easypanel.host/webhook/buscadeclientes-whatsapp

# Usado quando MESSAGING_MODE=evolution_direct
EVOLUTION_API_URL=https://sua-evolution-api.com
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=

# DDI padrao usado para normalizar telefones sem codigo de pais (Brasil = 55)
DEFAULT_COUNTRY_CODE=55

# ---------------------------------------------------------------------------
# Envio de e-mail (opcional, so e usado quando a ferramenta descobre um e-mail
# do negocio no site dele). Qualquer provedor SMTP funciona (Gmail, SendGrid,
# Amazon SES, etc).
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Deegitalizando <contato@deegitalizando.com>"
