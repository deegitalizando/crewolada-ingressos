# URL publica onde este app estara acessivel (sem barra no final)
# Precisa ser publica e HTTPS para o Mercado Pago conseguir chamar o webhook
BASE_URL=https://seu-dominio.com

PORT=3000

# Dados do evento
EVENT_NAME=Crewolada
EVENT_DATE_LABEL=10/10/2026
EVENT_VENUE=Bangu Atletico Clube - Rio de Janeiro/RJ
MAX_QTY_PER_ORDER=10
# Preco e quantidade de cada lote sao definidos em src/lotes.js (nao aqui),
# pois o preco muda automaticamente conforme os ingressos vao sendo vendidos.

# Mercado Pago (Checkout Pro)
# Access token da sua conta/aplicacao Mercado Pago (Credenciais de producao ou teste)
MP_ACCESS_TOKEN=SEU_ACCESS_TOKEN_AQUI
# Public Key da mesma aplicacao (usada no navegador para o checkout embutido)
MP_PUBLIC_KEY=SUA_PUBLIC_KEY_AQUI
# Secreto de assinatura do webhook (Portal de desenvolvedores > Webhooks > detalhes)
# Opcional, mas recomendado em producao para validar a origem das notificacoes
MP_WEBHOOK_SECRET=

# n8n - webhook do workflow "WORKFLOW CREWOLADA" (node "Receber Ingresso Aprovado")
# que recebe o aviso de pagamento aprovado e dispara o ingresso via Evolution API
N8N_WEBHOOK_URL=https://n8n-n8n.wmbyj1.easypanel.host/webhook/crewolada-whatsapp

# Senha simples para acessar o validador de ingressos na entrada do evento
VALIDATOR_PASSWORD=troque-esta-senha

# DDI padrao usado para normalizar telefones sem codigo de pais (Brasil = 55)
DEFAULT_COUNTRY_CODE=55
