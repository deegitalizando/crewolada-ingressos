<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Pagamento - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
  <script src="https://sdk.mercadopago.com/js/v2"></script>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1 class="sr-only"><%= eventInfo.name %></h1>
    </header>

    <main class="card">
      <h2>Seus dados</h2>
      <p class="total-row">
        <%= quantity %> ingresso<%= quantity === 1 ? '' : 's' %> (<%= loteName %>) &middot;
        <strong>Total: R$ <%= total.toFixed(2).replace('.', ',') %></strong>
      </p>

      <div id="payment-error" class="alert" style="display: none"></div>

      <form class="form" id="dados-form">
        <label>
          Nome completo
          <input type="text" id="buyerName" required autocomplete="name" />
        </label>
        <label>
          E-mail
          <input type="email" id="buyerEmail" required autocomplete="email" />
        </label>
        <label>
          WhatsApp (com DDD)
          <input type="tel" id="buyerPhone" required placeholder="21 99999-9999" autocomplete="tel" />
        </label>
        <label>
          CPF
          <input type="text" id="buyerCpf" required placeholder="000.000.000-00" inputmode="numeric" maxlength="14" />
        </label>
        <button type="submit" id="continuar-btn">Continuar para o pagamento</button>
      </form>

      <div id="paymentBrick_container" style="margin-top: 20px"></div>

      <p class="hint">
        Ao concluir o pagamento, voce concorda com nossos
        <a href="/termos-de-uso" target="_blank">Termos de Uso</a> e nossa
        <a href="/politica-de-privacidade" target="_blank">Politica de Privacidade</a>.
      </p>
    </main>
  </div>

  <%- include('partials/lgpd_banner') %>

  <script>
    const errorBox = document.getElementById('payment-error');
    function showError(message) {
      errorBox.textContent = message;
      errorBox.style.display = 'block';
      errorBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    const cpfInput = document.getElementById('buyerCpf');
    cpfInput.addEventListener('input', () => {
      let v = cpfInput.value.replace(/\D/g, '').slice(0, 11);
      v = v.replace(/(\d{3})(\d)/, '$1.$2');
      v = v.replace(/(\d{3})(\d)/, '$1.$2');
      v = v.replace(/(\d{3})(\d{1,2})$/, '$1-$2');
      cpfInput.value = v;
    });

    const dadosForm = document.getElementById('dados-form');
    const continuarBtn = document.getElementById('continuar-btn');
    let brickCreated = false;

    dadosForm.addEventListener('submit', (e) => {
      e.preventDefault();
      if (brickCreated) return;

      const buyerName = document.getElementById('buyerName').value.trim();
      const buyerEmail = document.getElementById('buyerEmail').value.trim();
      const buyerPhone = document.getElementById('buyerPhone').value.trim();
      const buyerCpf = document.getElementById('buyerCpf').value.trim();
      const cpfDigits = buyerCpf.replace(/\D/g, '');

      if (!buyerName || !buyerEmail || !buyerPhone || cpfDigits.length !== 11) {
        showError('Preencha nome, e-mail, WhatsApp e um CPF valido (11 digitos).');
        return;
      }
      errorBox.style.display = 'none';

      [...dadosForm.elements].forEach((el) => (el.disabled = true));
      brickCreated = true;
      createBrick({ email: buyerEmail, cpfDigits });
    });

    function createBrick({ email, cpfDigits }) {
      const mp = new MercadoPago('<%= mpPublicKey %>', { locale: 'pt-BR' });
      const bricksBuilder = mp.bricks();

      bricksBuilder.create('payment', 'paymentBrick_container', {
        initialization: {
          amount: <%= total %>,
          payer: {
            email,
            identification: { type: 'CPF', number: cpfDigits },
          },
        },
        customization: {
          paymentMethods: {
            creditCard: 'all',
            bankTransfer: 'all',
          },
          visual: {
            style: {
              theme: 'dark',
            },
          },
        },
        callbacks: {
          onReady: () => {},
          onError: (error) => {
            console.error(error);
          },
          onSubmit: ({ formData }) => {
            return new Promise((resolve, reject) => {
              const buyerName = document.getElementById('buyerName').value.trim();
              const buyerPhone = document.getElementById('buyerPhone').value.trim();

              errorBox.style.display = 'none';

              fetch('/api/pagamentos', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                  quantity: <%= quantity %>,
                  buyerName,
                  buyerEmail: email,
                  buyerPhone,
                  buyerCpf: cpfDigits,
                  formData,
                }),
              })
                .then((res) => res.json().then((data) => ({ ok: res.ok, data })))
                .then(({ ok, data }) => {
                  if (!ok) {
                    showError(data.error || 'Nao foi possivel processar o pagamento.');
                    reject();
                    return;
                  }
                  resolve();
                  window.location.href = data.redirectUrl;
                })
                .catch(() => {
                  showError('Erro de conexao. Tente novamente.');
                  reject();
                });
            });
          },
        },
      });
    }
  </script>
</body>
</html>
