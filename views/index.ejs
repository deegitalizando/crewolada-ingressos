<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title><%= eventInfo.name %> - <%= eventInfo.dateLabel %> - Ingressos</title>
  <meta name="description" content="<%= eventInfo.name %>: <%= eventInfo.dateLabel %>, <%= eventInfo.timeLabel %>, <%= eventInfo.venue %>. Churrasco, música, família e comunidade. Garanta seu ingresso!" />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= eventInfo.name %> · <%= eventInfo.dateLabel %> · <%= eventInfo.venue %>" />
  <meta property="og:description" content="Churrasco, música, família e comunidade. Limite de apenas <%= totalCapacity || 300 %> ingressos. Garanta o seu!" />
  <meta property="og:image" content="<%= baseUrl %>/img/flyer-tardezinha.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#0b4a8f" />
  <%- include('partials/head') %>
  <link rel="preload" as="image" href="/img/flyer-tardezinha.webp" />
  <style>
    :root { --y: #ffd21e; --o: #ff8a00; --k: #0b0b0b; --sky1: #1b9be8; --sky2: #0b4a8f; }
    body.tz {
      background: linear-gradient(180deg, var(--sky1) 0, var(--sky2) 38%, #06182f 72%, #000 100%) fixed;
      overflow-x: hidden;
    }
    .tz .page { gap: 22px; padding-bottom: 96px; max-width: 560px; position: relative; z-index: 1; }

    /* ---------- floating background ---------- */
    .bg-fx { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .bg-fx i {
      position: absolute; bottom: -40px; width: 14px; height: 14px; border-radius: 50%;
      background: radial-gradient(circle at 30% 30%, #fff8, var(--y)); opacity: 0.55;
      animation: rise linear infinite;
    }
    @keyframes rise { to { transform: translateY(-115vh) translateX(var(--dx, 20px)); opacity: 0; } }

    /* ---------- hero flyer ---------- */
    .hero-tz { padding: 14px 14px 0; perspective: 900px; }
    .flyer-wrap {
      position: relative; border-radius: 26px; overflow: hidden; transform-style: preserve-3d;
      box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5), 0 0 0 4px var(--y);
      transition: transform 0.15s ease-out;
      animation: pop-in 0.9s cubic-bezier(0.2, 1.4, 0.4, 1) both;
    }
    @keyframes pop-in { from { opacity: 0; transform: scale(0.85) rotate(-3deg); } to { opacity: 1; transform: none; } }
    .flyer-wrap img { display: block; width: 100%; height: auto; transform-origin: 60% 40%; animation: kenburns 18s ease-in-out infinite alternate; }
    @keyframes kenburns { from { transform: scale(1); } to { transform: scale(1.07); } }
    .rays {
      position: absolute; width: 260%; aspect-ratio: 1; left: 92%; top: 8%; margin: -130% 0 0 -130%;
      background: repeating-conic-gradient(from 0deg, rgba(255, 245, 160, 0.55) 0 5deg, transparent 5deg 17deg);
      -webkit-mask-image: radial-gradient(circle, #000 0, transparent 55%); mask-image: radial-gradient(circle, #000 0, transparent 55%);
      mix-blend-mode: screen; animation: spin 40s linear infinite; pointer-events: none;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .glare {
      position: absolute; inset: 0; pointer-events: none; opacity: 0; transition: opacity 0.2s;
      background: radial-gradient(circle at var(--gx, 50%) var(--gy, 30%), rgba(255, 255, 255, 0.35), transparent 45%);
    }
    .flyer-wrap.tilting .glare { opacity: 1; }
    .spark { position: absolute; color: #fff; font-size: 22px; text-shadow: 0 0 10px var(--y), 0 0 18px var(--y); animation: twinkle 2.4s ease-in-out infinite; pointer-events: none; }
    @keyframes twinkle { 0%, 100% { transform: scale(0.3) rotate(0); opacity: 0; } 50% { transform: scale(1.2) rotate(40deg); opacity: 1; } }

    /* ---------- CTAs ---------- */
    .cta {
      position: relative; display: block; width: 100%; text-align: center; text-decoration: none; cursor: pointer; border: 0;
      background: linear-gradient(180deg, var(--y), var(--o)); color: var(--k);
      font-weight: 900; font-size: 19px; letter-spacing: 0.02em; text-transform: uppercase;
      padding: 18px 16px; border-radius: 16px; overflow: hidden;
      box-shadow: 0 6px 0 #7a4300, 0 14px 30px rgba(0, 0, 0, 0.35);
      transform: translateY(0); transition: transform 0.12s, box-shadow 0.12s;
      animation: pulse 2.2s ease-in-out infinite;
    }
    .cta:active { transform: translateY(4px); box-shadow: 0 2px 0 #7a4300, 0 8px 18px rgba(0, 0, 0, 0.35); }
    .cta::after {
      content: ''; position: absolute; top: 0; bottom: 0; width: 60px; left: -90px; transform: skewX(-20deg);
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
      animation: sweep 3.2s ease-in-out infinite;
    }
    @keyframes sweep { 0%, 55% { left: -90px; } 100% { left: 120%; } }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.03); } }
    .cta:disabled { opacity: 0.45; animation: none; cursor: not-allowed; }
    .hero-cta { margin: 16px 14px 0; width: auto; }

    /* ---------- ribbon ---------- */
    .ribbon {
      background: var(--y); color: var(--k); overflow: hidden; white-space: nowrap; transform: rotate(-2deg) scale(1.04);
      border-top: 4px solid var(--k); border-bottom: 4px solid var(--k); box-shadow: 0 8px 20px rgba(0, 0, 0, 0.35);
    }
    .ribbon .track { display: inline-block; padding: 10px 0; font-weight: 900; font-style: italic; letter-spacing: 0.04em; text-transform: uppercase; animation: marquee 22s linear infinite; }
    .ribbon .track span { margin: 0 18px; }
    @keyframes marquee { to { transform: translateX(-50%); } }

    /* ---------- blocks ---------- */
    .brush {
      margin: 0 14px; background: #0b0b0b; color: #fff; border-radius: 18px; padding: 20px 16px;
      border: 2px solid var(--y); box-shadow: 6px 6px 0 rgba(255, 210, 30, 0.35);
    }
    .brush h2 { margin: 0 0 10px; color: var(--y); font-size: 22px; text-transform: uppercase; font-style: italic; transform: skewX(-6deg); }

    .countdown { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; text-align: center; }
    .countdown .box { background: linear-gradient(180deg, #222, #000); border: 2px solid var(--y); border-radius: 12px; padding: 10px 4px; }
    .countdown .num { display: block; font-size: 30px; font-weight: 900; color: var(--y); line-height: 1; font-variant-numeric: tabular-nums; }
    .countdown .num.tick { animation: tick 0.35s ease-out; }
    @keyframes tick { 0% { transform: translateY(-8px) scale(1.2); opacity: 0.4; } 100% { transform: none; opacity: 1; } }
    .countdown .lab { font-size: 11px; text-transform: uppercase; letter-spacing: 0.06em; color: #cfd8e3; }

    .tiles { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin: 0 14px; }
    .tile {
      background: var(--y); color: var(--k); border: 3px solid var(--k); border-radius: 14px; padding: 14px 12px;
      font-weight: 900; text-transform: uppercase; line-height: 1.15; box-shadow: 5px 5px 0 var(--k);
      transform: rotate(var(--r, 0deg)); transition: transform 0.2s;
    }
    .tile:hover { transform: rotate(0deg) scale(1.04); }
    .tile:nth-child(odd) { --r: -2deg; }
    .tile:nth-child(even) { --r: 2deg; background: #fff; }
    .tile .em { display: block; font-size: 30px; margin-bottom: 4px; animation: bob 2.6s ease-in-out infinite; }
    .tile:nth-child(even) .em { animation-delay: 0.6s; }
    @keyframes bob { 0%, 100% { transform: translateY(0) rotate(0); } 50% { transform: translateY(-5px) rotate(6deg); } }
    .tile small { display: block; font-weight: 700; text-transform: none; font-size: 12px; margin-top: 4px; opacity: 0.8; }
    .tile.wide { grid-column: 1 / -1; text-align: center; background: var(--k); color: var(--y); border-color: var(--y); box-shadow: 5px 5px 0 var(--y); --r: -1deg; }

    .reveal { opacity: 0; transform: translateY(26px) scale(0.96) rotate(var(--r, 0deg)); transition: opacity 0.6s, transform 0.6s cubic-bezier(0.2, 1.3, 0.4, 1); }
    .reveal.in { opacity: 1; transform: rotate(var(--r, 0deg)); }

    /* ---------- tickets ---------- */
    .buy .price { font-size: 58px; font-weight: 900; line-height: 1; margin: 0 0 6px; color: var(--y); font-style: italic; }
    .buy .price span { display: block; font-size: 14px; margin-top: 4px; color: #cfd8e3; font-style: normal; font-weight: 600; }
    .buy .badge-300 { display: inline-block; background: var(--y); color: var(--k); font-weight: 900; text-transform: uppercase; font-size: 12px; padding: 4px 10px; border-radius: 999px; transform: rotate(-3deg); margin-bottom: 8px; }
    .sale-bar { height: 12px; border-radius: 6px; background: #1c1c1c; overflow: hidden; margin: 10px 0 4px; border: 1px solid #333; }
    .sale-bar b { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--y), var(--o)); border-radius: 6px; transition: width 1.4s cubic-bezier(0.2, 0.9, 0.2, 1); }
    .sale-note { font-size: 12px; color: #cfd8e3; margin: 0 0 14px; }
    .buy .qty-row { margin: 8px 0 14px; }
    .buy .qty-btn { border-color: var(--y); color: var(--y); background: #111; }
    .buy .total-row { color: #cfd8e3; }
    .buy .total-row strong { color: #fff; }
    .soldout { background: #ef4444; color: #fff; font-weight: 900; text-align: center; padding: 14px; border-radius: 12px; text-transform: uppercase; }

    .community-tz { text-align: center; }
    .community-tz .cta { background: linear-gradient(180deg, #34d399, #16a34a); color: #04210f; box-shadow: 0 6px 0 #0b5a2b, 0 14px 30px rgba(0, 0, 0, 0.35); }

    .sticky-cta {
      position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 10px 14px calc(10px + env(safe-area-inset-bottom));
      background: rgba(0, 0, 0, 0.85); backdrop-filter: blur(6px); transform: translateY(110%); transition: transform 0.35s;
    }
    .sticky-cta.show { transform: none; }
    .sticky-cta .cta { padding: 14px; font-size: 16px; }

    .confetti { position: fixed; z-index: 80; width: 9px; height: 14px; pointer-events: none; animation: confetti 0.9s ease-out forwards; }
    @keyframes confetti { to { transform: translate(var(--cx), var(--cy)) rotate(var(--cr)); opacity: 0; } }

    .tz .footer a, .tz .footer-links a { color: #dbe7f5; }
    .tz .legal-footer { color: #cfd8e3; border-top-color: rgba(255, 255, 255, 0.25); }
    .tz .btn-ja-comprei button { box-shadow: 0 5px 0 #0b5a2b; }

    @media (prefers-reduced-motion: reduce) {
      *, *::before, *::after { animation: none !important; transition: none !important; }
      .reveal { opacity: 1; transform: none; }
      .rays, .bg-fx { display: none; }
    }
  </style>
</head>
<body class="tz">
  <div class="bg-fx" aria-hidden="true" id="bg-fx"></div>

  <div class="page">
    <header class="hero-tz">
      <div class="flyer-wrap" id="flyer-wrap">
        <img src="/img/flyer-tardezinha.webp" width="1254" height="1254" fetchpriority="high"
             alt="<%= eventInfo.name %> — <%= eventInfo.dateLabel %>, <%= eventInfo.timeLabel %>, <%= eventInfo.venue %>. Churrasco, música, família e comunidade." />
        <div class="rays" aria-hidden="true"></div>
        <div class="glare" aria-hidden="true"></div>
        <span class="spark" style="left:12%;top:60%;animation-delay:0.2s" aria-hidden="true">✦</span>
        <span class="spark" style="left:78%;top:44%;animation-delay:1.1s" aria-hidden="true">✦</span>
        <span class="spark" style="left:46%;top:8%;animation-delay:1.7s" aria-hidden="true">✦</span>
        <span class="spark" style="left:88%;top:70%;animation-delay:0.7s" aria-hidden="true">✦</span>
        <span class="spark" style="left:6%;top:22%;animation-delay:2s" aria-hidden="true">✦</span>
      </div>
    </header>

    <% if (lote && !comingSoon) { %>
      <a class="cta hero-cta" href="#ingressos" data-confetti>🎟️ Garantir meu ingresso &middot; R$ <%= lote.price.toFixed(2).replace('.', ',') %></a>
    <% } else if (comingSoon) { %>
      <a class="cta hero-cta" href="#ingressos">🔔 Ingressos em breve</a>
    <% } else { %>
      <a class="cta hero-cta" href="#comunidade">💬 Ingressos esgotados — entre na comunidade</a>
    <% } %>

    <div class="ribbon" aria-hidden="true">
      <div class="track">
        <% for (var r = 0; r < 2; r++) { %>
          <span>🍖 Churrasco</span><span>🎶 Música</span><span>👨‍👩‍👧 Família</span><span>🤝 Comunidade</span><span>🎈 Brinquedos para crianças</span><span>☀️ <%= eventInfo.dateLabel.slice(0, 5) %></span><span>📍 <%= eventInfo.venue.split(' - ')[0] %></span>
        <% } %>
      </div>
    </div>

    <section class="brush reveal" id="contagem">
      <h2>Falta pouco!</h2>
      <div class="countdown" id="countdown" data-start="<%= eventInfo.startAt || '' %>">
        <div class="box"><span class="num" data-u="d">--</span><span class="lab">dias</span></div>
        <div class="box"><span class="num" data-u="h">--</span><span class="lab">horas</span></div>
        <div class="box"><span class="num" data-u="m">--</span><span class="lab">min</span></div>
        <div class="box"><span class="num" data-u="s">--</span><span class="lab">seg</span></div>
      </div>
    </section>

    <section class="tiles">
      <div class="tile reveal"><span class="em">📅</span><%= eventInfo.dateLabel.slice(0, 5) %><small><%= eventInfo.timeLabel %></small></div>
      <div class="tile reveal"><span class="em">📍</span><%= eventInfo.venue.split(' - ')[0] %><small><%= eventInfo.venue.split(' - ')[1] || '' %></small></div>
      <div class="tile reveal"><span class="em">🍖</span>Churrasco<small>e muita comunhão</small></div>
      <div class="tile reveal"><span class="em">🎶</span>Black Music Cristã<small>diversão do jeito Crewolada</small></div>
      <div class="tile reveal"><span class="em">🎈</span>Brinquedos para crianças<small>diversão para a família toda</small></div>
      <div class="tile reveal"><span class="em">🎟️</span>Limite de <%= totalCapacity || 300 %> ingressos<small>garanta o seu</small></div>
      <div class="tile wide reveal">Nos vemos lá! 🌴☀️</div>
    </section>

    <section class="brush buy reveal" id="ingressos">
      <% if (soldOutLotes && soldOutLotes.length > 0 && lote) { %>
        <% soldOutLotes.forEach(function(nome) { %><p class="soldout" style="margin:0 0 10px"><%= nome %> esgotado</p><% }) %>
      <% } %>

      <% if (comingSoon) { %>
        <h2>Ingressos em breve</h2>
        <p style="margin:0; color:#cfd8e3; line-height:1.55">A venda ainda não abriu. Entre na comunidade abaixo e seja avisado em primeira mão, antes de todo mundo.</p>
      <% } else if (lote) { %>
        <span class="badge-300">Só <%= totalCapacity || 300 %> ingressos</span>
        <h2 style="margin-bottom:4px"><%= lote.name %></h2>
        <p class="price">R$ <%= lote.price.toFixed(2).replace('.', ',') %> <span>por pessoa</span></p>

        <% if (soldCount > 0 && totalCapacity > 0) { %>
          <div class="sale-bar" aria-hidden="true"><b data-pct="<%= Math.min(100, Math.round((soldCount / totalCapacity) * 100)) %>"></b></div>
          <p class="sale-note"><%= Math.min(100, Math.round((soldCount / totalCapacity) * 100)) %>% dos ingressos já foram garantidos<% if (lote.remaining <= lowStockThreshold) { %> · restam só <%= lote.remaining %><% } %></p>
        <% } %>

        <% if (error) { %><div class="alert"><%= error %></div><% } %>

        <form action="/checkout/dados" method="GET" id="qty-form">
          <input type="hidden" name="qty" id="qty-input" value="1" />
          <div class="qty-row">
            <button type="button" class="qty-btn" id="qty-minus" aria-label="Menos um ingresso">-</button>
            <span class="qty-value" id="qty-value">1</span>
            <button type="button" class="qty-btn" id="qty-plus" aria-label="Mais um ingresso">+</button>
          </div>
          <p class="total-row">Total: <strong id="qty-total">R$ <%= lote.price.toFixed(2).replace('.', ',') %></strong></p>
          <button type="submit" class="cta" data-confetti>🎟️ Garantir meu ingresso</button>
        </form>
      <% } else { %>
        <h2>Ingressos esgotados</h2>
        <p style="margin:0; color:#cfd8e3; line-height:1.55">Os <%= totalCapacity || 300 %> ingressos acabaram! Entre na comunidade para saber dos próximos eventos em primeira mão.</p>
      <% } %>
    </section>

    <section class="brush community-tz reveal" id="comunidade">
      <h2>Fique por dentro</h2>
      <p style="margin:0 0 16px; color:#cfd8e3; line-height:1.55">Entre na nossa comunidade no WhatsApp e receba as novidades em primeira mão.</p>
      <a class="cta" href="<%= communityUrl %>" target="_blank" rel="noopener">💬 Entrar na comunidade</a>
    </section>

    <a href="/meus-ingressos" class="btn-ja-comprei">
      <button type="button">🎟️ Já comprei, ver meus ingressos</button>
    </a>

    <footer class="footer">
      <div class="footer-links">
        <a href="/pesquisa">Responder a pesquisa</a>
        <a href="/politica-de-privacidade">Politica de Privacidade</a>
        <a href="/termos-de-uso">Termos de Uso</a>
        <a href="/politica-de-cancelamento">Politica de Cancelamento</a>
      </div>
    </footer>

    <%- include('partials/footer_legal') %>
  </div>

  <% if (lote && !comingSoon) { %>
  <div class="sticky-cta" id="sticky-cta">
    <a class="cta" href="#ingressos">🎟️ Garantir meu ingresso · R$ <%= lote.price.toFixed(2).replace('.', ',') %></a>
  </div>
  <% } %>

  <%- include('partials/lgpd_banner') %>

  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ----- floating dots in the background
      var fx = document.getElementById('bg-fx');
      if (!reduce && fx) {
        for (var i = 0; i < 16; i++) {
          var d = document.createElement('i');
          d.style.left = Math.round(Math.random() * 100) + '%';
          d.style.width = d.style.height = (6 + Math.random() * 12) + 'px';
          d.style.animationDuration = (9 + Math.random() * 10) + 's';
          d.style.animationDelay = (-Math.random() * 14) + 's';
          d.style.setProperty('--dx', (Math.random() * 80 - 40) + 'px');
          fx.appendChild(d);
        }
      }

      // ----- scroll reveal (staggered inside a group)
      var items = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window && !reduce) {
        var io = new IntersectionObserver(function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              var delay = (Array.prototype.indexOf.call(e.target.parentNode.children, e.target) % 4) * 90;
              setTimeout(function () { e.target.classList.add('in'); }, delay);
              io.unobserve(e.target);
            }
          });
        }, { threshold: 0.15 });
        items.forEach(function (el) { io.observe(el); });
      } else {
        items.forEach(function (el) { el.classList.add('in'); });
      }

      // ----- 3D tilt + glare on the flyer (pointer devices only)
      var wrap = document.getElementById('flyer-wrap');
      if (wrap && !reduce && window.matchMedia('(hover: hover)').matches) {
        wrap.addEventListener('pointermove', function (e) {
          var r = wrap.getBoundingClientRect();
          var px = (e.clientX - r.left) / r.width;
          var py = (e.clientY - r.top) / r.height;
          wrap.style.transform = 'rotateY(' + ((px - 0.5) * 10) + 'deg) rotateX(' + ((0.5 - py) * 10) + 'deg)';
          wrap.style.setProperty('--gx', (px * 100) + '%');
          wrap.style.setProperty('--gy', (py * 100) + '%');
          wrap.classList.add('tilting');
        });
        wrap.addEventListener('pointerleave', function () { wrap.style.transform = ''; wrap.classList.remove('tilting'); });
      }

      // ----- countdown
      var cd = document.getElementById('countdown');
      var start = cd && cd.getAttribute('data-start') ? Date.parse(cd.getAttribute('data-start')) : NaN;
      function pad(n) { return String(n).padStart(2, '0'); }
      function setNum(el, v) {
        if (el.textContent !== v) {
          el.textContent = v;
          if (!reduce) { el.classList.remove('tick'); void el.offsetWidth; el.classList.add('tick'); }
        }
      }
      function tickCountdown() {
        var left = Math.max(0, start - Date.now());
        var s = Math.floor(left / 1000);
        var map = { d: Math.floor(s / 86400), h: Math.floor((s % 86400) / 3600), m: Math.floor((s % 3600) / 60), s: s % 60 };
        Object.keys(map).forEach(function (k) {
          var el = cd.querySelector('[data-u="' + k + '"]');
          if (el) setNum(el, k === 'd' ? String(map[k]) : pad(map[k]));
        });
      }
      if (cd && !Number.isNaN(start)) {
        if (start <= Date.now()) {
          cd.parentNode.querySelector('h2').textContent = 'É hoje, bora!';
        }
        tickCountdown();
        setInterval(tickCountdown, 1000);
      } else if (cd) {
        cd.parentNode.style.display = 'none';
      }

      // ----- confetti bursts
      function burst(x, y) {
        if (reduce) return;
        var colors = ['#ffd21e', '#ff8a00', '#ffffff', '#1b9be8', '#34d399'];
        for (var i = 0; i < 18; i++) {
          var c = document.createElement('span');
          c.className = 'confetti';
          c.style.left = x + 'px';
          c.style.top = y + 'px';
          c.style.background = colors[i % colors.length];
          c.style.setProperty('--cx', (Math.random() * 220 - 110) + 'px');
          c.style.setProperty('--cy', (Math.random() * -170 - 20) + 'px');
          c.style.setProperty('--cr', (Math.random() * 720 - 360) + 'deg');
          document.body.appendChild(c);
          setTimeout(function (el) { el.remove(); }, 1000, c);
        }
      }
      document.querySelectorAll('[data-confetti]').forEach(function (el) {
        el.addEventListener('click', function (e) { burst(e.clientX, e.clientY); });
      });

      // ----- sales progress bar fills when visible
      var bar = document.querySelector('.sale-bar b');
      if (bar) {
        var fill = function () { bar.style.width = bar.getAttribute('data-pct') + '%'; };
        if ('IntersectionObserver' in window) {
          var bo = new IntersectionObserver(function (en) { if (en[0].isIntersecting) { fill(); bo.disconnect(); } }, { threshold: 0.4 });
          bo.observe(bar);
        } else { fill(); }
      }

      // ----- sticky buy bar: after the hero, hidden while the buy section is on screen
      var sticky = document.getElementById('sticky-cta');
      var buy = document.getElementById('ingressos');
      if (sticky && buy && 'IntersectionObserver' in window) {
        var heroOut = false; var buyIn = false;
        var update = function () { sticky.classList.toggle('show', heroOut && !buyIn); };
        new IntersectionObserver(function (en) { heroOut = !en[0].isIntersecting; update(); }, { threshold: 0.05 }).observe(document.querySelector('.hero-cta'));
        new IntersectionObserver(function (en) { buyIn = en[0].isIntersecting; update(); }, { threshold: 0.2 }).observe(buy);
      }
    })();
  </script>

  <% if (lote && !comingSoon) { %>
  <script>
    (function () {
      var maxQty = Math.min(<%= lote.remaining %>, <%= maxQty %>);
      var unitPrice = <%= lote.price %>;
      var qtyInput = document.getElementById('qty-input');
      var qtyValue = document.getElementById('qty-value');
      var qtyTotal = document.getElementById('qty-total');
      var minusBtn = document.getElementById('qty-minus');
      var plusBtn = document.getElementById('qty-plus');
      var qty = 1;

      function render() {
        qtyValue.textContent = qty;
        qtyInput.value = qty;
        qtyTotal.textContent = 'R$ ' + (qty * unitPrice).toFixed(2).replace('.', ',');
        minusBtn.disabled = qty <= 1;
        plusBtn.disabled = qty >= maxQty;
      }

      minusBtn.addEventListener('click', function () { if (qty > 1) { qty -= 1; render(); } });
      plusBtn.addEventListener('click', function (e) {
        if (qty < maxQty) { qty += 1; render(); }
      });
      render();
    })();
  </script>
  <% } %>
</body>
</html>
