<% const priceLabel = lote ? (Number.isInteger(lote.price) ? String(lote.price) : lote.price.toFixed(2).replace('.', ',')) : ''; %>
<% const left = Math.max(0, (totalCapacity || 0) - soldCount); %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title><%= eventInfo.name %> · <%= eventInfo.dateLabel %> · Ingressos</title>
  <meta name="description" content="<%= eventInfo.name %>: <%= eventInfo.dateLabel %>, <%= eventInfo.timeLabel %>, <%= eventInfo.venue %>. Churrasco, música, família e comunidade. Lote único e limitado." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= eventInfo.name %> · <%= eventInfo.dateLabel %> · <%= eventInfo.venue %>" />
  <meta property="og:description" content="Lote único e limitado a <%= totalCapacity || 300 %> ingressos. Churrasco, música, família e comunidade." />
  <meta property="og:image" content="<%= baseUrl %>/img/flyer-tardezinha.jpg" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="theme-color" content="#56B9FF" />
  <%- include('partials/head') %>
  <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <style>
    :root { --accent: #FFD21E; }
    html { scroll-behavior: smooth; }
    body.v3 {
      --ink: #0E1626; --muted: #5B667A; --line: rgba(14, 22, 38, 0.1); --paper: #FFFDF4; --yellow: #FFD21E; --sky: #1E90E8;
      --ease: cubic-bezier(0.22, 1, 0.36, 1);
      margin: 0; background: var(--paper); color: var(--ink); font-family: 'DM Sans', system-ui, sans-serif;
      font-size: 17px; line-height: 1.6; overflow-x: hidden; -webkit-font-smoothing: antialiased;
    }
    .v3 *, .v3 *::before, .v3 *::after { box-sizing: border-box; }
    .v3 h1, .v3 h2, .v3 h3 { font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif; margin: 0; letter-spacing: -0.03em; line-height: 1.02; }
    .v3 p { margin: 0; }
    .v3 a { color: inherit; }
    .v3 main button { all: unset; box-sizing: border-box; cursor: pointer; }
    .wrap { width: min(1040px, 100% - 40px); margin-inline: auto; }

    /* ---------- buttons ---------- */
    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px; text-decoration: none; cursor: pointer;
      background: var(--yellow); color: var(--ink); font-weight: 700; font-size: 17px; padding: 17px 30px; border-radius: 999px;
      transition: transform 0.4s var(--ease), box-shadow 0.4s var(--ease);
      box-shadow: 0 10px 30px -12px rgba(14, 22, 38, 0.4);
    }
    .btn:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 18px 40px -14px rgba(14, 22, 38, 0.5); }
    .btn svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 2.2; stroke-linecap: round; stroke-linejoin: round; transition: transform 0.4s var(--ease); }
    .btn:hover svg { transform: translateX(4px); }
    .btn.pulse { animation: halo 2.6s ease-out infinite; }
    @keyframes halo { 0% { box-shadow: 0 10px 30px -12px rgba(14,22,38,.4), 0 0 0 0 rgba(255, 210, 30, 0.7); } 70%, 100% { box-shadow: 0 10px 30px -12px rgba(14,22,38,.4), 0 0 0 18px rgba(255, 210, 30, 0); } }
    .btn-line { background: transparent; box-shadow: none; border: 1.5px solid var(--ink); }
    .btn-line:hover { background: var(--ink); color: #fff; box-shadow: none; }
    .btn-block { display: flex; width: 100%; }
    .btn[disabled] { opacity: 0.4; cursor: not-allowed; animation: none; }

    /* ---------- hero: living sky ---------- */
    .hero {
      position: relative; min-height: 100svh; overflow: hidden; display: flex; flex-direction: column;
      background: linear-gradient(180deg, #4FB4FF 0%, #8CD0FF 34%, #CFEBFF 62%, #FFF6CF 100%);
    }
    .sunglow { position: absolute; right: -8%; top: -10%; width: 62vmin; height: 62vmin; border-radius: 50%; pointer-events: none;
      background: radial-gradient(circle, rgba(255, 244, 170, 0.95) 0, rgba(255, 244, 170, 0.35) 38%, transparent 70%); animation: glow 7s ease-in-out infinite alternate; }
    @keyframes glow { from { transform: scale(1); opacity: 0.85; } to { transform: scale(1.12); opacity: 1; } }
    .cloud { position: absolute; left: -30%; width: var(--w, 180px); opacity: var(--o, 0.9); filter: blur(var(--b, 0px)); animation: drift var(--d, 90s) linear var(--delay, 0s) infinite; pointer-events: none; }
    @keyframes drift { to { transform: translateX(160vw); } }
    .layer { position: absolute; inset: 0; pointer-events: none; transition: transform 0.4s var(--ease); }
    .fl { position: absolute; left: var(--x); bottom: -14vh; width: var(--s); opacity: var(--o, 1); animation: rise var(--d) linear var(--delay) infinite; will-change: transform; }
    .fl svg { display: block; width: 100%; height: auto; overflow: visible; animation: sway var(--sw, 4s) ease-in-out infinite alternate; filter: blur(var(--b, 0px)); }
    @keyframes rise { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(var(--dx, 0px), -128vh, 0); } }
    @keyframes sway { from { transform: rotate(-9deg) translateX(-14px); } to { transform: rotate(9deg) translateX(14px); } }

    .topbar { position: relative; z-index: 5; }
    .topbar .wrap { display: flex; align-items: center; justify-content: space-between; height: 72px; }
    .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; }
    .brand img { width: 38px; height: 38px; border-radius: 50%; object-fit: cover; box-shadow: 0 4px 14px -4px rgba(14, 22, 38, 0.5); }
    .link-pill { text-decoration: none; font-weight: 700; font-size: 14px; padding: 10px 18px; border-radius: 999px; background: rgba(255, 255, 255, 0.7); backdrop-filter: blur(8px); transition: background-color 0.3s, transform 0.4s var(--ease); }
    .link-pill:hover { background: #fff; transform: translateY(-2px); }

    .hero-inner { position: relative; z-index: 4; flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 8px 20px 56px; }
    .eyebrow { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; color: rgba(14, 22, 38, 0.75); margin-bottom: 20px; }
    .stage { position: relative; width: min(86vw, 500px); }
    .card-video {
      position: relative; width: 100%; aspect-ratio: 1; border-radius: 28px; overflow: hidden; background: #fff;
      box-shadow: 0 40px 80px -30px rgba(14, 22, 38, 0.55), 0 0 0 5px #fff; animation: bob 7s ease-in-out infinite;
    }
    @keyframes bob { 0%, 100% { transform: translateY(0) rotate(-0.6deg); } 50% { transform: translateY(-12px) rotate(0.6deg); } }
    .card-video video, .card-video img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; display: block; }
    .card-video::after { content: ''; position: absolute; inset: 0; pointer-events: none;
      background: linear-gradient(115deg, transparent 38%, rgba(255, 255, 255, 0.45) 50%, transparent 62%); transform: translateX(-120%); animation: shine 6.5s ease-in-out infinite; }
    @keyframes shine { 0%, 55% { transform: translateX(-120%); } 100% { transform: translateX(120%); } }

    .badge { position: absolute; z-index: 3; font-weight: 800; animation: bob2 var(--bd, 5s) ease-in-out var(--bdl, 0s) infinite; }
    @keyframes bob2 { 0%, 100% { transform: translateY(0) rotate(var(--r, 0deg)); } 50% { transform: translateY(-10px) rotate(calc(var(--r, 0deg) + 3deg)); } }
    .badge-price { left: -26px; top: 41%; --r: -10deg; width: 96px; height: 96px; border-radius: 50%; background: var(--yellow); color: var(--ink);
      display: grid; place-items: center; text-align: center; line-height: 1; box-shadow: 0 16px 30px -12px rgba(14, 22, 38, 0.5); border: 3px solid #fff; }
    .badge-price b { font-family: 'Bricolage Grotesque', sans-serif; font-size: 28px; letter-spacing: -0.04em; display: block; }
    .badge-price small { font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase; }
    .badge-limit { right: 4%; bottom: -28px; --r: 4deg; --bd: 6s; --bdl: -2s; background: var(--ink); color: #fff; font-size: 12px; letter-spacing: 0.1em; text-transform: uppercase;
      padding: 10px 16px; border-radius: 999px; display: inline-flex; align-items: center; gap: 8px; box-shadow: 0 16px 30px -12px rgba(14, 22, 38, 0.6); }
    .badge-cap { right: -10px; top: 6%; --r: 8deg; --bd: 4.4s; --bdl: -1s; background: #fff; color: var(--ink); font-size: 12px; letter-spacing: 0.08em; text-transform: uppercase;
      padding: 9px 14px; border-radius: 999px; box-shadow: 0 12px 24px -12px rgba(14, 22, 38, 0.5); }
    .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--yellow); animation: blink 1.4s ease-in-out infinite; flex: none; }
    @keyframes blink { 50% { opacity: 0.25; } }

    .hero-cta { margin-top: 40px; }
    .hero-note { margin-top: 16px; font-size: 14px; color: rgba(14, 22, 38, 0.7); }
    .hero-note strong { color: var(--ink); }
    .scroll-hint { position: absolute; z-index: 4; left: 50%; bottom: 18px; width: 22px; height: 36px; margin-left: -11px; border: 1.5px solid rgba(14, 22, 38, 0.45); border-radius: 12px; }
    .scroll-hint::after { content: ''; position: absolute; left: 50%; top: 7px; width: 3px; height: 7px; margin-left: -1.5px; border-radius: 2px; background: rgba(14, 22, 38, 0.6); animation: wheel 1.8s ease-in-out infinite; }
    @keyframes wheel { 0% { opacity: 0; transform: translateY(0); } 40% { opacity: 1; } 100% { opacity: 0; transform: translateY(12px); } }

    /* ---------- buy ---------- */
    .buy { padding-block: 80px 40px; }
    @media (min-width: 768px) { .buy { padding-block: 120px 60px; } }
    .buy-card { width: min(520px, 100%); margin-inline: auto; text-align: center; }
    .kicker { font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; font-weight: 700; color: var(--muted); }
    .price { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: clamp(4.5rem, 16vw, 7rem); letter-spacing: -0.06em; line-height: 0.95; margin: 12px 0 4px; }
    .price span { font-size: 0.38em; letter-spacing: 0; vertical-align: 0.9em; margin-right: 6px; font-weight: 700; }
    .per { color: var(--muted); }
    .meter { margin: 28px auto 0; max-width: 360px; }
    .meter .row { display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); margin-bottom: 8px; }
    .meter .row strong { color: var(--ink); }
    .bar { height: 5px; border-radius: 3px; background: rgba(14, 22, 38, 0.1); overflow: hidden; }
    .bar b { display: block; height: 100%; width: 0; background: var(--ink); border-radius: 3px; transition: width 1.4s var(--ease); }
    .qty { display: flex; align-items: center; justify-content: center; gap: 28px; margin: 36px 0 8px; }
    .qty-btn { width: 52px; height: 52px; border-radius: 50%; border: 1.5px solid var(--line); display: grid; place-items: center; font-size: 22px; transition: border-color 0.3s, transform 0.4s var(--ease), background-color 0.3s; }
    .qty-btn:hover { border-color: var(--ink); transform: scale(1.08); }
    .qty-btn[disabled] { opacity: 0.3; cursor: not-allowed; transform: none; }
    .qty-val { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 40px; min-width: 48px; letter-spacing: -0.04em; }
    .total { color: var(--muted); margin-bottom: 24px; }
    .total strong { color: var(--ink); font-size: 20px; margin-left: 6px; }
    .trust { margin-top: 20px; font-size: 13px; color: var(--muted); }
    .alert-v3 { border: 1px solid #e11d48; color: #9f1239; border-radius: 12px; padding: 12px 16px; margin-top: 16px; }

    .more { padding-block: 40px 100px; text-align: center; }
    .more p { color: var(--muted); max-width: 30em; margin: 12px auto 24px; }

    .foot { border-top: 1px solid var(--line); padding-block: 28px; }
    .foot .links { display: flex; flex-wrap: wrap; gap: 8px 24px; font-size: 14px; color: var(--muted); }
    .foot .links a { text-decoration: none; transition: color 0.3s; }
    .foot .links a:hover { color: var(--ink); }
    .v3 .legal-footer { margin: 0; padding: 24px 0 120px; border-top: 0; color: var(--muted); }
    .v3 .legal-footer a { color: var(--ink); }
    .v3 .legal-footer h4 { color: var(--ink); }

    .sticky-cta { position: fixed; left: 0; right: 0; bottom: 0; z-index: 40; padding: 12px 20px calc(12px + env(safe-area-inset-bottom)); background: rgba(255, 253, 244, 0.94); backdrop-filter: blur(12px); border-top: 1px solid var(--line); transform: translateY(110%); transition: transform 0.5s var(--ease); }
    .sticky-cta.show { transform: none; }
    .sticky-cta .btn { width: 100%; }

    @media (max-width: 560px) {
      .badge-price { left: -12px; width: 80px; height: 80px; }
      .badge-price b { font-size: 24px; }
      .badge-limit { right: 2%; }
    }
    @media (min-width: 1024px) { .sticky-cta { display: none; } }
    @media (prefers-reduced-motion: reduce) {
      .fl, .cloud, .card-video, .badge, .sunglow, .btn.pulse, .dot, .scroll-hint::after, .card-video::after { animation: none !important; }
      .fl svg { animation: none !important; }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body class="v3">
  <section class="hero" id="hero">
    <div class="sunglow" aria-hidden="true"></div>
    <div id="clouds" aria-hidden="true"></div>
    <div class="layer" id="layer-back" aria-hidden="true"></div>

    <header class="topbar">
      <div class="wrap">
        <a class="brand" href="/"><img src="/img/logo.jpg" alt="" width="38" height="38" /> Crewolada</a>
        <a class="link-pill" href="#ingressos">Ingressos</a>
      </div>
    </header>

    <div class="hero-inner">
      <p class="eyebrow"><%= eventInfo.dateLabel.slice(0, 5) %> · <%= eventInfo.timeLabel %> · <%= eventInfo.venue %></p>

      <div class="stage" id="stage">
        <div class="card-video">
          <video autoplay muted loop playsinline preload="auto" poster="/img/flyer-tardezinha.webp" aria-label="<%= eventInfo.name %> — <%= eventInfo.dateLabel %>, <%= eventInfo.timeLabel %>, <%= eventInfo.venue %>">
            <source src="/video/tardezinha-loop.mp4" type="video/mp4" />
          </video>
        </div>
        <% if (lote && !comingSoon) { %><div class="badge badge-price"><div><b>R$ <%= priceLabel %></b><small>por pessoa</small></div></div><% } %>
        <div class="badge badge-limit"><span class="dot"></span> Lote único e limitado</div>
      </div>

      <% if (lote && !comingSoon) { %>
        <a class="btn pulse hero-cta" href="#ingressos">Garantir meu ingresso
          <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></a>
        <p class="hero-note">Restam <strong><%= left %></strong> de <%= totalCapacity %> · <span id="days-left"></span></p>
      <% } else if (comingSoon) { %>
        <a class="btn hero-cta" href="#comunidade">Avisar quando abrir</a>
      <% } else { %>
        <a class="btn hero-cta" href="#comunidade">Ingressos esgotados · entrar na comunidade</a>
      <% } %>
    </div>

    <div class="layer" id="layer-front" aria-hidden="true"></div>
    <span class="scroll-hint" aria-hidden="true"></span>
  </section>

  <main>
    <section class="buy" id="ingressos">
      <div class="wrap">
        <div class="buy-card">
          <% if (comingSoon) { %>
            <p class="kicker">Em breve</p>
            <h2 style="font-size:clamp(2rem,6vw,3rem); margin-top:12px">Ingressos em breve</h2>
            <p class="per" style="margin-top:12px">A venda ainda não abriu. Entre na comunidade e seja avisado em primeira mão.</p>
            <a class="btn btn-block" style="margin-top:28px" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
          <% } else if (lote) { %>
            <p class="kicker"><%= lote.name %> · limitado</p>
            <p class="price"><span>R$</span><%= priceLabel %></p>
            <p class="per">por pessoa</p>

            <div class="meter">
              <div class="row"><span><strong><%= left %></strong> de <%= totalCapacity %> disponíveis</span><span><%= soldCount > 0 ? Math.min(100, Math.round((soldCount / totalCapacity) * 100)) + '% garantidos' : 'Venda aberta' %></span></div>
              <div class="bar" aria-hidden="true"><b data-pct="<%= totalCapacity ? Math.min(100, Math.round((soldCount / totalCapacity) * 100)) : 0 %>"></b></div>
            </div>

            <% if (error) { %><div class="alert-v3"><%= error %></div><% } %>

            <form action="/checkout/dados" method="GET" id="qty-form">
              <input type="hidden" name="qty" id="qty-input" value="1" />
              <div class="qty">
                <button type="button" class="qty-btn" id="qty-minus" aria-label="Menos um ingresso">−</button>
                <span class="qty-val" id="qty-value">1</span>
                <button type="button" class="qty-btn" id="qty-plus" aria-label="Mais um ingresso">+</button>
              </div>
              <p class="total">Total <strong id="qty-total">R$ <%= lote.price.toFixed(2).replace('.', ',') %></strong></p>
              <button type="submit" class="btn btn-block pulse">Ir para o pagamento
                <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></button>
            </form>
            <p class="trust">Pix ou cartão · QR Code por e-mail · Desista em até <%= refundDays %> dias</p>
          <% } else { %>
            <p class="kicker">Esgotado</p>
            <h2 style="font-size:clamp(2rem,6vw,3rem); margin-top:12px">Ingressos esgotados</h2>
            <p class="per" style="margin-top:12px">Os <%= totalCapacity || 300 %> ingressos acabaram. Entre na comunidade para saber dos próximos eventos em primeira mão.</p>
            <a class="btn btn-block" style="margin-top:28px" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
          <% } %>
        </div>
      </div>
    </section>

    <section class="more" id="comunidade">
      <div class="wrap">
        <h2 style="font-size:clamp(1.5rem,4vw,2.25rem)">Fique por dentro</h2>
        <p>Entre na comunidade no WhatsApp e receba as novidades em primeira mão.</p>
        <a class="btn btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="links">
        <a href="/meus-ingressos">Meus ingressos</a>
        <a href="/pesquisa">Pesquisa</a>
        <a href="/politica-de-privacidade">Privacidade</a>
        <a href="/termos-de-uso">Termos</a>
        <a href="/politica-de-cancelamento">Cancelamento</a>
      </div>
      <%- include('partials/footer_legal') %>
    </div>
  </footer>

  <% if (lote && !comingSoon) { %>
  <div class="sticky-cta" id="sticky-cta">
    <a class="btn pulse" href="#ingressos">Garantir ingresso · R$ <%= priceLabel %></a>
  </div>
  <% } %>

  <%- include('partials/lgpd_banner') %>

  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var fine = window.matchMedia('(hover: hover)').matches;
      var SVG = {
        balloon: function (c) { return '<svg viewBox="0 0 40 64"><ellipse cx="20" cy="22" rx="16" ry="20" fill="' + c + '"/><path d="M20 42l-3.5 5.5h7z" fill="' + c + '"/><path d="M20 47.5c-6 6 5 9 0 16" stroke="#0E1626" stroke-opacity=".45" stroke-width="1.2" fill="none"/><ellipse cx="13" cy="14" rx="3.6" ry="6" fill="#fff" fill-opacity=".5"/></svg>'; },
        note: function (c) { return '<svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" fill="none" stroke="' + c + '" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" fill="' + c + '"/><circle cx="17" cy="16" r="3" fill="' + c + '"/></svg>'; },
        star: function (c) { return '<svg viewBox="0 0 24 24"><path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z" fill="' + c + '"/></svg>'; },
        cloud: function () { return '<svg viewBox="0 0 120 50"><g fill="#fff"><circle cx="30" cy="32" r="16"/><circle cx="52" cy="22" r="20"/><circle cx="80" cy="30" r="16"/><rect x="26" y="30" width="64" height="18" rx="9"/></g></svg>'; }
      };
      var COLORS = ['#FFD21E', '#FFFFFF', '#1E90E8', '#FF9F1C', '#0E1626'];
      function rnd(a, b) { return a + Math.random() * (b - a); }
      function pick(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

      // ----- drifting clouds
      var clouds = document.getElementById('clouds');
      if (clouds) {
        for (var i = 0; i < 5; i++) {
          var c = document.createElement('div');
          c.className = 'cloud';
          c.innerHTML = SVG.cloud();
          c.style.top = rnd(8, 62) + '%';
          c.style.setProperty('--w', rnd(120, 260) + 'px');
          c.style.setProperty('--o', rnd(0.55, 0.95).toFixed(2));
          c.style.setProperty('--b', i % 2 ? '2px' : '0px');
          c.style.setProperty('--d', rnd(70, 130) + 's');
          c.style.setProperty('--delay', (-rnd(0, 120)) + 's');
          clouds.appendChild(c);
        }
      }

      // ----- floating things: balloons, notes and sparkles on two depth layers
      function fill(layerId, count, depth) {
        var layer = document.getElementById(layerId);
        if (!layer) return;
        var kinds = ['balloon', 'balloon', 'note', 'note', 'star'];
        for (var i = 0; i < count; i++) {
          var kind = pick(kinds);
          var el = document.createElement('div');
          el.className = 'fl';
          var size = kind === 'balloon' ? rnd(30, 56) : kind === 'note' ? rnd(22, 36) : rnd(12, 22);
          if (depth === 'front') size *= 1.35;
          el.style.setProperty('--x', rnd(2, 96) + '%');
          el.style.setProperty('--s', size + 'px');
          el.style.setProperty('--d', rnd(16, 34) + 's');
          el.style.setProperty('--delay', (-rnd(0, 34)) + 's');
          el.style.setProperty('--dx', rnd(-90, 90) + 'px');
          el.style.setProperty('--sw', rnd(2.6, 5.2) + 's');
          el.style.setProperty('--o', depth === 'front' ? rnd(0.75, 0.95).toFixed(2) : rnd(0.6, 0.9).toFixed(2));
          if (depth === 'front') el.style.setProperty('--b', '1.5px');
          el.innerHTML = SVG[kind](pick(COLORS));
          layer.appendChild(el);
        }
      }
      var small = window.matchMedia('(max-width: 560px)').matches;
      if (!reduce) {
        fill('layer-back', small ? 8 : 14, 'back');
        fill('layer-front', small ? 3 : 5, 'front');
      }

      // ----- pointer + scroll parallax (desktop pointer only; cheap transforms)
      var stage = document.getElementById('stage');
      var back = document.getElementById('layer-back');
      var front = document.getElementById('layer-front');
      var px = 0, py = 0, sy = 0, ticking = false;
      function apply() {
        ticking = false;
        if (back) back.style.transform = 'translate3d(' + (px * -14) + 'px,' + (py * -10 - sy * 0.04) + 'px,0)';
        if (front) front.style.transform = 'translate3d(' + (px * 26) + 'px,' + (py * 18 - sy * 0.12) + 'px,0)';
        if (stage) stage.style.transform = 'translate3d(' + (px * 8) + 'px,' + (py * 6 - sy * 0.06) + 'px,0)';
      }
      function req() { if (!ticking) { ticking = true; requestAnimationFrame(apply); } }
      if (!reduce) {
        window.addEventListener('scroll', function () { sy = Math.min(window.scrollY, 700); req(); }, { passive: true });
        if (fine) {
          window.addEventListener('pointermove', function (e) {
            px = (e.clientX / window.innerWidth - 0.5) * 2;
            py = (e.clientY / window.innerHeight - 0.5) * 2;
            req();
          }, { passive: true });
        }
      }

      // ----- hero video (poster stays when autoplay is blocked / motion reduced)
      var vid = document.querySelector('.card-video video');
      if (vid) {
        if (reduce) { vid.pause(); vid.removeAttribute('autoplay'); }
        else { var pr = vid.play(); if (pr && pr.catch) pr.catch(function () {}); }
      }

      // ----- days left
      var dl = document.getElementById('days-left');
      var startAt = Date.parse('<%= eventInfo.startAt || '' %>');
      if (dl && !Number.isNaN(startAt)) {
        var days = Math.ceil((startAt - Date.now()) / 86400000);
        dl.textContent = days > 1 ? 'faltam ' + days + ' dias' : days === 1 ? 'é amanhã' : 'é hoje';
      }

      // ----- availability bar
      var bar = document.querySelector('.bar b');
      if (bar) {
        if (reduce) bar.style.transition = 'none';
        var go = function () { bar.style.width = bar.getAttribute('data-pct') + '%'; };
        if ('IntersectionObserver' in window) {
          var bo = new IntersectionObserver(function (en) { if (en[0].isIntersecting) { go(); bo.disconnect(); } }, { threshold: 0.5 });
          bo.observe(bar);
        } else { go(); }
      }

      // ----- sticky buy bar on phones: after the hero, hidden while buying
      var sticky = document.getElementById('sticky-cta');
      var buy = document.getElementById('ingressos');
      var hero = document.getElementById('hero');
      if (sticky && buy && hero && 'IntersectionObserver' in window) {
        var heroOut = false, buyIn = false;
        var upd = function () { sticky.classList.toggle('show', heroOut && !buyIn); };
        new IntersectionObserver(function (en) { heroOut = !en[0].isIntersecting; upd(); }, { threshold: 0.15 }).observe(hero);
        new IntersectionObserver(function (en) { buyIn = en[0].isIntersecting; upd(); }, { threshold: 0.2 }).observe(buy);
      }
    })();
  </script>

  <% if (lote && !comingSoon) { %>
  <script>
    (function () {
      var maxQty = Math.min(<%= lote.remaining %>, <%= maxQty %>);
      var unitPrice = <%= lote.price %>;
      var qtyInput = document.getElementById('qty-input');
      var qtyValue = document.getElementById('qty-value');
      var qtyTotal = document.getElementById('qty-total');
      var minusBtn = document.getElementById('qty-minus');
      var plusBtn = document.getElementById('qty-plus');
      var qty = 1;
      function render() {
        qtyValue.textContent = qty;
        qtyInput.value = qty;
        qtyTotal.textContent = 'R$ ' + (qty * unitPrice).toFixed(2).replace('.', ',');
        if (qty <= 1) minusBtn.setAttribute('disabled', ''); else minusBtn.removeAttribute('disabled');
        if (qty >= maxQty) plusBtn.setAttribute('disabled', ''); else plusBtn.removeAttribute('disabled');
      }
      minusBtn.addEventListener('click', function () { if (qty > 1) { qty -= 1; render(); } });
      plusBtn.addEventListener('click', function () { if (qty < maxQty) { qty += 1; render(); } });
      render();
    })();
  </script>
  <% } %>
</body>
</html>
