<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page page-wide">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row">
      <a href="/admin" class="tab active">Vendas</a>
      <a href="/admin/lotes" class="tab">Lotes</a>
      <a href="/admin/cortesias" class="tab">Cortesias</a>
      <a href="/admin/mensagens" class="tab">E-mail e WhatsApp</a>
      <a href="/contabilidade" class="tab">Contabilidade</a>
      <a href="/downloads" class="tab">Músicas</a>
    </nav>

    <main class="card">
      <div class="stats-row">
        <div class="stat-box">
          <span class="stat-label">Arrecadado</span>
          <span class="stat-value">R$ <%= stats.totalRevenue.toFixed(2).replace('.', ',') %></span>
        </div>
        <div class="stat-box">
          <span class="stat-label">Ingressos vendidos</span>
          <span class="stat-value"><%= stats.ticketsSold %></span>
        </div>
        <div class="stat-box">
          <span class="stat-label">Pedidos pagos</span>
          <span class="stat-value"><%= stats.paidOrders %></span>
        </div>
      </div>

      <h3>Por lote</h3>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Lote</th><th>Vendidos</th><th>Arrecadado</th></tr>
          </thead>
          <tbody>
            <% loteBreakdown.forEach(function(l) { %>
              <tr>
                <td><%= l.name %></td>
                <td><%= l.sold %></td>
                <td>R$ <%= l.revenue.toFixed(2).replace('.', ',') %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </main>

    <main class="card">
      <h3>Disparo em massa (WhatsApp)</h3>
      <p class="hint" style="margin-top:0">Envia uma mensagem para todos os contatos da instancia Evolution API (usa o mesmo recurso de broadcast do n8n).</p>
      <div id="broadcast-result" class="alert" style="display:none"></div>
      <form class="form" id="broadcast-form">
        <label>
          Mensagem
          <textarea name="mensagem" rows="4" required style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:12px 14px;color:var(--text);font-size:15px;font-family:inherit;"></textarea>
        </label>
        <button type="submit" <%= broadcastConfigured ? '' : 'disabled' %>>Enviar para todos os compradores</button>
        <% if (!broadcastConfigured) { %>
          <p class="hint">Configure N8N_BROADCAST_WEBHOOK_URL para habilitar este envio.</p>
        <% } %>
      </form>
    </main>

    <main class="card">
      <h3>Compradores / leads</h3>
      <p class="hint" style="margin-top:0">O botao WhatsApp abre uma conversa no seu proprio WhatsApp com a mensagem e o link do ingresso ja prontos — e so tocar em enviar. E-mail e enviado direto por aqui.</p>
      <label style="margin-bottom:14px; display:block">
        Buscar por nome, e-mail ou WhatsApp
        <input type="text" id="leads-search" placeholder="Digite para filtrar..." />
      </label>
      <div id="reenviar-result" class="alert" style="display:none"></div>
      <div class="table-wrap">
        <table id="leads-table">
          <thead>
            <tr>
              <th>Nome</th><th>E-mail</th><th>WhatsApp</th><th>CPF</th>
              <th>Lote</th><th>Qtd</th><th>Total</th><th>Status</th><th>Data da compra</th><th></th>
            </tr>
          </thead>
          <tbody>
            <% orders.forEach(function(o) { %>
              <tr data-search="<%= [o.buyerName, o.buyerEmail, o.buyerPhone].join(' ').toLowerCase() %>">
                <td><%= o.buyerName %></td>
                <td><%= o.buyerEmail %></td>
                <td><%= o.buyerPhone %></td>
                <td><%= o.buyerCpf %></td>
                <td><%= o.loteName %></td>
                <td><%= o.quantity %></td>
                <td>R$ <%= o.totalAmount.toFixed(2).replace('.', ',') %></td>
                <td>
                  <% if (o.status === 'cancelled') { %>
                    <span style="color:#fecaca">cancelado</span><br />
                    <span class="hint" style="margin:0;text-align:left"><%= o.refund ? 'reembolsado' : 'sem reembolso' %><% if (o.cancelReason) { %> &middot; <%= o.cancelReason %><% } %></span>
                  <% } else { %>
                    <%= o.status %>
                  <% } %>
                </td>
                <td><%= o.createdAtLabel %></td>
                <td>
                  <% if (o.status === 'paid') { %>
                    <div style="display:flex; gap:6px">
                      <button type="button" class="btn-secondary btn-reenviar" data-order-id="<%= o.id %>" data-canal="email" style="margin-top:0; width:auto; padding:6px 10px; font-size:12px">📧 E-mail</button>
                      <a href="<%= o.whatsappResendLink %>" target="_blank" rel="noopener"><button type="button" class="btn-secondary" style="margin-top:0; width:auto; padding:6px 10px; font-size:12px">📲 WhatsApp</button></a>
                      <button type="button" class="btn-danger btn-cancelar" data-order-id="<%= o.id %>" data-nome="<%= o.buyerName %>" data-total="<%= o.totalAmount.toFixed(2).replace('.', ',') %>" data-courtesy="<%= o.isCourtesy ? '1' : '0' %>" style="margin-top:0; width:auto; padding:6px 10px; font-size:12px">✖ Cancelar</button>
                    </div>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (orders.length === 0) { %>
              <tr><td colspan="10" style="text-align:center">Nenhum pedido ainda.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>

  <dialog id="cancel-dialog" class="cancel-dialog">
    <form method="dialog" id="cancel-form" class="form">
      <h3 style="margin:0">Cancelar ingressos</h3>
      <p class="hint" style="margin:0; text-align:left" id="cancel-resumo"></p>
      <div id="cancel-opcoes">
        <label class="radio-row"><input type="radio" name="modo" value="mp" checked /> <span>Cancelar e <strong>reembolsar agora</strong> pelo Mercado Pago (valor integral)</span></label>
        <label class="radio-row"><input type="radio" name="modo" value="manual" /> <span>Cancelar — <strong>ja reembolsei</strong> manualmente pelo app</span></label>
        <label class="radio-row"><input type="radio" name="modo" value="nenhum" /> <span>Cancelar <strong>sem reembolso</strong></span></label>
      </div>
      <label>
        Motivo (opcional)
        <input type="text" id="cancel-motivo" maxlength="200" placeholder="Ex: pediu reembolso, compra duplicada..." />
      </label>
      <div id="cancel-erro" class="alert" style="display:none"></div>
      <div class="btn-row">
        <button type="button" class="btn-secondary" id="cancel-fechar">Voltar</button>
        <button type="submit" class="btn-danger" id="cancel-confirmar">Confirmar cancelamento</button>
      </div>
    </form>
  </dialog>

  <script>
    const form = document.getElementById('broadcast-form');
    const resultBox = document.getElementById('broadcast-result');
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const mensagem = form.mensagem.value.trim();
      if (!mensagem) return;
      if (!confirm('Enviar esta mensagem para TODOS os compradores no WhatsApp?')) return;

      const btn = form.querySelector('button');
      btn.disabled = true;
      try {
        const res = await fetch('/api/admin/broadcast', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ mensagem }),
        });
        const data = await res.json();
        resultBox.style.display = 'block';
        resultBox.textContent = res.ok ? 'Mensagem enviada para disparo!' : (data.error || 'Erro ao enviar.');
      } catch (err) {
        resultBox.style.display = 'block';
        resultBox.textContent = 'Erro de conexao.';
      } finally {
        btn.disabled = false;
      }
    });

    document.getElementById('leads-search').addEventListener('input', (e) => {
      const term = e.target.value.trim().toLowerCase();
      document.querySelectorAll('#leads-table tbody tr[data-search]').forEach((row) => {
        row.hidden = term.length > 0 && !row.dataset.search.includes(term);
      });
    });

    const cancelDialog = document.getElementById('cancel-dialog');
    const cancelForm = document.getElementById('cancel-form');
    const cancelErro = document.getElementById('cancel-erro');
    const cancelConfirmar = document.getElementById('cancel-confirmar');
    let cancelOrderId = null;

    document.querySelectorAll('.btn-cancelar').forEach((btn) => {
      btn.addEventListener('click', () => {
        cancelOrderId = btn.dataset.orderId;
        const cortesia = btn.dataset.courtesy === '1';
        document.getElementById('cancel-resumo').textContent = cortesia
          ? 'Cortesia de ' + btn.dataset.nome + '. Os ingressos deixam de valer na entrada.'
          : 'Pedido de ' + btn.dataset.nome + ' (R$ ' + btn.dataset.total + '). Os ingressos deixam de valer na entrada e o QR code passa a ser recusado.';
        document.getElementById('cancel-opcoes').style.display = cortesia ? 'none' : 'block';
        cancelForm.modo.value = cortesia ? 'nenhum' : 'mp';
        document.getElementById('cancel-motivo').value = '';
        cancelErro.style.display = 'none';
        cancelDialog.showModal();
      });
    });

    document.getElementById('cancel-fechar').addEventListener('click', () => cancelDialog.close());

    cancelForm.addEventListener('submit', async (e) => {
      e.preventDefault();
      const modo = cancelForm.modo.value;
      if (modo === 'mp' && !confirm('Confirma o REEMBOLSO integral pelo Mercado Pago? Esta acao nao pode ser desfeita.')) return;
      cancelConfirmar.disabled = true;
      cancelConfirmar.textContent = 'Processando...';
      cancelErro.style.display = 'none';
      try {
        const res = await fetch('/api/admin/pedidos/' + cancelOrderId + '/cancelar', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            reembolsar: modo === 'mp',
            jaReembolsado: modo === 'manual',
            motivo: document.getElementById('cancel-motivo').value,
          }),
        });
        const data = await res.json();
        if (res.ok) {
          window.location.reload();
          return;
        }
        cancelErro.textContent = data.error || 'Erro ao cancelar.';
        cancelErro.style.display = 'block';
      } catch (err) {
        cancelErro.textContent = 'Erro de conexao.';
        cancelErro.style.display = 'block';
      } finally {
        cancelConfirmar.disabled = false;
        cancelConfirmar.textContent = 'Confirmar cancelamento';
      }
    });

    const reenviarResult = document.getElementById('reenviar-result');
    document.querySelectorAll('.btn-reenviar').forEach((btn) => {
      btn.addEventListener('click', async () => {
        if (!confirm('Reenviar o ingresso por e-mail para este comprador?')) return;
        btn.disabled = true;
        const original = btn.textContent;
        btn.textContent = 'Enviando...';
        try {
          const res = await fetch(`/api/admin/pedidos/${btn.dataset.orderId}/reenviar`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ canal: 'email' }),
          });
          const data = await res.json();
          reenviarResult.style.display = 'block';
          if (res.ok) {
            reenviarResult.style.background = 'rgba(34,197,94,0.15)';
            reenviarResult.style.borderColor = '#22c55e';
            reenviarResult.style.color = '#86efac';
            reenviarResult.textContent = 'Ingresso reenviado por e-mail!';
          } else {
            reenviarResult.style.background = '';
            reenviarResult.style.borderColor = '';
            reenviarResult.style.color = '';
            reenviarResult.textContent = data.error || 'Erro ao reenviar.';
          }
        } catch (err) {
          reenviarResult.style.display = 'block';
          reenviarResult.textContent = 'Erro de conexao.';
        } finally {
          btn.disabled = false;
          btn.textContent = original;
        }
      });
    });
  </script>
</body>
</html>
