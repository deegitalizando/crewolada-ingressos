<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Eu vou - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
  <style>
    .foto-canvas-wrap {
      position: relative;
      display: flex;
      justify-content: center;
      border-radius: 16px;
      overflow: hidden;
      border: 1px solid var(--card-border);
      background: #000;
    }
    /* Capped to a fraction of the viewport height so the canvas never fills
       the whole screen on a phone — otherwise there'd be no page area left
       outside it to start a scroll gesture from, since the canvas itself
       blocks touch scrolling to allow panning the photo with one finger. */
    #foto-canvas {
      display: block;
      width: auto;
      height: auto;
      max-width: 100%;
      max-height: 60vh;
      touch-action: none;
      cursor: grab;
    }
    #foto-canvas.dragging { cursor: grabbing; }

    .zoom-row { display: flex; align-items: center; gap: 10px; margin-top: 14px; }
    .zoom-row input[type="range"] { flex: 1; height: 32px; }

    .foto-actions { display: flex; flex-direction: column; gap: 10px; margin-top: 18px; }
    .file-label {
      display: block;
      text-align: center;
      background: var(--accent);
      color: #1a1200;
      border-radius: 12px;
      padding: 16px 18px;
      font-size: 16px;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.03em;
      cursor: pointer;
    }
    .file-label input { display: none; }
  </style>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <p class="hero-sub">Monte sua arte "Confirmado na Crewolada" e compartilhe!</p>
    </header>

    <main class="card">
      <div class="foto-canvas-wrap">
        <canvas id="foto-canvas"></canvas>
      </div>

      <p class="hint" style="margin-top:8px">Toque e arraste a foto para posicionar. Use o dedo (pinça) ou o controle para dar zoom.</p>

      <div class="zoom-row">
        <span class="hint" style="margin:0">🔍</span>
        <input type="range" id="zoom-range" min="1" max="3" step="0.01" value="1" disabled />
      </div>

      <div class="foto-actions">
        <label class="file-label">
          📷 Escolher foto
          <input type="file" id="file-input" accept="image/*" />
        </label>
        <button type="button" id="btn-download" disabled>Baixar imagem</button>
        <button type="button" id="btn-share" class="btn-secondary" hidden>Compartilhar</button>
      </div>
    </main>
  </div>

  <script>
    const canvas = document.getElementById('foto-canvas');
    const ctx = canvas.getContext('2d');
    const W = 1080;
    const H = 1080;
    canvas.width = W;
    canvas.height = H;

    // Window carved out of the frame artwork where the photo shows through
    // (measured from the frame's own transparent pixels, then scaled from
    // its native 1254x1254 to this canvas's 1080x1080).
    const K = W / 1254;
    const WINDOW = { x: 193 * K, y: 219 * K, w: 870 * K, h: 669 * K };

    const fileInput = document.getElementById('file-input');
    const zoomRange = document.getElementById('zoom-range');
    const downloadBtn = document.getElementById('btn-download');
    const shareBtn = document.getElementById('btn-share');

    let img = null;
    let scale = 1;
    let minScale = 1;
    let offsetX = 0;
    let offsetY = 0;
    let dragging = false;
    let lastX = 0;
    let lastY = 0;
    const activePointers = new Map();
    let pinchStartDist = null;
    let pinchStartScale = 1;

    const frameImg = new Image();
    let frameReady = false;
    frameImg.onload = () => { frameReady = true; render(); };
    frameImg.src = '/img/foto-frame.webp';

    function recalcPhotoFit() {
      if (!img) return;
      minScale = Math.max(WINDOW.w / img.width, WINDOW.h / img.height);
      scale = minScale;
      offsetX = 0;
      offsetY = 0;
      zoomRange.value = '1';
    }

    function clampOffset() {
      if (!img) return;
      const iw = img.width * scale;
      const ih = img.height * scale;
      const maxOffX = Math.max(0, (iw - WINDOW.w) / 2);
      const maxOffY = Math.max(0, (ih - WINDOW.h) / 2);
      offsetX = Math.min(maxOffX, Math.max(-maxOffX, offsetX));
      offsetY = Math.min(maxOffY, Math.max(-maxOffY, offsetY));
    }

    function render() {
      ctx.clearRect(0, 0, W, H);
      ctx.fillStyle = '#000000';
      ctx.fillRect(0, 0, W, H);

      ctx.save();
      ctx.beginPath();
      ctx.rect(WINDOW.x, WINDOW.y, WINDOW.w, WINDOW.h);
      ctx.clip();
      if (img) {
        const iw = img.width * scale;
        const ih = img.height * scale;
        const cx = WINDOW.x + WINDOW.w / 2 + offsetX;
        const cy = WINDOW.y + WINDOW.h / 2 + offsetY;
        ctx.drawImage(img, cx - iw / 2, cy - ih / 2, iw, ih);
      } else {
        ctx.fillStyle = '#1a1a1a';
        ctx.fillRect(WINDOW.x, WINDOW.y, WINDOW.w, WINDOW.h);
        ctx.fillStyle = '#a8a29a';
        ctx.font = '600 30px "Segoe UI", Arial, sans-serif';
        ctx.textAlign = 'center';
        ctx.textBaseline = 'middle';
        ctx.fillText('Sua foto aqui', WINDOW.x + WINDOW.w / 2, WINDOW.y + WINDOW.h / 2);
      }
      ctx.restore();

      if (frameReady) {
        ctx.drawImage(frameImg, 0, 0, W, H);
      }
    }

    fileInput.addEventListener('change', (e) => {
      const file = e.target.files[0];
      if (!file) return;
      const url = URL.createObjectURL(file);
      const image = new Image();
      image.onload = () => {
        img = image;
        recalcPhotoFit();
        zoomRange.disabled = false;
        downloadBtn.disabled = false;
        render();
        URL.revokeObjectURL(url);
      };
      image.src = url;
    });

    zoomRange.addEventListener('input', () => {
      scale = minScale * parseFloat(zoomRange.value);
      clampOffset();
      render();
    });

    function canvasScaleFactor() {
      return canvas.width / canvas.getBoundingClientRect().width;
    }

    canvas.addEventListener('pointerdown', (e) => {
      if (!img) return;
      // Capture is best-effort: if it throws (some browsers reject it in
      // edge cases), dragging must still register instead of silently
      // doing nothing.
      try { canvas.setPointerCapture(e.pointerId); } catch (err) { /* ignore */ }
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });
      if (activePointers.size === 1) {
        dragging = true;
        canvas.classList.add('dragging');
        lastX = e.clientX;
        lastY = e.clientY;
      } else if (activePointers.size === 2) {
        dragging = false;
        const pts = [...activePointers.values()];
        pinchStartDist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        pinchStartScale = scale;
      }
    });

    canvas.addEventListener('pointermove', (e) => {
      if (!activePointers.has(e.pointerId)) return;
      activePointers.set(e.pointerId, { x: e.clientX, y: e.clientY });

      if (activePointers.size === 2 && pinchStartDist) {
        const pts = [...activePointers.values()];
        const dist = Math.hypot(pts[0].x - pts[1].x, pts[0].y - pts[1].y);
        const ratio = dist / pinchStartDist;
        scale = Math.min(minScale * 3, Math.max(minScale, pinchStartScale * ratio));
        zoomRange.value = String(scale / minScale);
        clampOffset();
        render();
        return;
      }

      if (!dragging) return;
      const k = canvasScaleFactor();
      offsetX += (e.clientX - lastX) * k;
      offsetY += (e.clientY - lastY) * k;
      lastX = e.clientX;
      lastY = e.clientY;
      clampOffset();
      render();
    });

    ['pointerup', 'pointercancel', 'pointerleave'].forEach((ev) => {
      canvas.addEventListener(ev, (e) => {
        activePointers.delete(e.pointerId);
        pinchStartDist = null;
        if (activePointers.size === 0) {
          dragging = false;
          canvas.classList.remove('dragging');
        }
      });
    });

    downloadBtn.addEventListener('click', () => {
      canvas.toBlob((blob) => {
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = 'confirmado-na-crewolada.png';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(() => URL.revokeObjectURL(url), 2000);
      }, 'image/png');
    });

    if (navigator.canShare && navigator.share) {
      shareBtn.hidden = false;
      shareBtn.addEventListener('click', () => {
        canvas.toBlob(async (blob) => {
          const file = new File([blob], 'confirmado-na-crewolada.png', { type: 'image/png' });
          try {
            if (navigator.canShare({ files: [file] })) {
              await navigator.share({ files: [file], text: 'Confirmado na Crewolada! 🎟️' });
            }
          } catch (e) { /* user cancelled */ }
        }, 'image/png');
      });
    }

    render();
  </script>
</body>
</html>
