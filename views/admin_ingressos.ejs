<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Ingressos - Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page page-wide">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row">
      <a href="/admin" class="tab">Vendas</a>
      <a href="/admin/eventos" class="tab">Eventos</a>
      <a href="/admin/ingressos" class="tab active">Ingressos</a>
      <a href="/admin/cortesias" class="tab">Cortesias</a>
      <a href="/admin/contatos" class="tab">Convites</a>
      <a href="/admin/afiliados" class="tab">Afiliados</a>
      <a href="/admin/avisos" class="tab">Avisos</a>
      <a href="/admin/links" class="tab">Links</a>
      <a href="/admin/mensagens" class="tab">E-mail e WhatsApp</a>
      <a href="/contabilidade" class="tab">Contabilidade</a>
      <a href="/admin/relatorio" class="tab">Relatório</a>
      <a href="/admin/pesquisa" class="tab">Pesquisa</a>
      <a href="/admin/sorteio" class="tab">Sorteio</a>
      <a href="/downloads" class="tab">Músicas</a>
      <a href="/admin/criesuamusica" class="tab">Música IA</a>
      <a href="/admin/automacoes" class="tab">Automações</a>
    </nav>

    <% const brl = function (n) { return (Math.round(n * 100) / 100).toFixed(2).replace('.', ','); }; %>
    <% const stLabel = { atual: 'atual', futuro: 'futuro', anterior: 'anterior', cancelado: 'cancelado' }; %>

    <section class="in-wrap">
      <form method="GET" action="/admin/ingressos" class="in-pick">
        <label>Evento
          <select name="evento" onchange="this.form.submit()">
            <% events.forEach(function (e) { %><option value="<%= e.id %>" <%= e.id === ev.id ? 'selected' : '' %>><%= e.name %> · <%= e.dateLabel %> (<%= stLabel[e.status] || e.status %>)</option><% }) %>
          </select>
        </label>
        <noscript><button type="submit">Abrir</button></noscript>
      </form>

      <% if (novo) { %><div class="alert in-ok">Evento criado! Agora cadastre os ingressos dele e clique em Salvar.</div><% } %>
      <% if (saved) { %><div class="alert in-ok">Ingressos salvos. <% if (ev.status === 'atual') { %>O site já está vendendo com esses valores.<% } else { %>Quando for a hora de vender, vá em Eventos e clique em "Definir como atual".<% } %></div><% } %>
      <% if (erro) { %><div class="alert"><%= erro %></div><% } %>

      <main class="card" style="margin:0">
        <div class="in-head">
          <div>
            <h3 style="margin:0"><%= ev.name %></h3>
            <p class="in-dim"><%= ev.dateLabel %><%= ev.timeLabel ? ' · ' + ev.timeLabel : '' %> &middot; <%= soldCount %> ingresso(s) vendido(s)</p>
          </div>
          <a href="/admin/eventos" class="in-link">Editar evento ↗</a>
        </div>

        <div class="in-modes" role="tablist">
          <label class="in-mode"><input type="radio" name="modo-ui" value="lotes" <%= mode === 'lotes' ? 'checked' : '' %> /><span><strong>Por lotes</strong><small>1º lote, 2º lote... o preço sobe quando um lote esgota</small></span></label>
          <label class="in-mode"><input type="radio" name="modo-ui" value="tipos" <%= mode === 'tipos' ? 'checked' : '' %> /><span><strong>Por tipos de ingresso</strong><small>Ex.: Simples e Passaporte, com meia para crianças</small></span></label>
        </div>

        <!-- ================= LOTES ================= -->
        <form action="/admin/ingressos" method="POST" class="in-panel" data-panel="lotes" id="f-lotes">
          <input type="hidden" name="evento" value="<%= ev.id %>" />
          <input type="hidden" name="modo" value="lotes" />
          <p class="in-dim" style="margin:0 0 12px">Os lotes são vendidos na ordem da lista. Use as setas para mudar a ordem.</p>
          <div class="in-table-head"><span>Nome</span><span>Quantidade</span><span>Preço (R$)</span><span></span></div>
          <div id="lotes-rows">
            <% (lotes.length ? lotes : [null]).forEach(function (l) { %>
            <div class="in-row lote-row">
              <label><span class="m">Nome</span><input type="text" class="f-name" value="<%= l ? l.name : '1º Lote' %>" maxlength="40" /></label>
              <label><span class="m">Quantidade</span><input type="number" class="f-qty" min="1" value="<%= l ? l.quantity : '' %>" /></label>
              <label><span class="m">Preço (R$)</span><input type="number" class="f-price" min="0" step="0.01" value="<%= l ? l.price : '' %>" /></label>
              <span class="in-tools">
                <button type="button" class="in-ico" data-act="up" aria-label="Subir">↑</button>
                <button type="button" class="in-ico" data-act="down" aria-label="Descer">↓</button>
                <button type="button" class="in-ico in-del" data-act="del" aria-label="Excluir lote">✕</button>
              </span>
              <% if (l) { %><span class="in-st <%= l.status %>"><%= l.status === 'esgotado' ? 'Esgotado' : l.status === 'atual' ? 'À venda · ' + (l.quantity - l.vendidos) + ' restantes' : 'Próximo' %> · <%= l.vendidos %> vendido(s)</span><% } %>
            </div>
            <% }) %>
          </div>
          <button type="button" class="btn-secondary in-add" data-add="lote">+ Adicionar lote</button>
          <p class="in-total">Total: <strong id="lotes-total">0</strong> ingressos</p>
          <button type="submit">Salvar lotes</button>
        </form>

        <!-- ================= TIPOS ================= -->
        <form action="/admin/ingressos" method="POST" class="in-panel" data-panel="tipos" id="f-tipos">
          <input type="hidden" name="evento" value="<%= ev.id %>" />
          <input type="hidden" name="modo" value="tipos" />
          <p class="in-dim" style="margin:0 0 12px">Cada compra é de um tipo de ingresso. Adultos pagam o preço cheio, crianças pagam meia e bebês não pagam (regras abaixo).</p>
          <div class="in-table-head tipos"><span>Nome</span><span>Preço (R$)</span><span>Inclui (separado por vírgula)</span><span></span></div>
          <div id="tipos-rows">
            <% (products.length ? products : [null]).forEach(function (p) { %>
            <div class="in-row tipo-row">
              <input type="hidden" class="f-id" value="<%= p ? p.id : '' %>" />
              <label><span class="m">Nome</span><input type="text" class="f-name" value="<%= p ? p.name : '' %>" maxlength="60" placeholder="Ingresso Simples" /></label>
              <label><span class="m">Preço (R$)</span><input type="number" class="f-price" min="0" step="0.01" value="<%= p ? p.price : '' %>" /></label>
              <label><span class="m">Inclui</span><input type="text" class="f-inc" value="<%= p ? p.includes.join(', ') : '' %>" placeholder="Churrasco, Refrigerante" /></label>
              <span class="in-tools">
                <button type="button" class="in-ico" data-act="up" aria-label="Subir">↑</button>
                <button type="button" class="in-ico" data-act="down" aria-label="Descer">↓</button>
                <button type="button" class="in-ico in-del" data-act="del" aria-label="Excluir tipo">✕</button>
              </span>
            </div>
            <% }) %>
          </div>
          <button type="button" class="btn-secondary in-add" data-add="tipo">+ Adicionar tipo de ingresso</button>

          <h4 class="in-sub">Total à venda</h4>
          <label>Total de ingressos <input type="number" min="1" name="capacity" value="<%= ev.capacity || '' %>" required /></label>
          <p class="in-dim" style="margin:4px 0 0">Adultos e crianças que pagam meia contam no limite. Ao chegar nele, a venda fecha sozinha.</p>

          <h4 class="in-sub">Crianças</h4>
          <div class="in-2">
            <label>Não pagam até (anos) <input type="number" min="0" max="17" name="freeUntil" value="<%= rules.freeUntil %>" /></label>
            <label>Pagam meia até (anos) <input type="number" min="0" max="17" name="halfUntil" value="<%= rules.halfUntil %>" /></label>
          </div>
          <label class="in-check"><input type="checkbox" name="freeCounts" <%= rules.freeCountsInCapacity ? 'checked' : '' %> /> Os bebês (que não pagam) contam no limite de ingressos</label>

          <button type="submit" style="margin-top:18px">Salvar tipos de ingresso</button>
        </form>
      </main>

      <main class="card" style="margin:16px 0 0">
        <h3 style="margin-top:0">Quantidade restante na página de venda</h3>
        <form action="/admin/ingressos" method="POST">
          <input type="hidden" name="evento" value="<%= ev.id %>" />
          <input type="hidden" name="modo" value="aviso" />
          <label>Mostrar ao comprador quantos ingressos restam só quando faltarem menos de
            <input type="number" name="showLeftBelow" min="0" value="<%= showLeftBelow %>" style="max-width:160px" />
          </label>
          <p class="in-dim" style="margin:4px 0 12px">Antes disso a página mostra só "Ingressos limitados". <%= mode === 'lotes' ? 'Nos lotes, vale para o que resta no lote à venda.' : 'Vale para o total que resta à venda.' %> Use 0 para nunca mostrar.</p>
          <button type="submit" class="btn-secondary" style="width:auto">Salvar</button>
        </form>
      </main>
    </section>

  <style>
    .in-wrap { margin: 0 16px; }
    .in-pick { margin-bottom: 14px; }
    .in-pick select { width: 100%; }
    .in-ok { background: rgba(34,197,94,0.15); border-color: #22c55e; color: #86efac; }
    .in-head { display: flex; justify-content: space-between; align-items: flex-start; gap: 12px; }
    .in-dim { color: var(--text-dim); font-size: 13px; margin: 4px 0 0; text-align: left; }
    .in-link { color: var(--accent); font-weight: 700; font-size: 14px; text-decoration: none; flex: none; }
    .in-modes { display: grid; gap: 8px; margin: 16px 0 18px; }
    @media (min-width: 640px) { .in-modes { grid-template-columns: 1fr 1fr; } }
    .in-mode { display: flex !important; flex-direction: row !important; gap: 10px; align-items: flex-start; padding: 12px; border: 1px solid var(--card-border); border-radius: 12px; background: #141414; cursor: pointer; }
    .in-mode input { width: 18px !important; height: 18px; margin: 2px 0 0; flex: none; }
    .in-mode small { display: block; color: var(--text-dim); font-size: 12px; font-weight: 400; }
    .in-mode:has(input:checked) { border-color: var(--accent); box-shadow: 0 0 0 1px var(--accent); }
    .in-panel { display: none; }
    .in-panel.on { display: block; }
    .in-row { display: grid; grid-template-columns: 1fr; gap: 8px; padding: 12px; border: 1px solid var(--card-border); border-radius: 12px; background: #141414; margin-bottom: 8px; }
    .in-row label { margin: 0; }
    .in-row .m { display: block; font-size: 12px; color: var(--text-dim); }
    .in-table-head { display: none; }
    @media (min-width: 720px) {
      .in-table-head { display: grid; grid-template-columns: 2fr 1fr 1fr 120px; gap: 8px; padding: 0 12px 6px; font-size: 12px; color: var(--text-dim); }
      .in-table-head.tipos { grid-template-columns: 2fr 1fr 3fr 120px; }
      .in-row { grid-template-columns: 2fr 1fr 1fr 120px; align-items: center; }
      .tipo-row { grid-template-columns: 2fr 1fr 3fr 120px; }
      .in-row .m { display: none; }
    }
    .in-row input { margin: 0 !important; }
    .in-tools { display: flex; gap: 4px; justify-content: flex-end; }
    .in-ico { width: 34px !important; height: 34px; margin: 0 !important; padding: 0 !important; border-radius: 8px; background: #222 !important; color: #ddd !important; font-size: 15px; border: 1px solid transparent !important; }
    .in-ico:hover { border-color: var(--accent) !important; }
    .in-ico[disabled] { opacity: .3; }
    .in-del:hover { border-color: #ef4444 !important; color: #fca5a5 !important; }
    .in-st { grid-column: 1 / -1; font-size: 12px; font-weight: 700; color: var(--text-dim); }
    .in-st.atual { color: #86efac; }
    .in-st.esgotado { color: #fca5a5; }
    .in-add { width: auto !important; margin: 4px 0 0 !important; }
    .in-total { margin: 14px 0; color: var(--text-dim); text-align: left; }
    .in-total strong { color: #fff; }
    .in-sub { margin: 22px 0 8px; }
    .in-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; }
    .in-check { display: flex !important; flex-direction: row !important; gap: 8px; align-items: center; margin-top: 10px; }
    .in-check input { width: 18px !important; height: 18px; margin: 0; }
  </style>

  <script>
    (function () {
      var SOLD = <%= soldCount %>;
      var savedMode = '<%= mode %>';
      var panels = document.querySelectorAll('.in-panel');
      function showMode(m) { panels.forEach(function (p) { p.classList.toggle('on', p.getAttribute('data-panel') === m); }); }
      document.querySelectorAll('input[name="modo-ui"]').forEach(function (r) {
        r.addEventListener('change', function () { showMode(r.value); });
      });
      showMode(savedMode);

      function tools(container) {
        var rows = container.children;
        Array.prototype.forEach.call(rows, function (row, i) {
          row.querySelector('[data-act=up]').disabled = i === 0;
          row.querySelector('[data-act=down]').disabled = i === rows.length - 1;
        });
      }
      function total() {
        var t = 0;
        document.querySelectorAll('#lotes-rows .f-qty').forEach(function (i) { t += parseInt(i.value, 10) || 0; });
        document.getElementById('lotes-total').textContent = t;
        return t;
      }
      ['lotes-rows', 'tipos-rows'].forEach(function (id) {
        var box = document.getElementById(id);
        tools(box);
        box.addEventListener('click', function (e) {
          var b = e.target.closest('[data-act]'); if (!b) return;
          var row = b.closest('.in-row'); var act = b.getAttribute('data-act');
          if (act === 'up' && row.previousElementSibling) box.insertBefore(row, row.previousElementSibling);
          if (act === 'down' && row.nextElementSibling) box.insertBefore(row.nextElementSibling, row);
          if (act === 'del') {
            if (box.children.length === 1) { alert('Deixe pelo menos um. Para trocar, edite os campos.'); return; }
            var nm = row.querySelector('.f-name').value || 'este item';
            if (!confirm('Excluir "' + nm + '"?')) return;
            row.remove();
          }
          tools(box); total();
        });
        box.addEventListener('input', total);
      });
      total();

      document.querySelectorAll('[data-add]').forEach(function (btn) {
        btn.addEventListener('click', function () {
          var box = document.getElementById(btn.getAttribute('data-add') === 'lote' ? 'lotes-rows' : 'tipos-rows');
          var row = box.lastElementChild.cloneNode(true);
          row.querySelectorAll('input').forEach(function (i) { i.value = ''; });
          var st = row.querySelector('.in-st'); if (st) st.remove();
          if (btn.getAttribute('data-add') === 'lote') row.querySelector('.f-name').value = (box.children.length + 1) + 'º Lote';
          box.appendChild(row);
          tools(box); total();
          row.querySelector(btn.getAttribute('data-add') === 'lote' ? '.f-qty' : '.f-name').focus();
        });
      });

      // Rows become lotes[i][...] / produtos[i][...] only on submit (keeps the order on screen).
      document.getElementById('f-lotes').addEventListener('submit', function (e) {
        var f = this; f.querySelectorAll('input.gen').forEach(function (i) { i.remove(); });
        if (total() < SOLD) { e.preventDefault(); alert('A soma dos lotes não pode ser menor que os ' + SOLD + ' ingressos já vendidos.'); return; }
        if (savedMode !== 'lotes' && !confirm('Este evento passará a vender por LOTES (os tipos de ingresso deixam de valer). Continuar?')) { e.preventDefault(); return; }
        document.querySelectorAll('#lotes-rows .in-row').forEach(function (row, i) {
          [['name', '.f-name'], ['quantity', '.f-qty'], ['price', '.f-price']].forEach(function (k) {
            var h = document.createElement('input'); h.type = 'hidden'; h.className = 'gen';
            h.name = 'lotes[' + i + '][' + k[0] + ']'; h.value = row.querySelector(k[1]).value; f.appendChild(h);
          });
        });
      });
      document.getElementById('f-tipos').addEventListener('submit', function (e) {
        var f = this; f.querySelectorAll('input.gen').forEach(function (i) { i.remove(); });
        if (savedMode !== 'tipos' && !confirm('Este evento passará a vender por TIPOS DE INGRESSO (os lotes deixam de valer). Continuar?')) { e.preventDefault(); return; }
        document.querySelectorAll('#tipos-rows .in-row').forEach(function (row, i) {
          [['id', '.f-id'], ['name', '.f-name'], ['price', '.f-price'], ['includes', '.f-inc']].forEach(function (k) {
            var h = document.createElement('input'); h.type = 'hidden'; h.className = 'gen';
            h.name = 'produtos[' + i + '][' + k[0] + ']'; h.value = row.querySelector(k[1]).value; f.appendChild(h);
          });
        });
      });
    })();
  </script>
  </div>
</body>
</html>
