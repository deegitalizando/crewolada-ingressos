<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
    </header>
    <main class="card">
      <% if (error) { %>
        <div class="alert"><%= error %></div>
      <% } %>
      <form action="/admin/login" method="POST" class="form">
        <label>
          Login
          <input type="text" name="login" required autofocus />
        </label>
        <label>
          Senha
          <input type="password" name="password" required />
        </label>
        <button type="submit">Entrar</button>
      </form>
    </main>
  </div>
</body>
</html>
