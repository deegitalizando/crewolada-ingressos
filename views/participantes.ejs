<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Participantes do pedido - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <p class="hero-sub"><%= eventInfo.dateLabel %> &middot; <%= eventInfo.venue %></p>
    </header>

    <main class="card">
      <h2>Quem vai usar cada ingresso?</h2>
      <p class="hint" style="margin-top:0">
        Seu pedido tem <%= tickets.length %> ingresso<%= tickets.length === 1 ? '' : 's' %>. <strong>Cada ingresso é de uma pessoa diferente</strong> (1 por CPF):
        preencha nome, CPF, WhatsApp e e-mail de quem vai usar cada um. Você pode voltar aqui e editar até o dia do evento.
        Ingresso sem nome pode ser liberado para outra pessoa.
      </p>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert" style="background:rgba(239,68,68,0.15);border-color:#ef4444;color:#fca5a5"><%= error %></div>
      <% } %>

      <% if (saved) { %>
        <div class="alert" style="background:rgba(34,197,94,0.15);border-color:#22c55e;color:#86efac">Salvo com sucesso.</div>
      <% } %>

      <form action="/api/pedido/<%= order.id %>/participantes" method="POST" class="form">
        <% tickets.forEach(function(t, i) {
             var v = (typeof values !== 'undefined' && values && values[t.code]) || null;
             var pick = function (key, field, buyerField) {
               if (v) return v[key] || '';
               return t[field] || (i === 0 ? order[buyerField] || '' : '');
             };
             var adulto = !t.kind || t.kind === 'adulto';
             var travado = t.status === 'used' || t.status === 'cancelled' || !!t.usedAt;
             if (travado) v = null;
             var cpfVal = pick('cpf', 'participantCpf', 'buyerCpf');
             var cpfFmt = String(cpfVal).replace(/\D/g, '').replace(/^(\d{3})(\d{3})(\d{3})(\d{2})$/, '$1.$2.$3-$4'); %>
          <div class="template-box">
            <% if (travado) { %>
              <h3 style="margin-top:0">Ingresso <%= i + 1 %> &middot; <%= t.code %></h3>
              <p class="hint" style="margin:0 0 4px"><strong><%= t.participantName || (i === 0 ? order.buyerName : 'Sem nome') %></strong></p>
              <p class="hint" style="margin:0"><%= t.status === 'cancelled' ? 'Ingresso cancelado.' : 'Este ingresso já foi usado na entrada e não pode mais ser alterado.' %></p>
            <% } else { %>
            <h3 style="margin-top:0">Ingresso <%= i + 1 %><%= i === 0 ? ' · seu' : '' %><%= t.kindLabel && t.kindLabel !== 'Adulto' ? ' · ' + t.kindLabel : '' %> &middot; <%= t.code %></h3>
            <label>
              Nome completo
              <input type="text" name="participantes[<%= t.code %>][name]" maxlength="80"
                value="<%= pick('name', 'participantName', 'buyerName') %>" />
            </label>
            <label>
              CPF<%= adulto ? '' : ' (opcional)' %>
              <input type="text" name="participantes[<%= t.code %>][cpf]" data-cpf inputmode="numeric" maxlength="14" placeholder="000.000.000-00"
                value="<%= v ? cpfVal : cpfFmt %>" />
            </label>
            <label>
              E-mail
              <input type="email" name="participantes[<%= t.code %>][email]"
                value="<%= pick('email', 'participantEmail', 'buyerEmail') %>" />
            </label>
            <label>
              WhatsApp (com DDD)
              <input type="text" name="participantes[<%= t.code %>][phone]"
                value="<%= pick('phone', 'participantPhone', 'buyerPhone') %>" />
            </label>
            <% } %>
          </div>
        <% }) %>

        <button type="submit">Salvar participantes</button>
      </form>

      <div class="btn-row" style="margin-top:16px">
        <a href="/pedido/<%= order.id %>"><button type="button" class="btn-secondary">Voltar ao pedido</button></a>
      </div>
    </main>

    <%- include('partials/footer_legal') %>
  </div>
  <script>
    document.querySelectorAll('[data-cpf]').forEach(function (el) {
      el.addEventListener('input', function () {
        var d = el.value.replace(/\D/g, '').slice(0, 11);
        el.value = d.replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d{1,2})$/, '$1-$2');
      });
    });
  </script>
</body>
</html>
