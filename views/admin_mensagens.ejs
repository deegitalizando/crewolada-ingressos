<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Mensagens - Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page page-wide">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row">
      <a href="/admin" class="tab">Vendas</a>
      <a href="/admin/lotes" class="tab">Lotes</a>
      <a href="/admin/mensagens" class="tab active">E-mail e WhatsApp</a>
    </nav>

    <main class="card">
      <% if (saved) { %>
        <div class="alert" style="background:rgba(34,197,94,0.15);border-color:#22c55e;color:#86efac">Salvo com sucesso.</div>
      <% } %>

      <h3>Data e hora do evento</h3>
      <p class="hint" style="margin-top:0">Usada para calcular quando disparar os lembretes automaticos abaixo.</p>
      <form action="/api/admin/mensagens" method="POST" class="form" id="mensagens-form">
        <label>
          Inicio do evento (horario de Brasilia)
          <input type="datetime-local" name="eventStartAt" value="<%= eventStartAtLocal %>" />
        </label>

        <h3>Confirmacao de compra (WhatsApp e e-mail)</h3>
        <div class="template-box">
          <label>
            Mensagem personalizada (opcional)
            <textarea name="compra" rows="4" placeholder="Deixe em branco para usar a mensagem padrao. Use {{nome}}, {{codigo}}, {{numeroSorteio}}, {{nomeLote}}."><%= templates.compra %></textarea>
          </label>
        </div>

        <h3>Lembretes automaticos</h3>
        <p class="hint" style="margin-top:0">Enviados uma unica vez para todos os compradores pagos. Use {{nome}} na mensagem.</p>

        <div class="template-box">
          <label>
            5 dias antes do evento
            <% if (remindersSent.dias5) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="dias5" rows="3"><%= templates.dias5 %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            1 dia antes do evento
            <% if (remindersSent.dia1) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="dia1" rows="3"><%= templates.dia1 %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            No dia do evento (09h)
            <% if (remindersSent.diaEvento) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="diaEvento" rows="3"><%= templates.diaEvento %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            1 hora antes do evento
            <% if (remindersSent.hora1) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="hora1" rows="3"><%= templates.hora1 %></textarea>
          </label>
        </div>

        <button type="submit">Salvar</button>
      </form>
    </main>

    <main class="card">
      <h3>Campanhas agendadas</h3>
      <p class="hint" style="margin-top:0">Crie uma mensagem avulsa (WhatsApp + e-mail) com data/hora livre para disparar para todos os compradores pagos. Use {{nome}} na mensagem.</p>

      <form action="/api/admin/campanhas" method="POST" class="form">
        <label>
          Mensagem
          <textarea name="mensagem" rows="3" required></textarea>
        </label>
        <label>
          Enviar em (horario de Brasilia)
          <input type="datetime-local" name="sendAt" required />
        </label>
        <button type="submit">Agendar campanha</button>
      </form>

      <div class="table-wrap" style="margin-top:20px">
        <table>
          <thead>
            <tr><th>Mensagem</th><th>Enviar em</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            <% campaigns.forEach(function(c) { %>
              <tr>
                <td><%= c.mensagem %></td>
                <td><%= c.sendAtLocal.replace('T', ' ') %></td>
                <td><%= c.sent ? 'Enviada' : 'Pendente' %></td>
                <td>
                  <% if (!c.sent) { %>
                    <form action="/api/admin/campanhas/<%= c.id %>/excluir" method="POST" onsubmit="return confirm('Cancelar esta campanha?')">
                      <button type="submit" class="btn-secondary" style="margin-top:0; width:auto; padding:6px 12px; font-size:12px">Cancelar</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (campaigns.length === 0) { %>
              <tr><td colspan="4" style="text-align:center">Nenhuma campanha agendada.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
</body>
</html>
