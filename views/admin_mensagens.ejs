<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Mensagens - Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page page-wide">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row">
      <a href="/admin" class="tab">Vendas</a>
      <a href="/admin/eventos" class="tab">Eventos</a>
      <a href="/admin/ingressos" class="tab">Ingressos</a>
      <a href="/admin/cortesias" class="tab">Cortesias</a>
      <a href="/admin/contatos" class="tab">Convites</a>
      <a href="/admin/afiliados" class="tab">Afiliados</a>
      <a href="/admin/avisos" class="tab">Avisos</a>
      <a href="/admin/links" class="tab">Links</a>
      <a href="/admin/mensagens" class="tab active">E-mail e WhatsApp</a>
      <a href="/contabilidade" class="tab">Contabilidade</a>
      <a href="/admin/relatorio" class="tab">Relatório</a>
      <a href="/admin/pesquisa" class="tab">Pesquisa</a>
      <a href="/admin/sorteio" class="tab">Sorteio</a>
      <a href="/downloads" class="tab">Músicas</a>
      <a href="/admin/criesuamusica" class="tab">Música IA</a>
      <a href="/admin/automacoes" class="tab">Automações</a>
      <a href="/admin/bot" class="tab">Agente IA</a>
    </nav>

    <main class="card">
      <% if (saved) { %>
        <div class="alert" style="background:rgba(34,197,94,0.15);border-color:#22c55e;color:#86efac">Salvo com sucesso.</div>
      <% } %>

      <h3>Data e hora do evento</h3>
      <p class="hint" style="margin-top:0">Usada para calcular quando disparar os lembretes automaticos abaixo.</p>
      <form action="/api/admin/mensagens" method="POST" class="form" id="mensagens-form">
        <label>
          Inicio do evento (horario de Brasilia)
          <input type="datetime-local" name="eventStartAt" value="<%= eventStartAtLocal %>" />
        </label>

        <h3>Confirmacao de compra (WhatsApp e e-mail)</h3>
        <div class="template-box">
          <label>
            Mensagem personalizada (opcional)
            <textarea name="compra" rows="4" placeholder="Deixe em branco para usar a mensagem padrao. Use {{nome}}, {{codigo}}, {{numeroSorteio}}, {{nomeLote}}."><%= templates.compra %></textarea>
          </label>
        </div>

        <h3>Lembretes automaticos</h3>
        <p class="hint" style="margin-top:0">Enviados uma unica vez para todos os compradores pagos. Use {{nome}} na mensagem. Versões diferentes são criadas automaticamente no envio; para revisar antes, use <em>Gerar versões</em> (ficam separadas por <code>|||</code>).</p>

        <div class="template-box">
          <label>
            5 dias antes do evento
            <% if (remindersSent.dias5) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="dias5" rows="3"><%= templates.dias5 %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            1 dia antes do evento
            <% if (remindersSent.dia1) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="dia1" rows="3"><%= templates.dia1 %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            No dia do evento (09h)
            <% if (remindersSent.diaEvento) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="diaEvento" rows="3"><%= templates.diaEvento %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            1 hora antes do evento
            <% if (remindersSent.hora1) { %><span class="template-sent">ja enviado</span><% } %>
            <textarea name="hora1" rows="3"><%= templates.hora1 %></textarea>
          </label>
        </div>

        <h3>Crie Sua Própria Música: follow-ups automáticos</h3>
        <p class="hint" style="margin-top:0">
          Enviados automaticamente por pedido (não em massa), uma única vez cada. Use {{nome}} e {{link}} na mensagem.
          Carrinho abandonado dispara <%= musicaAbandonoHoras %>h após o início do pedido sem pagamento confirmado;
          a sugestão de nova música dispara <%= musicaRecompraDias %> dias após a entrega. Prazos são definidos por
          variável de ambiente (MUSICA_ABANDONO_HORAS / MUSICA_RECOMPRA_DIAS).
        </p>
        <div class="template-box">
          <label>
            Carrinho abandonado (pagamento não confirmado)
            <textarea name="musicaAbandono" rows="3"><%= templates.musicaAbandono %></textarea>
          </label>
        </div>
        <div class="template-box">
          <label>
            Sugestão de nova música (após entrega)
            <textarea name="musicaRecompra" rows="3"><%= templates.musicaRecompra %></textarea>
          </label>
        </div>

        <button type="submit">Salvar</button>
      </form>
    </main>

    <main class="card" id="email">
      <% const er = emailResumo, ep = er.padroes; %>
      <h3 style="margin-top:0">Campanha por e-mail (com o flyer)</h3>
      <p class="hint" style="margin-top:0">Um e-mail bonito, com o flyer do evento, data, local e botão de compra, para <strong>todos os <%= er.total %> contatos</strong> com e-mail do site: compradores e acompanhantes, inscrições gratuitas, música, sorteio, pesquisa, convites e afiliados. Repetidos contam uma vez só<%= er.optout ? `, e ${er.optout} pessoa(s) que pediram para sair ficam de fora` : '' %>. Sai um e-mail a cada ~<%= er.config.intervaloSeg %> s, até <%= er.config.limiteDiario %> por dia, e cada e-mail tem o link "Não quero mais receber".</p>
      <% if (emailOk) { %><div class="alert" style="background:rgba(34,197,94,0.15);border-color:#22c55e;color:#86efac"><%= emailOk %></div><% } %>
      <% if (emailErro) { %><div class="alert"><%= emailErro %></div><% } %>

      <% er.envios.forEach(function(e) { %>
        <div class="template-box" style="background:#1a1a1a;border:1px solid var(--card-border);border-radius:6px;padding:12px 14px">
          <strong><%= e.conteudo.assunto %></strong> — <%= e.status %> · <%= e.enviados %> de <%= e.total %> enviados<%= e.falhas ? ' · ' + e.falhas + ' falhas' : '' %><%= e.pendentes ? ' · ' + e.pendentes + ' na fila' : '' %>
          <div class="hint">Criada em <%= fmtDisplay(e.criadoEm) %></div>
          <% if (e.aviso) { %><div class="hint" style="color:#fca5a5"><%= e.aviso %></div><% } %>
          <% e.ultimasFalhas.forEach(function(f) { %><div class="hint" style="color:#fca5a5"><%= f.email %>: <%= f.erro %></div><% }) %>
          <div class="btn-row">
            <% if (e.status === 'enviando') { %><form action="/api/admin/email-campanha/<%= e.id %>/pausar" method="POST"><button class="btn-secondary" style="width:auto;padding:6px 12px;font-size:12px">Pausar</button></form><% } %>
            <% if (e.status === 'pausado') { %><form action="/api/admin/email-campanha/<%= e.id %>/retomar" method="POST"><button style="width:auto;padding:6px 12px;font-size:12px">Retomar</button></form><% } %>
            <% if (['enviando', 'pausado'].includes(e.status)) { %><form action="/api/admin/email-campanha/<%= e.id %>/cancelar" method="POST" onsubmit="return confirm('Cancelar o restante desta campanha?')"><button class="btn-danger" style="width:auto;padding:6px 12px;font-size:12px">Cancelar</button></form><% } %>
          </div>
        </div>
      <% }) %>

      <form method="POST" action="/api/admin/email-campanha" class="form" id="email-form">
        <label>Assunto<input name="assunto" value="<%= ep.assunto %>" maxlength="150" /></label>
        <label>Título (aparece grande, embaixo do flyer)<input name="titulo" value="<%= ep.titulo %>" maxlength="100" /></label>
        <label>Texto (use {{nome}} para o primeiro nome; deixe uma linha em branco entre parágrafos)
          <textarea name="texto" rows="7" style="background:#1a1a1a;border:1px solid rgba(255,255,255,0.12);border-radius:10px;padding:12px 14px;color:var(--text);font-size:14px;font-family:inherit"><%= ep.texto %></textarea>
        </label>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:12px">
          <label>Link da imagem do flyer<input name="flyerUrl" value="<%= ep.flyerUrl %>" /></label>
          <label>Texto do botão<input name="botaoTexto" value="<%= ep.botaoTexto %>" maxlength="40" /></label>
          <label>Link do botão<input name="botaoUrl" value="<%= ep.botaoUrl %>" /></label>
        </div>
        <div class="btn-row" style="flex-wrap:wrap">
          <button type="submit" formaction="/admin/email-campanha/previa" formtarget="_blank" class="btn-secondary">Ver como fica</button>
        </div>
        <div style="display:flex;gap:8px;align-items:flex-end;flex-wrap:wrap">
          <label style="flex:1 1 220px">Enviar um teste para<input type="email" name="emailTeste" placeholder="seu@email.com" /></label>
          <button type="submit" formaction="/api/admin/email-campanha/teste" class="btn-secondary" style="width:auto;margin:0">Enviar teste</button>
        </div>
        <button type="submit" onclick="return confirm('Enviar este e-mail para todos os <%= er.total %> contatos?')">Enviar para todos (<%= er.total %>)</button>
      </form>

      <form method="POST" action="/api/admin/email-campanha/config" class="form" style="margin-top:16px">
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
          <label>Intervalo entre e-mails (segundos)<input type="number" name="intervaloSeg" min="3" max="600" value="<%= er.config.intervaloSeg %>" /></label>
          <label>Limite de e-mails por dia<input type="number" name="limiteDiario" min="1" max="5000" value="<%= er.config.limiteDiario %>" /></label>
        </div>
        <p class="hint" style="margin:0">Gmail comum: até ~500 por dia. Google Workspace: até ~2.000.</p>
        <button type="submit" class="btn-secondary">Salvar ajustes do e-mail</button>
      </form>
    </main>

    <main class="card" id="protecao">
      <% const w = waResumo, c = w.cfg; %>
      <h3 style="margin-top:0">Proteção do WhatsApp (envios em massa)</h3>
      <p class="hint" style="margin-top:0">Lembretes e campanhas não saem todos de uma vez: entram numa fila que manda <strong>uma mensagem a cada <%= Math.round(c.intervaloSeg / 60 * 10) / 10 %> min</strong> (com variação aleatória de ±<%= c.variacaoPct %>%), só das <%= c.janelaInicio %>h às <%= c.janelaFim %>h e até <%= c.limiteDiario %> por dia. Cada pessoa recebe uma <strong>versão diferente</strong> do texto (<%= c.versoes %> versões<%= c.iaAtiva ? ', criadas pela IA' : '' %>), nunca a mesma duas vezes seguidas, e quem respondeu SAIR não recebe. Quem não tem WhatsApp recebe o e-mail na hora.</p>

      <div class="stats-row">
        <div class="stat-box"><span class="stat-label">Na fila</span><span class="stat-value"><%= w.pendentes %></span></div>
        <div class="stat-box"><span class="stat-label">Enviados hoje</span><span class="stat-value"><%= w.enviadosHoje %> / <%= c.limiteDiario %></span></div>
        <div class="stat-box"><span class="stat-label">Situação</span><span class="stat-value" style="font-size:16px"><%= c.pausado ? 'Pausado' : (w.pendentes ? 'Enviando' : 'Livre') %></span></div>
        <div class="stat-box"><span class="stat-label">Fila termina em</span><span class="stat-value" style="font-size:16px"><%= !w.pendentes ? '—' : (w.dias > 1 ? w.dias + ' dias' : (w.duracaoMin >= 60 ? Math.round(w.duracaoMin / 6) / 10 + ' h' : w.duracaoMin + ' min')) %></span></div>
      </div>
      <% if (w.pendentes && !c.pausado && w.proximoEnvioEm) { %><p class="hint">Próximo envio: <%= fmtDisplay(w.proximoEnvioEm) %>.</p><% } %>
      <p class="hint">Com esse ritmo cabem cerca de <strong><%= w.porDia %> mensagens por dia</strong>. Para listas grandes o envio se estende por mais de um dia — por isso o lembrete de "1 hora antes" só chega a todos se a lista for pequena.</p>

      <div class="btn-row" style="flex-wrap:wrap">
        <% if (c.pausado) { %>
          <form action="/api/admin/whatsapp-envio/retomar" method="POST" style="flex:1"><button type="submit">Retomar envios</button></form>
        <% } else { %>
          <form action="/api/admin/whatsapp-envio/pausar" method="POST" style="flex:1"><button type="submit" class="btn-secondary">Pausar envios</button></form>
        <% } %>
        <% if (w.falhas) { %><form action="/api/admin/whatsapp-envio/reenviar-falhas" method="POST" style="flex:1"><button type="submit" class="btn-secondary">Reenviar <%= w.falhas %> falha(s)</button></form><% } %>
        <% if (w.pendentes) { %><form action="/api/admin/whatsapp-envio/cancelar" method="POST" style="flex:1" onsubmit="return confirm('Cancelar todas as mensagens que ainda estão na fila?')"><button type="submit" class="btn-danger">Cancelar fila</button></form><% } %>
      </div>

      <% if (w.lotes.length) { %>
        <div class="table-wrap" style="margin-top:16px"><table>
          <thead><tr><th>Envio</th><th>Criado</th><th>Enviados</th><th>Na fila</th><th>Falhas</th></tr></thead>
          <tbody>
            <% w.lotes.forEach(function(l) { %>
              <tr title="<%= l.versoes.join('\n\n---\n\n') %>"><td><%= l.titulo %> <span class="hint">(<%= l.versoes.length %> versões)</span></td><td><%= fmtDisplay(l.criadoEm) %></td><td><%= l.enviados %></td><td><%= l.pendentes %></td><td><%= l.falhas %></td></tr>
            <% }) %>
          </tbody>
        </table></div>
      <% } %>

      <form action="/api/admin/whatsapp-envio/config" method="POST" class="form" style="margin-top:20px">
        <h3 style="margin:0">Ajustes</h3>
        <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));gap:12px">
          <label>Intervalo entre mensagens (segundos)<input type="number" name="intervaloSeg" min="30" max="3600" value="<%= c.intervaloSeg %>" /></label>
          <label>Variação aleatória do intervalo (%)<input type="number" name="variacaoPct" min="0" max="60" value="<%= c.variacaoPct %>" /></label>
          <label>Enviar a partir de (hora)<input type="number" name="janelaInicio" min="0" max="23" value="<%= c.janelaInicio %>" /></label>
          <label>Enviar até (hora)<input type="number" name="janelaFim" min="0" max="24" value="<%= c.janelaFim %>" /></label>
          <label>Limite de mensagens por dia<input type="number" name="limiteDiario" min="1" max="2000" value="<%= c.limiteDiario %>" /></label>
          <label>Versões diferentes de cada mensagem<input type="number" name="versoes" min="1" max="10" value="<%= c.versoes %>" /></label>
        </div>
        <label class="radio-row"><input type="checkbox" name="iaAtiva" <%= c.iaAtiva ? 'checked' : '' %> /> Criar as versões com IA (se a IA falhar, o texto é reescrito automaticamente)</label>
        <p class="hint" style="margin:0">Recomendado: no mínimo 120 s, até 150 por dia e 5 versões. Diminuir o intervalo ou aumentar o limite aumenta o risco de bloqueio.</p>
        <button type="submit">Salvar ajustes</button>
      </form>
    </main>

    <main class="card">
      <h3>Campanhas agendadas</h3>
      <p class="hint" style="margin-top:0">Crie uma mensagem avulsa (WhatsApp + e-mail) com data/hora livre para disparar para o público escolhido. Use {{nome}} na mensagem (e {{link}} se escolher o público de música). O envio pelo WhatsApp segue a Proteção do WhatsApp acima: versões diferentes são criadas automaticamente (ou escreva as suas separadas por <code>|||</code>, ou use o botão Gerar versões). Útil para datas comemorativas (Dia dos Namorados, Natal, etc.) incentivando quem já comprou uma música a criar outra.</p>

      <form action="/api/admin/campanhas" method="POST" class="form">
        <label>
          Mensagem
          <textarea name="mensagem" rows="3" required></textarea>
        </label>
        <div class="template-box" id="publico-box" style="margin:0">
          <strong>Quem recebe</strong>
          <p class="hint" style="margin:4px 0 8px">De onde vieram:</p>
          <% Object.entries(publicoInfo.fontes).forEach(function([k, l]) { %>
            <label class="radio-row" style="padding:4px 0"><input type="checkbox" name="fontes" value="<%= k %>" <%= ['pagos', 'gratuitos', 'participantes'].includes(k) ? 'checked' : '' %> /> <%= l %></label>
          <% }) %>
          <p class="hint" style="margin:12px 0 8px">De quais eventos (vale para ingresso, cortesia, acompanhante e compra não paga). Nenhum marcado = todos os eventos.</p>
          <% publicoInfo.eventos.forEach(function(ev) { %>
            <label class="radio-row" style="padding:4px 0"><input type="checkbox" name="eventos" value="<%= ev.id %>" /> <%= ev.name %> <span class="hint">(<%= ev.dateLabel %> · <%= ev.pedidos %> pedidos)</span></label>
          <% }) %>
          <p class="hint" style="margin:12px 0 8px">Não enviar para quem já tem ingresso de:</p>
          <% publicoInfo.eventos.forEach(function(ev) { %>
            <label class="radio-row" style="padding:4px 0"><input type="checkbox" name="excluirEventos" value="<%= ev.id %>" <%= ev.atual ? 'checked' : '' %> /> <%= ev.name %></label>
          <% }) %>
          <div class="hint" id="publico-previa" style="margin-top:10px;color:var(--accent)">Calculando…</div>
        </div>
        <label>
          Enviar em (horario de Brasilia)
          <input type="datetime-local" name="sendAt" required />
        </label>
        <button type="submit">Agendar campanha</button>
      </form>

      <div class="table-wrap" style="margin-top:20px">
        <table>
          <thead>
            <tr><th>Mensagem</th><th>Público</th><th>Enviar em</th><th>Status</th><th></th></tr>
          </thead>
          <tbody>
            <% campaigns.forEach(function(c) { %>
              <tr>
                <td><%= c.mensagem %></td>
                <td style="white-space:normal;max-width:260px"><%= c.filtros ? publicoInfo.descrever(c.filtros) : (({ ingressos: 'Ingresso (evento atual)', musica: 'Música', todos: 'Todos (evento atual)' })[c.audiencia] || 'Ingresso') %></td>
                <td><%= c.sendAtLocal.replace('T', ' ') %></td>
                <td><%= c.sent ? 'Enviada' : 'Pendente' %></td>
                <td>
                  <% if (!c.sent) { %>
                    <form action="/api/admin/campanhas/<%= c.id %>/excluir" method="POST" onsubmit="return confirm('Cancelar esta campanha?')">
                      <button type="submit" class="btn-secondary" style="margin-top:0; width:auto; padding:6px 12px; font-size:12px">Cancelar</button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }) %>
            <% if (campaigns.length === 0) { %>
              <tr><td colspan="5" style="text-align:center">Nenhuma campanha agendada.</td></tr>
            <% } %>
          </tbody>
        </table>
      </div>
    </main>
  </div>
  <script>
    (function () {
      var box = document.getElementById('publico-box');
      if (!box) return;
      var out = document.getElementById('publico-previa'), t;
      function atualizar() {
        clearTimeout(t);
        t = setTimeout(async function () {
          var fd = new URLSearchParams();
          box.querySelectorAll('input:checked').forEach(function (i) { fd.append(i.name, i.value); });
          try {
            var r = await (await fetch('/api/admin/campanhas/previa', { method: 'POST', body: fd })).json();
            var dias = Math.ceil(r.comWhatsapp / <%= Math.max(1, waResumo.porDia) %>);
            out.textContent = r.total + ' pessoas: ' + r.comWhatsapp + ' com WhatsApp (levam cerca de ' + dias + ' dia(s) no ritmo da Proteção do WhatsApp) e ' + r.soEmail + ' só com e-mail (recebem na hora).' + (r.exemplo.length ? ' Ex.: ' + r.exemplo.join('; ') : '');
          } catch (e) { out.textContent = ''; }
        }, 300);
      }
      box.addEventListener('change', atualizar);
      atualizar();
    })();
    // "Gerar versões" next to each WhatsApp message box: the versions come back
    // separated by ||| so they can be reviewed and edited before saving.
    document.querySelectorAll('textarea[name="dias5"], textarea[name="dia1"], textarea[name="diaEvento"], textarea[name="hora1"], textarea[name="mensagem"]').forEach(function (ta) {
      var b = document.createElement('button');
      b.type = 'button';
      b.className = 'btn-secondary';
      b.style.cssText = 'width:auto;margin-top:6px;padding:6px 12px;font-size:12px';
      b.textContent = 'Gerar versões';
      b.addEventListener('click', async function () {
        b.disabled = true; b.textContent = 'Gerando…';
        try {
          var r = await fetch('/api/admin/mensagens/versoes', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mensagem: ta.value }) });
          var d = await r.json();
          if (!r.ok) throw new Error(d.error || 'Erro');
          ta.value = d.versoes.join('\n|||\n');
          ta.rows = Math.min(16, d.versoes.length * 3);
          b.textContent = d.versoes.length + ' versões — revise e salve';
        } catch (e) { b.textContent = e.message; }
        b.disabled = false;
      });
      ta.insertAdjacentElement('afterend', b);
    });
  </script>
</body>
</html>
