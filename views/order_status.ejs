<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Seu pedido - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1 class="sr-only"><%= eventInfo.name %></h1>
    </header>

    <main class="card" id="status-card" data-order-id="<%= order.id %>">
      <% if (order.status === 'paid') { %>
        <span class="lote-tag">Compra aprovada</span>
        <h2>Parabens! Seu ingresso esta garantido 🎉</h2>
        <p class="hint" style="margin-top:0">Tambem enviamos tudo no seu WhatsApp e no seu e-mail. Clique abaixo para ver seu ingresso:</p>
        <div class="form" style="margin-top:16px">
          <% tickets.forEach(function(t, i) { %>
            <a href="/ingresso/<%= t.code %>"><button type="button">Ver meu ingresso<%= tickets.length > 1 ? ' ' + (i + 1) : '' %></button></a>
          <% }) %>
        </div>
      <% } else if (order.status === 'rejected') { %>
        <h2>Pagamento nao aprovado</h2>
        <p class="hint">Nao conseguimos confirmar esse pagamento. Tente novamente com outro cartao ou meio de pagamento.</p>
        <a href="/"><button type="button">Tentar novamente</button></a>
      <% } else if (order.status === 'pending' && order.pixQrCodeBase64) { %>
        <h2>Pague com Pix para confirmar</h2>
        <p class="hint" style="margin-top:0">Escaneie o QR Code abaixo ou copie o codigo Pix e cole no app do seu banco.</p>
        <img class="qr" src="data:image/png;base64,<%= order.pixQrCodeBase64 %>" alt="QR Code Pix" />
        <label>
          Pix copia e cola
          <input type="text" id="pix-code" readonly value="<%= order.pixQrCode %>" onclick="this.select()" />
        </label>
        <button type="button" id="btn-copiar-pix">Copiar codigo</button>
        <p class="hint" style="display:flex; align-items:center; justify-content:center; gap:8px">
          <span class="spinner" style="margin:0; width:16px; height:16px"></span>
          Aguardando confirmacao do pagamento... esta pagina atualiza sozinha.
        </p>
      <% } else if (order.status === 'pending') { %>
        <h2>Aguardando confirmacao do pagamento...</h2>
        <p class="hint">Isso pode levar alguns segundos. Esta pagina atualiza sozinha.</p>
        <div class="spinner"></div>
      <% } else { %>
        <h2>Pedido: <%= order.status %></h2>
      <% } %>
    </main>
  </div>

  <% if (order.status === 'pending' && order.pixQrCodeBase64) { %>
  <script>
    document.getElementById('btn-copiar-pix').addEventListener('click', async () => {
      const input = document.getElementById('pix-code');
      const btn = document.getElementById('btn-copiar-pix');
      try {
        await navigator.clipboard.writeText(input.value);
      } catch (e) {
        input.select();
        document.execCommand('copy');
      }
      const original = btn.textContent;
      btn.textContent = 'Copiado!';
      setTimeout(() => { btn.textContent = original; }, 2000);
    });
  </script>
  <% } %>

  <% if (order.status === 'pending') { %>
  <script>
    const orderId = document.getElementById('status-card').dataset.orderId;
    async function poll() {
      try {
        const res = await fetch(`/api/pedido/${orderId}/status`);
        const data = await res.json();
        if (data.status !== 'pending') {
          window.location.reload();
          return;
        }
      } catch (e) {}
      setTimeout(poll, 3000);
    }
    setTimeout(poll, 3000);
  </script>
  <% } %>
</body>
</html>
