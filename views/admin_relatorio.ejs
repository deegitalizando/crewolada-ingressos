<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Relatório do evento - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
  <style>
    .viz {
      --surface: #1a1a19;
      --ink: #ffffff;
      --ink2: #c3c2b7;
      --muted: #898781;
      --grid: #2c2c2a;
      --axis: #383835;
      --s1: #3987e5;
      --s2: #d95926;
      --s3: #199e70;
      --s4: #c98500;
      --s5: #d55181;
      --neutral: #4a4945;
      --good: #0ca30c;
    }
    .viz .card { background: var(--surface); }
    .rep-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; align-items: flex-end; margin: 0 16px; }
    .rep-head h2 { margin: 0; font-size: 22px; }
    .rep-head p { margin: 4px 0 0; color: var(--ink2); font-size: 13px; }
    .rep-head button { width: auto; margin: 0; padding: 10px 16px; font-size: 13px; }

    .kpis { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin: 0 16px; }
    .kpi { background: var(--surface); border: 1px solid var(--card-border); border-radius: 14px; padding: 14px 16px; }
    .kpi .k-label { font-size: 12px; color: var(--ink2); }
    .kpi .k-value { font-size: 26px; font-weight: 800; color: var(--ink); margin: 4px 0 2px; line-height: 1.15; }
    .kpi .k-sub { font-size: 12px; color: var(--muted); }
    .kpi.hero { grid-column: 1 / -1; }
    .kpi.hero .k-value { font-size: 52px; }

    .sec-title { margin: 8px 16px 0; font-size: 15px; color: var(--accent); text-transform: uppercase; letter-spacing: 0.05em; }
    .chart-grid { display: grid; grid-template-columns: 1fr; gap: 16px; margin: 0 16px; }
    @media (min-width: 820px) { .chart-grid.two { grid-template-columns: 1fr 1fr; } }
    .chart-card { background: var(--surface); border: 1px solid var(--card-border); border-radius: 16px; padding: 16px; min-width: 0; }
    .chart-card h3 { margin: 0; font-size: 15px; color: var(--ink); }
    .chart-card .c-sub { margin: 2px 0 10px; font-size: 12px; color: var(--muted); }
    .chart-card svg { width: 100%; height: auto; display: block; overflow: visible; }
    .chart-card text { fill: var(--muted); font-size: 11px; font-family: inherit; }
    .chart-card text.v { fill: var(--ink); font-weight: 700; }
    .chart-card text.l { fill: var(--ink2); }
    .legend { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 0 0 8px; font-size: 12px; color: var(--ink2); }
    .legend i { display: inline-block; width: 10px; height: 10px; border-radius: 2px; margin-right: 6px; vertical-align: -1px; }
    .empty { color: var(--muted); font-size: 13px; padding: 24px 0; text-align: center; }
    details.tbl { margin-top: 10px; font-size: 12px; color: var(--ink2); }
    details.tbl summary { cursor: pointer; color: var(--muted); }
    details.tbl table { margin-top: 8px; }
    details.tbl th, details.tbl td { padding: 4px 8px; }

    .share { display: flex; height: 28px; border-radius: 6px; overflow: hidden; gap: 2px; margin: 6px 0 10px; }
    .share span { display: flex; align-items: center; justify-content: center; font-size: 12px; font-weight: 700; color: #fff; min-width: 0; }
    .meter-row { margin: 10px 0 14px; }
    .meter-row .m-top { display: flex; justify-content: space-between; font-size: 13px; color: var(--ink2); margin-bottom: 6px; }
    .meter-row .m-top strong { color: var(--ink); }
    .meter { height: 12px; border-radius: 6px; background: rgba(57, 135, 229, 0.22); overflow: hidden; }
    .meter b { display: block; height: 100%; background: var(--s1); border-radius: 6px; }

    .insights { margin: 0 16px; display: grid; gap: 12px; }
    .ins { background: var(--surface); border: 1px solid var(--card-border); border-left: 3px solid var(--accent); border-radius: 12px; padding: 12px 14px; }
    .ins.rec { border-left-color: var(--s3); }
    .ins h4 { margin: 0 0 4px; font-size: 14px; color: var(--ink); }
    .ins p { margin: 0; font-size: 13px; line-height: 1.55; color: var(--ink2); }

    .tip {
      position: fixed; z-index: 60; pointer-events: none; display: none;
      background: #0d0d0d; color: #fff; border: 1px solid rgba(255,255,255,0.14); border-radius: 8px;
      padding: 8px 10px; font-size: 12px; max-width: 220px; box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    }
    .tip .t-cat { color: #c3c2b7; margin-bottom: 4px; }
    .tip .t-row { display: flex; align-items: center; gap: 6px; }
    .tip .t-row i { display: inline-block; width: 10px; height: 0; border-top: 3px solid; border-radius: 2px; }
    .tip .t-row strong { color: #fff; font-size: 13px; }
    .tip .t-row span { color: #c3c2b7; }

    .foot-note { margin: 0 16px; color: var(--muted); font-size: 12px; line-height: 1.55; }

    @media print {
      body { background: #fff !important; color: #0b0b0b !important; }
      .no-print, .tabs-row, .logout-form, .lgpd-banner { display: none !important; }
      .viz {
        --surface: #fcfcfb; --ink: #0b0b0b; --ink2: #52514e; --muted: #6b6a66; --grid: #e1e0d9; --axis: #c3c2b7;
        --s1: #2a78d6; --s2: #eb6834; --s3: #1baf7a; --s4: #eda100; --s5: #e87ba4; --neutral: #c3c2b7;
      }
      .viz .card, .kpi, .chart-card, .ins { box-shadow: none; border-color: #d9d8d2; break-inside: avoid; }
      .page-wide { max-width: none; }
      details.tbl { display: none; }
      .hero h1, .sec-title { color: #0b0b0b; }
    }
  </style>
</head>
<body>
  <div class="page page-wide viz">
    <header class="hero hero-sm no-print">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row no-print">
      <a href="/admin" class="tab">Vendas</a>
      <a href="/admin/eventos" class="tab">Eventos</a>
      <a href="/admin/ingressos" class="tab">Ingressos</a>
      <a href="/admin/cortesias" class="tab">Cortesias</a>
      <a href="/admin/contatos" class="tab">Convites</a>
      <a href="/admin/links" class="tab">Links</a>
      <a href="/admin/mensagens" class="tab">E-mail e WhatsApp</a>
      <a href="/contabilidade" class="tab">Contabilidade</a>
      <a href="/admin/relatorio" class="tab active">Relatório</a>
      <a href="/admin/pesquisa" class="tab">Pesquisa</a>
      <a href="/downloads" class="tab">Músicas</a>
      <a href="/admin/criesuamusica" class="tab">Música IA</a>
    </nav>

    <div class="rep-head">
      <div>
        <h2>Relatório do evento</h2>
        <p><%= report.event.name %> &middot; <%= report.event.dateLabel %> &middot; <%= report.event.venue %></p>
        <p id="generated-at"></p>
      </div>
      <button type="button" class="btn-secondary no-print" onclick="window.print()">Imprimir / salvar PDF</button>
    </div>

    <%- include('partials/event_switcher') %>
    <% if (!report.hasData) { %>
      <main class="card">
        <p class="empty">Ainda não há vendas pagas para montar o relatório.</p>
      </main>
    <% } else { %>

    <section class="kpis">
      <% report.kpis.forEach(function(k, i) { %>
        <div class="kpi <%= i === 0 ? 'hero' : '' %>">
          <div class="k-label"><%= k.label %></div>
          <div class="k-value"><%= k.value %></div>
          <div class="k-sub"><%= k.sub %></div>
        </div>
      <% }) %>
    </section>

    <h3 class="sec-title">Vendas</h3>
    <section class="chart-grid">
      <div class="chart-card" id="c-diario"></div>
      <div class="chart-card" id="c-acumulado"></div>
    </section>

    <section class="chart-card" style="margin:0 16px">
      <h3>Desempenho por lote</h3>
      <p class="c-sub">Preço, ritmo de vendas e comparecimento de cada lote</p>
      <div class="table-wrap">
        <table>
          <thead>
            <tr><th>Lote</th><th>Preço</th><th>Vendidos</th><th>Período</th><th>Dias</th><th>Receita</th><th>Compareceram</th></tr>
          </thead>
          <tbody>
            <% report.lotes.forEach(function(l) { %>
              <tr>
                <td><%= l.name %><%= l.soldOut && !l.isTest ? ' · esgotado' : '' %></td>
                <td><%= l.priceLabel %></td>
                <td><%= l.sold %> / <%= l.capacity %></td>
                <td><%= l.periodLabel %></td>
                <td><%= l.daysToSell || '-' %></td>
                <td><%= l.revenueLabel %></td>
                <td><%= l.attendanceLabel %></td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    </section>

    <section class="chart-grid two">
      <div class="chart-card" id="c-lotes"></div>
      <div class="chart-card" id="c-pagamento"></div>
    </section>

    <h3 class="sec-title">Quando e quem comprou</h3>
    <section class="chart-grid two">
      <div class="chart-card" id="c-horaCompra"></div>
      <div class="chart-card" id="c-diaSemana"></div>
      <div class="chart-card" id="c-antecedencia"></div>
      <div class="chart-card" id="c-tamanhoPedido"></div>
    </section>
    <section class="chart-grid">
      <div class="chart-card" id="c-ddd"></div>
    </section>

    <h3 class="sec-title">Comparecimento</h3>
    <section class="chart-grid two">
      <div class="chart-card">
        <h3>Quem compareceu</h3>
        <p class="c-sub">Ingressos válidos usados na portaria</p>
        <% report.attendance.forEach(function(a) { %>
          <% const p = a.valid ? Math.round((a.used / a.valid) * 1000) / 10 : 0; %>
          <div class="meter-row">
            <div class="m-top"><span><%= a.name %></span><span><strong><%= a.used %></strong> de <%= a.valid %> &middot; <%= String(p).replace('.', ',') %>%</span></div>
            <div class="meter"><b style="width: <%= p %>%"></b></div>
          </div>
        <% }) %>
      </div>
      <div class="chart-card" id="c-comparecimentoLote"></div>
    </section>
    <section class="chart-grid">
      <div class="chart-card" id="c-chegada"></div>
    </section>

    <h3 class="sec-title">O que os dados mostram</h3>
    <section class="insights">
      <% report.findings.forEach(function(f) { %>
        <div class="ins"><h4><%= f.title %></h4><p><%= f.text %></p></div>
      <% }) %>
    </section>

    <h3 class="sec-title">Para os próximos eventos</h3>
    <section class="insights">
      <% report.recommendations.forEach(function(f) { %>
        <div class="ins rec"><h4><%= f.title %></h4><p><%= f.text %></p></div>
      <% }) %>
      <% if (report.recommendations.length === 0) { %>
        <div class="ins rec"><h4>Sem recomendações ainda</h4><p>Ainda não há dados suficientes para sugerir ajustes.</p></div>
      <% } %>
    </section>

    <p class="foot-note">
      Como ler: "vendidos" são ingressos de pedidos pagos e não cancelados, sem cortesias. "Compareceram" são os QR Codes validados na portaria.
      Dias e horários seguem o horário de Brasília. A receita líquida usa os dados sincronizados do Mercado Pago em Contabilidade; pedidos ainda não sincronizados entram pelo valor cheio.
      As sugestões são baseadas em um único evento e servem como ponto de partida, não como regra.
    </p>
    <% } %>
  </div>

  <div class="tip" id="tip"></div>

  <script>
    const REPORT = <%- JSON.stringify(report).replace(/</g, '\\u003c') %>;
    const NS = 'http://www.w3.org/2000/svg';
    const COLORS = ['var(--s1)', 'var(--s2)', 'var(--s3)', 'var(--s4)', 'var(--s5)'];
    const tip = document.getElementById('tip');

    const nf = new Intl.NumberFormat('pt-BR');
    function fmt(v, unit) {
      const n = Math.round(v * 10) / 10;
      return nf.format(n) + (unit === '%' ? '%' : '');
    }

    document.getElementById('generated-at').textContent =
      'Gerado em ' + new Date(REPORT.generatedAt).toLocaleString('pt-BR', { timeZone: 'America/Sao_Paulo' });

    function s(tag, attrs, text) {
      const e = document.createElementNS(NS, tag);
      Object.keys(attrs || {}).forEach((k) => e.setAttribute(k, attrs[k]));
      if (text != null) e.textContent = text;
      return e;
    }
    function h(tag, props, text) {
      const e = document.createElement(tag);
      Object.keys(props || {}).forEach((k) => { if (k === 'class') e.className = props[k]; else e.setAttribute(k, props[k]); });
      if (text != null) e.textContent = text;
      return e;
    }

    function niceMax(v) {
      if (v <= 0) return { max: 4, step: 1 };
      const target = v / 4;
      const pow = Math.pow(10, Math.floor(Math.log10(target)));
      const step = [1, 2, 2.5, 5, 10].map((m) => m * pow).find((x) => x >= target);
      return { max: step * 4, step };
    }

    function showTip(evt, cat, rows) {
      tip.replaceChildren();
      tip.appendChild(h('div', { class: 't-cat' }, cat));
      rows.forEach((r) => {
        const row = h('div', { class: 't-row' });
        const key = h('i');
        key.style.borderColor = r.color;
        row.appendChild(key);
        row.appendChild(h('strong', {}, r.value));
        row.appendChild(h('span', {}, r.name));
        tip.appendChild(row);
      });
      tip.style.display = 'block';
      const pad = 14;
      let x = evt.clientX + pad;
      let y = evt.clientY + pad;
      const w = tip.offsetWidth;
      if (x + w > window.innerWidth - 8) x = evt.clientX - w - pad;
      tip.style.left = Math.max(8, x) + 'px';
      tip.style.top = y + 'px';
    }
    function hideTip() { tip.style.display = 'none'; }

    function chartWidth(host) {
      return Math.max(280, Math.round(host.clientWidth - 32));
    }

    function cardShell(cfg, host) {
      host.replaceChildren();
      host.appendChild(h('h3', {}, cfg.title));
      host.appendChild(h('p', { class: 'c-sub' }, cfg.subtitle || ''));
    }

    function tableView(cfg, host) {
      const d = h('details', { class: 'tbl' });
      d.appendChild(h('summary', {}, 'Ver como tabela'));
      const t = h('table');
      const thead = h('thead');
      const hr = h('tr');
      hr.appendChild(h('th', {}, ''));
      cfg.series.forEach((x) => hr.appendChild(h('th', {}, x.name)));
      thead.appendChild(hr);
      t.appendChild(thead);
      const tb = h('tbody');
      cfg.categories.forEach((c, i) => {
        const tr = h('tr');
        tr.appendChild(h('td', {}, c));
        cfg.series.forEach((x) => tr.appendChild(h('td', {}, fmt(x.values[i], cfg.unit))));
        tb.appendChild(tr);
      });
      t.appendChild(tb);
      d.appendChild(t);
      host.appendChild(d);
    }

    function legend(cfg, host) {
      if (cfg.series.length < 2) return;
      const lg = h('div', { class: 'legend' });
      cfg.series.forEach((x, i) => {
        const item = h('span');
        const sw = h('i');
        sw.style.background = COLORS[i % COLORS.length];
        item.appendChild(sw);
        const total = x.values.reduce((a, b) => a + b, 0);
        item.appendChild(document.createTextNode(x.name + ' · ' + fmt(total, cfg.unit)));
        lg.appendChild(item);
      });
      host.appendChild(lg);
    }

    function roundedTopRect(x, y, w, hgt, r, fill) {
      const rr = Math.min(r, w / 2, hgt);
      const d = 'M' + x + ',' + (y + hgt) + 'V' + (y + rr) + 'Q' + x + ',' + y + ' ' + (x + rr) + ',' + y +
        'H' + (x + w - rr) + 'Q' + (x + w) + ',' + y + ' ' + (x + w) + ',' + (y + rr) + 'V' + (y + hgt) + 'Z';
      return s('path', { d: d, fill: fill });
    }

    function drawColumns(cfg, host) {
      cardShell(cfg, host);
      const n = cfg.categories.length;
      const totals = cfg.categories.map((_, i) => cfg.series.reduce((a, x) => a + (x.values[i] || 0), 0));
      if (n === 0 || Math.max.apply(null, totals) === 0) { host.appendChild(h('p', { class: 'empty' }, 'Sem dados ainda.')); return; }
      legend(cfg, host);

      const W = chartWidth(host), H = 240, m = { l: 40, r: 8, t: 16, b: 30 };
      const pw = W - m.l - m.r, ph = H - m.t - m.b;
      const nm = niceMax(Math.max.apply(null, totals));
      const y = (v) => m.t + ph - (v / nm.max) * ph;
      const band = pw / n;
      const bw = Math.max(3, Math.min(24, band - 2));
      const svg = s('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': cfg.title });

      for (let v = 0; v <= nm.max + 0.001; v += nm.step) {
        svg.appendChild(s('line', { x1: m.l, x2: W - m.r, y1: y(v), y2: y(v), stroke: v === 0 ? 'var(--axis)' : 'var(--grid)', 'stroke-width': 1 }));
        svg.appendChild(s('text', { x: m.l - 6, y: y(v) + 4, 'text-anchor': 'end' }, nf.format(Math.round(v * 10) / 10)));
      }

      const peak = totals.indexOf(Math.max.apply(null, totals));
      const labelEvery = Math.max(1, Math.ceil(n / Math.floor(pw / 44)));
      const markerIdx = cfg.marker ? cfg.categories.indexOf(cfg.marker) : -1;
      cfg.categories.forEach((c, i) => {
        const cx = m.l + band * i + band / 2;
        const x0 = cx - bw / 2;
        if (cfg.stacked) {
          let acc = 0;
          let lastNonZero = -1;
          cfg.series.forEach((x, si) => { if ((x.values[i] || 0) > 0) lastNonZero = si; });
          cfg.series.forEach((x, si) => {
            const v = x.values[i] || 0;
            if (!v) return;
            const yTop = y(acc + v);
            const yBot = y(acc);
            const gap = acc > 0 ? 2 : 0;
            const hgt = Math.max(1, yBot - yTop - gap);
            const fill = COLORS[si % COLORS.length];
            svg.appendChild(si === lastNonZero ? roundedTopRect(x0, yTop, bw, hgt, 4, fill) : s('rect', { x: x0, y: yTop, width: bw, height: hgt, fill: fill }));
            acc += v;
          });
        } else {
          const v = totals[i];
          if (v > 0) {
            const fill = cfg.emphasis ? (i === peak ? 'var(--s1)' : 'var(--neutral)') : 'var(--s1)';
            svg.appendChild(roundedTopRect(x0, y(v), bw, Math.max(1, y(0) - y(v)), 4, fill));
          }
        }
        if ((i % labelEvery === 0 && (markerIdx < 0 || i === markerIdx || Math.abs(i - markerIdx) * band >= 40)) || c === cfg.marker) {
          svg.appendChild(s('text', { x: cx, y: H - 10, 'text-anchor': 'middle', class: 'l' }, c));
        }
        if (cfg.marker && c === cfg.marker) {
          svg.appendChild(s('line', { x1: cx, x2: cx, y1: m.t - 6, y2: y(0), stroke: 'var(--ink2)', 'stroke-width': 1 }));
          svg.appendChild(s('text', { x: cx, y: m.t - 8, 'text-anchor': 'middle', class: 'l' }, 'Evento'));
        }
        const hit = s('rect', { x: m.l + band * i, y: m.t, width: band, height: ph, fill: 'transparent', tabindex: 0 });
        const rows = () => (cfg.stacked
          ? cfg.series.filter((x) => x.values[i] > 0).map((x) => ({ name: x.name, value: fmt(x.values[i], cfg.unit), color: COLORS[cfg.series.indexOf(x) % COLORS.length] })).concat(cfg.series.length > 1 ? [{ name: 'Total', value: fmt(totals[i], cfg.unit), color: 'var(--ink2)' }] : [])
          : [{ name: cfg.unit, value: fmt(totals[i], cfg.unit), color: 'var(--s1)' }]);
        hit.addEventListener('pointermove', (e) => showTip(e, c, rows()));
        hit.addEventListener('pointerleave', hideTip);
        hit.addEventListener('focus', () => { const r = hit.getBoundingClientRect(); showTip({ clientX: r.left + r.width / 2, clientY: r.top }, c, rows()); });
        hit.addEventListener('blur', hideTip);
        svg.appendChild(hit);
      });

      // Label only the peak, so the chart stays quiet.
      const px = m.l + band * peak + band / 2;
      svg.appendChild(s('text', { x: px, y: y(totals[peak]) - 5, 'text-anchor': 'middle', class: 'v' }, fmt(totals[peak], cfg.unit)));

      host.appendChild(svg);
      tableView(cfg, host);
    }

    function drawLine(cfg, host) {
      cardShell(cfg, host);
      const vals = cfg.series[0].values;
      const n = vals.length;
      if (n === 0 || Math.max.apply(null, vals) === 0) { host.appendChild(h('p', { class: 'empty' }, 'Sem dados ainda.')); return; }
      const W = chartWidth(host), H = 240, m = { l: 40, r: 56, t: 16, b: 30 };
      const pw = W - m.l - m.r, ph = H - m.t - m.b;
      const nm = niceMax(Math.max.apply(null, vals));
      const x = (i) => m.l + (n === 1 ? pw / 2 : (pw * i) / (n - 1));
      const y = (v) => m.t + ph - (v / nm.max) * ph;
      const svg = s('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': cfg.title });

      for (let v = 0; v <= nm.max + 0.001; v += nm.step) {
        svg.appendChild(s('line', { x1: m.l, x2: W - m.r, y1: y(v), y2: y(v), stroke: v === 0 ? 'var(--axis)' : 'var(--grid)', 'stroke-width': 1 }));
        svg.appendChild(s('text', { x: m.l - 6, y: y(v) + 4, 'text-anchor': 'end' }, nf.format(Math.round(v * 10) / 10)));
      }
      const labelEvery = Math.max(1, Math.ceil(n / Math.floor(pw / 52)));
      cfg.categories.forEach((c, i) => {
        if (i % labelEvery === 0 || i === n - 1) svg.appendChild(s('text', { x: x(i), y: H - 10, 'text-anchor': 'middle', class: 'l' }, c));
      });

      const pts = vals.map((v, i) => x(i) + ',' + y(v));
      svg.appendChild(s('polygon', { points: m.l + ',' + y(0) + ' ' + pts.join(' ') + ' ' + x(n - 1) + ',' + y(0), fill: 'var(--s1)', 'fill-opacity': 0.1 }));
      svg.appendChild(s('polyline', { points: pts.join(' '), fill: 'none', stroke: 'var(--s1)', 'stroke-width': 2, 'stroke-linejoin': 'round', 'stroke-linecap': 'round' }));

      const last = n - 1;
      svg.appendChild(s('circle', { cx: x(last), cy: y(vals[last]), r: 6, fill: 'var(--surface)' }));
      svg.appendChild(s('circle', { cx: x(last), cy: y(vals[last]), r: 4, fill: 'var(--s1)' }));
      svg.appendChild(s('text', { x: x(last) + 10, y: y(vals[last]) + 4, class: 'v' }, fmt(vals[last], cfg.unit)));

      const cross = s('line', { y1: m.t, y2: y(0), stroke: 'var(--ink2)', 'stroke-width': 1, visibility: 'hidden' });
      svg.appendChild(cross);
      const hit = s('rect', { x: m.l, y: m.t, width: pw, height: ph, fill: 'transparent' });
      hit.addEventListener('pointermove', (e) => {
        const r = svg.getBoundingClientRect();
        const px = ((e.clientX - r.left) / r.width) * W;
        const i = Math.max(0, Math.min(n - 1, Math.round(((px - m.l) / pw) * (n - 1))));
        cross.setAttribute('x1', x(i)); cross.setAttribute('x2', x(i)); cross.setAttribute('visibility', 'visible');
        showTip(e, cfg.categories[i], [{ name: cfg.series[0].name, value: fmt(vals[i], cfg.unit), color: 'var(--s1)' }]);
      });
      hit.addEventListener('pointerleave', () => { cross.setAttribute('visibility', 'hidden'); hideTip(); });
      svg.appendChild(hit);

      host.appendChild(svg);
      tableView(cfg, host);
    }

    function drawBars(cfg, host) {
      cardShell(cfg, host);
      const vals = cfg.series[0].values;
      const n = vals.length;
      if (n === 0 || Math.max.apply(null, vals) === 0) { host.appendChild(h('p', { class: 'empty' }, 'Sem dados ainda.')); return; }
      const rowH = 30, barH = 16;
      const W = chartWidth(host);
      const narrow = W < 460;
      const m = { l: narrow ? 88 : 118, r: cfg.track ? (narrow ? 96 : 110) : (narrow ? 84 : 90), t: 4, b: 4 };
      const maxLabel = narrow ? 12 : 18;
      const H = m.t + m.b + rowH * n;
      const pw = W - m.l - m.r;
      const top = cfg.track ? Math.max.apply(null, cfg.track.concat(vals)) : Math.max.apply(null, vals);
      const svg = s('svg', { viewBox: '0 0 ' + W + ' ' + H, role: 'img', 'aria-label': cfg.title });
      cfg.categories.forEach((c, i) => {
        const cy = m.t + rowH * i + rowH / 2;
        svg.appendChild(s('text', { x: m.l - 8, y: cy + 4, 'text-anchor': 'end', class: 'l' }, c.length > maxLabel ? c.slice(0, maxLabel - 1) + '…' : c));
        if (cfg.track) {
          svg.appendChild(s('rect', { x: m.l, y: cy - barH / 2, width: pw, height: barH, rx: 4, fill: 'var(--s1)', 'fill-opacity': 0.2 }));
        }
        // With a capacity track each bar fills its own lote (sold / capacity).
        const w = cfg.track ? Math.max(2, (vals[i] / Math.max(1, cfg.track[i])) * pw) : Math.max(2, (vals[i] / top) * pw);
        svg.appendChild(s('rect', { x: m.l, y: cy - barH / 2, width: w, height: barH, rx: 4, fill: 'var(--s1)' }));
        const valText = fmt(vals[i], cfg.unit) + (cfg.extra ? '  ' + cfg.extra[i] : '');
        const inside = cfg.track && w > pw - 4;
        svg.appendChild(s('text', inside ? { x: m.l + pw - 8, y: cy + 4, class: 'v', 'text-anchor': 'end', style: 'fill:#fff' } : { x: m.l + Math.min(w, pw) + 8, y: cy + 4, class: 'v' }, valText));
        const hit = s('rect', { x: 0, y: m.t + rowH * i, width: W, height: rowH, fill: 'transparent', tabindex: 0 });
        const rows = () => [{ name: cfg.series[0].name, value: fmt(vals[i], cfg.unit), color: 'var(--s1)' }].concat(cfg.extra ? [{ name: '', value: cfg.extra[i], color: 'var(--ink2)' }] : []);
        hit.addEventListener('pointermove', (e) => showTip(e, c, rows()));
        hit.addEventListener('pointerleave', hideTip);
        hit.addEventListener('focus', () => { const r = hit.getBoundingClientRect(); showTip({ clientX: r.left + 60, clientY: r.top }, c, rows()); });
        hit.addEventListener('blur', hideTip);
        svg.appendChild(hit);
      });
      host.appendChild(svg);
      tableView(cfg, host);
    }

    function drawShare(host) {
      host.replaceChildren();
      host.appendChild(h('h3', {}, 'Forma de pagamento'));
      host.appendChild(h('p', { class: 'c-sub' }, 'Parte de cada forma no total de ingressos pagos'));
      const total = REPORT.payment.reduce((a, p) => a + p.tickets, 0);
      if (!total) { host.appendChild(h('p', { class: 'empty' }, 'Sem dados ainda.')); return; }
      const bar = h('div', { class: 'share' });
      REPORT.payment.forEach((p, i) => {
        if (!p.tickets) return;
        const pc = (p.tickets / total) * 100;
        const seg = h('span', { title: p.name + ': ' + p.tickets }, pc >= 14 ? Math.round(pc) + '%' : '');
        seg.style.width = pc + '%';
        seg.style.background = COLORS[i];
        bar.appendChild(seg);
      });
      host.appendChild(bar);
      const lg = h('div', { class: 'legend' });
      REPORT.payment.forEach((p, i) => {
        const item = h('span');
        const sw = h('i'); sw.style.background = COLORS[i];
        item.appendChild(sw);
        item.appendChild(document.createTextNode(p.name + ' · ' + nf.format(p.tickets) + ' ingressos · R$ ' + nf.format(p.gross)));
        lg.appendChild(item);
      });
      host.appendChild(lg);
    }

    if (REPORT.hasData) {
      const C = REPORT.charts;
      C.lotes.track = REPORT.lotes.filter((l) => !l.isTest).map((l) => l.capacity);
      const draw = { columns: drawColumns, line: drawLine, bars: drawBars };
      function drawAll() {
        Object.keys(C).forEach((k) => {
          const host = document.getElementById('c-' + k);
          if (host) draw[C[k].type](C[k], host);
        });
        const pay = document.getElementById('c-pagamento');
        if (pay) drawShare(pay);
      }
      drawAll();
      let lastW = window.innerWidth;
      let timer = null;
      window.addEventListener('resize', () => {
        if (window.innerWidth === lastW) return;
        lastW = window.innerWidth;
        clearTimeout(timer);
        timer = setTimeout(drawAll, 150);
      });
    }
  </script>
</body>
</html>
