<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Meus ingressos - Crewolada</title>
  <%- include('partials/head') %>
  <style>
    .mi-ev { margin-top: 18px; padding-top: 16px; border-top: 1px solid rgba(255, 255, 255, 0.1); }
    .mi-ev h3 { margin: 0; font-size: 18px; }
    .mi-ev .when { margin: 2px 0 0; color: var(--text-dim); font-size: 14px; }
    .mi-tag { display: inline-block; margin-left: 6px; padding: 2px 8px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.04em; text-transform: uppercase; vertical-align: middle; background: rgba(255, 255, 255, 0.1); color: var(--text-dim); }
    .mi-tag.next { background: rgba(255, 210, 30, 0.18); color: var(--accent); }
    .mi-order { margin-top: 12px; padding: 12px 14px; border-radius: 12px; background: rgba(255, 255, 255, 0.05); }
    .mi-order .meta { margin: 0; font-size: 13px; color: var(--text-dim); }
    .mi-t { display: flex; align-items: center; justify-content: space-between; gap: 10px; padding: 10px 0; border-top: 1px solid rgba(255, 255, 255, 0.08); }
    .mi-t:first-of-type { border-top: 0; }
    .mi-t b { display: block; font-size: 14px; }
    .mi-t small { display: block; color: var(--text-dim); font-size: 12px; }
    .mi-t .acts { display: flex; gap: 6px; flex: none; }
    .mi-t .acts a { font-size: 13px; font-weight: 700; padding: 7px 12px; border-radius: 999px; border: 1px solid rgba(255, 255, 255, 0.2); text-decoration: none; color: inherit; }
    .mi-order .go { margin-top: 10px; }
    .mi-order .go button { margin: 0; }
    .mi-cancel { color: #fca5a5; font-weight: 700; font-size: 14px; }
  </style>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="Crewolada" />
      <h1 class="sr-only">Crewolada</h1>
    </header>

    <main class="card">
      <h2>Meus ingressos</h2>
      <p class="hint" style="margin-top:0">Digite o CPF, e-mail ou WhatsApp usado na compra ou na inscrição. Aparecem os ingressos de todos os eventos da Crewolada, e você pode cadastrar quem vai usar cada um.</p>

      <% if (error) { %>
        <div class="alert" style="background:rgba(239,68,68,0.15);border-color:#ef4444;color:#fca5a5"><%= error %></div>
      <% } %>

      <form action="/meus-ingressos" method="POST" class="form">
        <label>
          CPF, e-mail ou WhatsApp
          <input type="text" name="termo" placeholder="Digite aqui..." required value="<%= termo %>" />
        </label>
        <button type="submit">Buscar meus ingressos</button>
      </form>

      <% if (groups && groups.length) { %>
        <% groups.forEach(function(g, gi) { %>
          <section class="mi-ev">
            <h3><%= g.ev.name %><span class="mi-tag<%= g.past ? '' : ' next' %>"><%= g.past ? 'Já aconteceu' : 'Próximo' %></span></h3>
            <p class="when"><%= g.ev.dateLabel %><%= g.ev.timeLabel ? ' · ' + g.ev.timeLabel : '' %><%= g.ev.venue ? ' · ' + g.ev.venue : '' %></p>

            <% g.orders.forEach(function(o) { %>
              <div class="mi-order">
                <p class="meta"><%= o.loteName %> · <%= o.quantity %> ingresso<%= o.quantity === 1 ? '' : 's' %> · <%= o.isFree ? 'inscrição' : 'compra' %> em <%= o.createdAtLabel %></p>
                <% if (o.status === 'cancelled') { %>
                  <p class="mi-cancel">Cancelado · <a href="/comprovante/<%= o.id %>">ver comprovante do reembolso</a></p>
                <% } else { %>
                  <% o.tickets.forEach(function(t, i) { %>
                    <div class="mi-t">
                      <span><b><%= t.participantName || (i === 0 ? o.buyerName : 'Ingresso ' + (i + 1) + ' · sem nome cadastrado') %></b><small><%= t.code %><%= t.usedAt ? ' · já usado na entrada' : '' %></small></span>
                      <span class="acts"><a href="/ingresso/<%= t.code %>">Ver</a><a href="/ingresso/<%= t.code %>/pdf">PDF</a></span>
                    </div>
                  <% }) %>
                  <% if (!g.past) { %>
                    <a class="go" href="/pedido/<%= o.id %>/participantes"><button type="button" class="btn-secondary">Cadastrar quem vai usar <%= o.quantity === 1 ? 'o ingresso' : 'cada ingresso' %></button></a>
                  <% } %>
                <% } %>
              </div>
            <% }) %>
          </section>
        <% }) %>
      <% } %>
    </main>

    <%- include('partials/footer_legal') %>
  </div>
</body>
</html>
