<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Pesquisa do público - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
  <style>
    .survey h2 { margin: 0 0 6px; }
    .survey .intro { margin: 0 0 18px; color: var(--text-dim); font-size: 14px; line-height: 1.55; }
    .survey fieldset { border: 0; padding: 0; margin: 0; min-width: 0; }
    .survey legend { padding: 0; font-size: 14px; color: var(--text); font-weight: 700; margin-bottom: 8px; }
    .survey .opt { color: var(--text-dim); font-weight: 400; font-size: 12px; }
    .survey .form > label:not(.chip):not(.check) { display: block; }
    .survey .form > label:not(.chip):not(.check) > input,
    .survey .form > label:not(.chip):not(.check) > textarea { display: block; width: 100%; margin-top: 6px; }
    .survey .block { margin-bottom: 20px; }
    .survey .section-title { color: var(--accent); font-size: 13px; text-transform: uppercase; letter-spacing: 0.05em; margin: 26px 0 12px; padding-top: 16px; border-top: 1px solid var(--card-border); }
    .chips { display: flex; flex-wrap: wrap; gap: 8px; }
    .chip { position: relative; display: block; flex-direction: unset; }
    .chip input { position: absolute; opacity: 0; inset: 0; width: 100%; height: 100%; margin: 0; cursor: pointer; }
    .chip span {
      display: block; padding: 11px 14px; border-radius: 999px; font-size: 14px; color: var(--text);
      background: #1a1a1a; border: 1px solid rgba(255, 255, 255, 0.14);
    }
    .chip input:checked + span { background: var(--accent); color: #1a1200; border-color: var(--accent); font-weight: 700; }
    .chip input:focus-visible + span { outline: 2px solid var(--accent); outline-offset: 2px; }
    .nps .chip span { padding: 11px 0; width: 42px; text-align: center; border-radius: 10px; }
    .survey textarea {
      background: #1a1a1a; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 10px;
      padding: 12px 14px; color: var(--text); font-size: 16px; font-family: inherit; min-height: 84px;
    }
    .check { flex-direction: row; align-items: flex-start; gap: 10px; font-size: 13px; line-height: 1.5; color: var(--text-dim); }
    .check input { width: auto; padding: 0; margin-top: 3px; flex: none; }
    .hp { position: absolute; left: -9999px; top: -9999px; height: 0; overflow: hidden; }
    .hidden { display: none; }
  </style>
</head>
<body>
  <div class="page">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
    </header>

    <main class="card survey">
      <h2>Queremos conhecer você</h2>
      <p class="intro">Leva cerca de 1 minuto. Suas respostas ajudam a montar a próxima <%= eventInfo.name %> do jeito que a nossa comunidade merece.</p>

      <% if (errors && errors.length) { %>
        <div class="alert"><% errors.forEach(function(e) { %><div><%= e %></div><% }) %></div>
      <% } %>

      <%
        const val = function (k) { return v && v[k] !== undefined && v[k] !== null && v[k] !== false ? v[k] : ''; };
        const chip = function (name, option, required) {
          return '<label class="chip"><input type="radio" name="' + name + '" value="' + option.replace(/"/g, '&quot;') + '"' +
            (String(val(name)) === String(option) ? ' checked' : '') + (required ? ' required' : '') + ' /><span>' + option.replace(/&/g, '&amp;').replace(/</g, '&lt;') + '</span></label>';
        };
      %>

      <form action="/pesquisa" method="POST" class="form" id="survey-form" autocomplete="on">
        <input type="hidden" name="origem" value="<%= val('origem') %>" />
        <div class="hp" aria-hidden="true"><label>Não preencha este campo <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>

        <h3 class="section-title" style="margin-top:0;border-top:0;padding-top:0">Sobre você</h3>
        <label>
          Nome
          <input type="text" name="nome" required maxlength="80" autocomplete="name" value="<%= val('nome') %>" />
        </label>
        <label>
          WhatsApp (com DDD)
          <input type="tel" name="whatsapp" required inputmode="numeric" autocomplete="tel" placeholder="(21) 99999-9999" value="<%= val('whatsapp') %>" />
        </label>
        <label>
          E-mail <span class="opt">(opcional)</span>
          <input type="email" name="email" maxlength="120" autocomplete="email" value="<%= val('email') %>" />
        </label>

        <fieldset class="block">
          <legend>Faixa etária</legend>
          <div class="chips"><% opcoes.faixaEtaria.forEach(function(o, i) { %><%- chip('faixaEtaria', o, i === 0) %><% }) %></div>
        </fieldset>

        <fieldset class="block">
          <legend>Você é</legend>
          <div class="chips"><% opcoes.genero.forEach(function(o, i) { %><%- chip('genero', o, i === 0) %><% }) %></div>
        </fieldset>

        <h3 class="section-title">Fé</h3>
        <p class="intro" style="margin-top:-4px">Estas perguntas são opcionais de verdade: você pode marcar "Prefiro não responder".</p>

        <fieldset class="block">
          <legend>Você é cristão?</legend>
          <div class="chips"><% opcoes.cristao.forEach(function(o, i) { %><%- chip('cristao', o, i === 0) %><% }) %></div>
        </fieldset>

        <fieldset class="block">
          <legend>Frequenta alguma igreja?</legend>
          <div class="chips"><% opcoes.frequentaIgreja.forEach(function(o, i) { %><%- chip('frequentaIgreja', o, i === 0) %><% }) %></div>
        </fieldset>

        <label id="igreja-wrap" class="<%= val('frequentaIgreja') === 'Sim' ? '' : 'hidden' %>">
          Qual igreja? <span class="opt">(opcional)</span>
          <input type="text" name="igreja" maxlength="80" value="<%= val('igreja') %>" />
        </label>

        <h3 class="section-title">Onde você mora</h3>
        <label>
          Cidade
          <input type="text" name="cidade" required maxlength="60" list="cidades" autocomplete="address-level2" value="<%= val('cidade') %>" />
          <datalist id="cidades"><% cidades.forEach(function(c) { %><option value="<%= c %>"></option><% }) %></datalist>
        </label>
        <label>
          Bairro <span class="opt">(opcional)</span>
          <input type="text" name="bairro" maxlength="60" value="<%= val('bairro') %>" />
        </label>

        <h3 class="section-title">A festa</h3>
        <fieldset class="block">
          <legend>Você já conhece a <%= eventInfo.name %>?</legend>
          <div class="chips"><% opcoes.conheceFesta.forEach(function(o, i) { %><%- chip('conheceFesta', o, i === 0) %><% }) %></div>
        </fieldset>

        <fieldset class="block <%= val('conheceFesta') === 'Já participei' ? '' : 'hidden' %>" id="edicoes-wrap">
          <legend>Em quantas edições você já participou?</legend>
          <div class="chips"><% opcoes.edicoes.forEach(function(o) { %><%- chip('edicoes', o, false) %><% }) %></div>
        </fieldset>

        <fieldset class="block <%= val('conheceFesta') === 'Já participei' ? '' : 'hidden' %> nps" id="nps-wrap">
          <legend>De 0 a 10, o quanto você indicaria a festa para um amigo? <span class="opt">(opcional)</span></legend>
          <div class="chips">
            <% for (var n = 0; n <= 10; n++) { %><label class="chip"><input type="radio" name="nps" value="<%= n %>" <%= String(val('nps')) === String(n) && val('nps') !== '' ? 'checked' : '' %> /><span><%= n %></span></label><% } %>
          </div>
        </fieldset>

        <fieldset class="block">
          <legend>Como você conheceu a festa? <span class="opt">(opcional)</span></legend>
          <div class="chips"><% opcoes.comoConheceu.forEach(function(o) { %><%- chip('comoConheceu', o, false) %><% }) %></div>
        </fieldset>

        <label>
          O que você gostaria de ver nas próximas edições? <span class="opt">(opcional)</span>
          <textarea name="sugestao" maxlength="400" placeholder="Artistas, estilos, estrutura, horário..."><%= val('sugestao') %></textarea>
        </label>

        <label>
          Seu Instagram <span class="opt">(opcional)</span>
          <input type="text" name="instagram" maxlength="40" placeholder="@seuusuario" value="<%= val('instagram') %>" />
        </label>

        <h3 class="section-title">Autorização</h3>
        <label class="check">
          <input type="checkbox" name="consent" required <%= val('consent') ? 'checked' : '' %> />
          <span>
            Concordo que a organização da <%= eventInfo.name %> use as informações acima para conhecer o perfil do público e melhorar os próximos eventos.
            Sei que informações sobre religião são dados sensíveis, que responder é opcional e que posso pedir a exclusão dos meus dados a qualquer momento.
            Se tenho menos de 18 anos, estou preenchendo com a autorização do meu responsável.
            Veja a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a>.
          </span>
        </label>
        <label class="check">
          <input type="checkbox" name="aceitaNovidades" <%= val('aceitaNovidades') ? 'checked' : '' %> />
          <span>Quero receber novidades, avisos de ingressos e promoções da <%= eventInfo.name %> pelo WhatsApp e e-mail. <span class="opt">(opcional)</span></span>
        </label>

        <button type="submit">Enviar minhas respostas</button>
      </form>
    </main>

    <footer class="footer">
      <div class="footer-links">
        <a href="/politica-de-privacidade">Politica de Privacidade</a>
        <a href="/">Voltar para a página inicial</a>
      </div>
    </footer>
  </div>

  <script>
    (function () {
      var form = document.getElementById('survey-form');
      function toggle() {
        var igreja = form.querySelector('input[name="frequentaIgreja"]:checked');
        document.getElementById('igreja-wrap').classList.toggle('hidden', !(igreja && igreja.value === 'Sim'));
        var conhece = form.querySelector('input[name="conheceFesta"]:checked');
        var participou = conhece && conhece.value === 'Já participei';
        document.getElementById('edicoes-wrap').classList.toggle('hidden', !participou);
        document.getElementById('nps-wrap').classList.toggle('hidden', !participou);
        // A hidden required field would block submit, so only require it while visible.
        form.querySelectorAll('#edicoes-wrap input').forEach(function (i, idx) { i.required = participou && idx === 0; });
      }
      form.addEventListener('change', toggle);
      toggle();
    })();
  </script>
</body>
</html>
