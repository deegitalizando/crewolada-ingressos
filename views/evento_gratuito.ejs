<% const slugUp = ev.slug.toUpperCase(); %>
<% const maxPer = ev.maxPerCpf || 4; %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title><%= ev.name %> · <%= ev.dateLabel %> · Inscrição gratuita</title>
  <meta name="description" content="<%= ev.tagline %>. <%= ev.name %>, <%= ev.dateLabel %>, <%= ev.timeLabel %>, <%= ev.venue %>. Ingresso gratuito e limitado a <%= capacity %> vagas." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= ev.tagline %> · <%= ev.name %> · <%= ev.dateLabel %>" />
  <meta property="og:description" content="Ingresso gratuito e limitado a <%= capacity %> vagas. <%= ev.venue %>, <%= ev.timeLabel.toLowerCase() %>." />
  <meta property="og:image" content="<%= baseUrl %>/img/logo.jpg" />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#000000" />
  <%- include('partials/head') %>
  <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <style>
    :root { --accent: #E5A71B; }
    html { scroll-behavior: smooth; }
    body.sp {
      --bg: #000000; --ink: #F4F1E8; --muted: #9AA7BD; --line: rgba(255, 255, 255, 0.14); --yellow: #E5A71B; --ease: cubic-bezier(0.22, 1, 0.36, 1);
      margin: 0; min-height: 100vh; color: var(--ink); font-family: 'DM Sans', system-ui, sans-serif; font-size: 17px; line-height: 1.6;
      background: #000;
      overflow-x: hidden; -webkit-font-smoothing: antialiased;
    }
    .sp *, .sp *::before, .sp *::after { box-sizing: border-box; }
    .sp h1, .sp h2 { font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif; margin: 0; letter-spacing: -0.035em; line-height: 0.98; }
    .sp p { margin: 0; }
    .sp a { color: inherit; }
    .wrap { width: min(980px, 100% - 40px); margin-inline: auto; position: relative; z-index: 3; }

    /* ---------- night scene ---------- */
    .scene { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .beams {
      position: absolute; left: 50%; bottom: -55vmax; width: 150vmax; height: 150vmax; margin-left: -75vmax;
      background: repeating-conic-gradient(from 0deg at 50% 50%, rgba(229, 167, 27, 0.13) 0 5deg, transparent 5deg 22deg);
      -webkit-mask-image: radial-gradient(circle at 50% 50%, #000 0, transparent 55%); mask-image: radial-gradient(circle at 50% 50%, #000 0, transparent 55%);
      animation: spin 90s linear infinite;
    }
    @keyframes spin { to { transform: rotate(360deg); } }
    .glow { position: absolute; left: 50%; top: 8%; width: 60vmin; height: 60vmin; margin-left: -30vmin; border-radius: 50%;
      background: radial-gradient(circle, rgba(229, 167, 27, 0.22), transparent 65%); animation: pulse 6s ease-in-out infinite alternate; }
    @keyframes pulse { from { transform: scale(0.9); opacity: 0.7; } to { transform: scale(1.1); opacity: 1; } }
    .fl { position: absolute; left: var(--x); bottom: -10vh; width: var(--s); opacity: var(--o, 0.8); animation: rise var(--d) linear var(--delay) infinite; will-change: transform; }
    .fl svg { display: block; width: 100%; height: auto; animation: sway var(--sw, 4s) ease-in-out infinite alternate; }
    .fl.star svg { animation: twinkle var(--sw, 2.4s) ease-in-out infinite alternate; }
    @keyframes rise { from { transform: translate3d(0, 0, 0); } to { transform: translate3d(var(--dx, 0px), -115vh, 0); } }
    @keyframes sway { from { transform: rotate(-10deg) translateX(-10px); } to { transform: rotate(10deg) translateX(10px); } }
    @keyframes twinkle { from { transform: scale(0.5); opacity: 0.35; } to { transform: scale(1.15); opacity: 1; } }
    .layer { position: absolute; inset: 0; transition: transform 0.4s var(--ease); }

    /* ---------- header ---------- */
    .top .wrap { display: flex; align-items: center; justify-content: space-between; height: 72px; }
    .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; }
    .brand img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgba(229, 167, 27, 0.6); }
    .pill { font-size: 12px; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; padding: 8px 14px; border-radius: 4px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.06); backdrop-filter: blur(8px); }

    /* ---------- hero ---------- */
    .sp-hero { padding-block: 24px 40px; text-align: center; }
    .eyebrow { display: inline-flex; align-items: center; gap: 10px; font-size: 12px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--yellow); }
    .eyebrow::before, .eyebrow::after { content: ''; width: 28px; height: 1px; background: currentColor; opacity: 0.6; }
    .sp h1.big { font-size: clamp(2.9rem, 11vw, 6.5rem); font-weight: 800; margin: 20px 0 18px; color: var(--ink); }
    .sp h1.big .thin { display: block; font-weight: 200; font-style: italic; color: var(--yellow); }
    .lead { max-width: 34em; margin-inline: auto; color: #d6d9e6; font-size: clamp(1.0625rem, 2.4vw, 1.25rem); }

    .facts { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px; margin-top: 28px; }
    .fact { display: inline-flex; align-items: center; gap: 10px; padding: 10px 16px; border-radius: 4px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.05); font-size: 15px; backdrop-filter: blur(8px); }
    .fact svg { width: 20px; height: 20px; fill: none; stroke: var(--yellow); stroke-width: 1.6; stroke-linecap: round; stroke-linejoin: round; flex: none; }
    .fact b { font-weight: 700; }

    .urgent {
      display: inline-flex; align-items: center; gap: 10px; margin-top: 28px; padding: 12px 22px; border-radius: 4px; border: 2px solid #fff;
      background: linear-gradient(135deg, #FF3D2E 0%, #F6C441 100%); color: #fff; font-weight: 800; font-size: 13px; letter-spacing: 0.07em; text-transform: uppercase; max-width: 100%; white-space: nowrap;
      box-shadow: 0 18px 34px -12px rgba(255, 61, 46, 0.7); animation: urgent 2.2s ease-out infinite;
    }
    .urgent svg { width: 20px; height: 20px; fill: #F6C441; animation: flick 1.1s ease-in-out infinite alternate; transform-origin: 50% 90%; }
    @keyframes urgent { 0% { box-shadow: 0 18px 34px -12px rgba(255,61,46,.7), 0 0 0 0 rgba(255,98,40,.6); } 70%, 100% { box-shadow: 0 18px 34px -12px rgba(255,61,46,.7), 0 0 0 16px rgba(255,98,40,0); } }
    @keyframes flick { from { transform: scale(0.92) rotate(-4deg); } to { transform: scale(1.12) rotate(4deg); } }

    .meter { width: min(380px, 100%); margin: 18px auto 0; }
    .meter .row { display: flex; justify-content: space-between; font-size: 13px; color: var(--muted); margin-bottom: 8px; }
    .meter .row strong { color: var(--ink); }
    .bar { height: 6px; border-radius: 3px; background: rgba(255, 255, 255, 0.12); overflow: hidden; }
    .bar b { display: block; height: 100%; width: 0; background: linear-gradient(90deg, #E5A71B, #F6C441); border-radius: 3px; transition: width 1.4s var(--ease); }

    /* ---------- form ---------- */
    .card { width: min(520px, 100%); margin: 36px auto 0; padding: 28px; text-align: left; border-radius: 6px; border: 1px solid var(--line);
      background: linear-gradient(180deg, rgba(255, 255, 255, 0.09), rgba(255, 255, 255, 0.04)); backdrop-filter: blur(16px); box-shadow: 0 40px 90px -40px rgba(0, 0, 0, 0.8); }
    .card h2 { font-size: 1.75rem; margin-bottom: 4px; }
    .card .sub { color: var(--muted); font-size: 14px; margin-bottom: 18px; }
    .fr { display: grid; gap: 14px; }
    .fr label { display: block; font-size: 13px; font-weight: 700; color: #d6d9e6; }
    .fr input[type="text"], .fr input[type="tel"], .fr input[type="email"] {
      display: block; width: 100%; margin-top: 6px; padding: 15px 16px; border-radius: 6px; border: 1px solid var(--line); background: rgba(255, 255, 255, 0.07);
      color: #fff; font-size: 16px; font-family: inherit; transition: border-color 0.3s, background-color 0.3s;
    }
    .fr input:focus { outline: none; border-color: var(--yellow); background: rgba(255, 255, 255, 0.11); }
    .fr input::placeholder { color: rgba(255, 255, 255, 0.35); }
    .qty { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 6px; border: 1px solid var(--line); }
    .qty .lab { font-weight: 700; font-size: 15px; }
    .qty .lab small { display: block; font-weight: 400; color: var(--muted); font-size: 12px; }
    .stepper { display: flex; align-items: center; gap: 16px; }
    .stepper button { all: unset; box-sizing: border-box; cursor: pointer; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid var(--line); display: grid; place-items: center; font-size: 22px; transition: border-color 0.3s, transform 0.4s var(--ease); }
    .stepper button:hover { border-color: var(--yellow); transform: scale(1.08); }
    .stepper button[disabled] { opacity: 0.3; cursor: not-allowed; transform: none; }
    .stepper span { min-width: 26px; text-align: center; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 26px; }
    .fr .check { display: flex; flex-direction: row; gap: 12px; align-items: flex-start; font-weight: 400; font-size: 13px; color: var(--muted); line-height: 1.5; }
    .fr .check input { width: 20px; height: 20px; min-width: 20px; padding: 0; margin: 2px 0 0; flex: none; accent-color: var(--yellow); background: none; border: 0; }
    .fr .check a { color: var(--yellow); }
    .hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
    .alert-sp { border: 1px solid #fb7185; background: rgba(251, 113, 133, 0.12); color: #fecdd3; border-radius: 6px; padding: 12px 16px; font-size: 14px; margin-bottom: 14px; }

    .cta {
      all: unset; box-sizing: border-box; cursor: pointer; position: relative; overflow: hidden; display: flex; align-items: center; justify-content: center; gap: 14px; width: 100%;
      padding: 20px 24px; border-radius: 6px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 20px; letter-spacing: -0.01em; color: #000000; text-align: left;
      background: linear-gradient(180deg, #F6C441 0%, #E5A71B 52%, #D99716 100%); box-shadow: 0 24px 44px -16px rgba(0, 0, 0, 0.7);
      transition: transform 0.18s var(--ease), box-shadow 0.18s var(--ease); animation: glowbtn 2.4s ease-in-out infinite; -webkit-tap-highlight-color: transparent; user-select: none;
    }
    @keyframes glowbtn { 0%, 100% { box-shadow: 0 24px 44px -16px rgba(0,0,0,.7), 0 0 0 0 rgba(255,210,30,.6); } 60% { box-shadow: 0 24px 44px -16px rgba(0,0,0,.7), 0 0 0 16px rgba(255,210,30,0); } }
    .cta::before { content: ''; position: absolute; top: 0; bottom: 0; left: -40%; width: 30%; transform: skewX(-20deg); pointer-events: none; background: linear-gradient(90deg, transparent, rgba(255,255,255,.75), transparent); animation: sweep 3.4s ease-in-out infinite; }
    @keyframes sweep { 0%, 50% { left: -40%; } 100% { left: 140%; } }
    .cta:hover { transform: translateY(-3px); box-shadow: 0 30px 54px -16px rgba(0, 0, 0, 0.75); }
    .cta:active { transform: translateY(5px); box-shadow: 0 8px 18px -8px rgba(0, 0, 0, 0.6); animation: none; }
    .cta .lbl { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; gap: 2px; }
    .cta .lbl small { font-family: 'DM Sans', sans-serif; font-size: 14px; font-weight: 700; opacity: 0.75; }
    .cta .go { position: relative; z-index: 1; flex: none; width: 40px; height: 40px; border-radius: 50%; background: #000000; color: var(--yellow); display: grid; place-items: center; }
    .cta .go svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; animation: nudge 1.4s ease-in-out infinite; }
    @keyframes nudge { 0%, 100% { transform: translateX(-2px); } 50% { transform: translateX(3px); } }
    .cta.loading { pointer-events: none; animation: none; filter: saturate(0.8); }
    .cta.loading .go { animation: spinr 0.8s linear infinite; }
    @keyframes spinr { to { transform: rotate(360deg); } }
    .ripple { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.7); transform: scale(0); animation: rip 0.65s ease-out forwards; pointer-events: none; }
    @keyframes rip { to { transform: scale(1); opacity: 0; } }
    .confetti-bit { position: fixed; z-index: 90; width: 9px; height: 14px; border-radius: 2px; pointer-events: none; animation: conf 0.9s ease-out forwards; }
    @keyframes conf { to { transform: translate(var(--cx), var(--cy)) rotate(var(--cr)); opacity: 0; } }
    .fine { text-align: center; font-size: 13px; color: var(--muted); margin-top: 28px; }

    .closed { text-align: center; padding: 8px 0 4px; }
    .closed h2 { font-size: 2rem; }
    .closed p { color: #d6d9e6; margin-top: 10px; }
    .btn-line { display: inline-flex; align-items: center; justify-content: center; margin-top: 20px; padding: 16px 28px; border-radius: 4px; border: 1.5px solid var(--ink); text-decoration: none; font-weight: 700; transition: background-color 0.3s, color 0.3s, transform 0.4s var(--ease); }
    .btn-line:hover { background: var(--ink); color: var(--bg); transform: translateY(-2px); }

    .more { text-align: center; padding-block: 56px 24px; }
    .more h2 { font-size: clamp(1.5rem, 4vw, 2.25rem); }
    .more p { color: var(--muted); max-width: 30em; margin: 10px auto 0; }
    .foot { padding-block: 28px 56px; }
    .foot .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; font-size: 14px; color: var(--muted); }
    .foot .links a { text-decoration: none; transition: color 0.3s; }
    .foot .links a:hover { color: var(--ink); }
    .foot .small { text-align: center; font-size: 12px; color: rgba(154, 167, 189, 0.7); margin-top: 14px; }

    @media (min-width: 900px) { .card { padding: 36px; } }
    @media (max-width: 480px) { .eyebrow::before, .eyebrow::after { display: none; } .eyebrow { font-size: 11.5px; letter-spacing: 0.12em; } }
    @media (prefers-reduced-motion: reduce) {
      .beams, .glow, .fl, .fl svg, .urgent, .urgent svg, .cta, .cta::before, .cta .go svg { animation: none !important; }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body class="sp">
  <div class="scene" aria-hidden="true">
    <div class="beams"></div>
    <div class="glow"></div>
    <div class="layer" id="layer"></div>
  </div>

  <header class="top">
    <div class="wrap">
      <a class="brand" href="/<%= ev.slug %>"><img src="/img/logo.jpg" alt="" width="40" height="40" /> Crewolada</a>
      <span class="pill">Inscrição gratuita</span>
    </div>
  </header>

  <main>
    <section class="sp-hero">
      <div class="wrap">
        <p class="eyebrow"><%= ev.note %> · <%= weekday.replace('-feira', '') %>, <%= ev.dateLabel.slice(0, 5) %></p>
        <h1 class="big">Pela <span class="thin">1ª vez</span> em São Paulo</h1>
        <p class="lead">A festa de Black Music Cristã que une música, comunhão e comunidade chega a Osasco. Uma noite para viver junto, com entrada gratuita.</p>

        <div class="facts">
          <span class="fact"><svg viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg><b><%= ev.dateLabel.slice(0, 5) %></b> · <%= ev.timeLabel.toLowerCase() %></span>
          <span class="fact"><svg viewBox="0 0 24 24"><path d="M20 10c0 6-8 12-8 12S4 16 4 10a8 8 0 0116 0z"/><circle cx="12" cy="10" r="3"/></svg><b>Igreja Somos Betel</b> · Osasco/SP</span>
        </div>

        <% if (!closed && left > 0) { %>
          <span class="urgent"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>Gratuito e limitado · <%= capacity %> vagas</span>
          <div class="meter">
            <div class="row"><span><strong><%= left %></strong> de <%= capacity %> vagas disponíveis</span><span id="days-left"></span></div>
            <div class="bar" aria-hidden="true"><b data-pct="<%= capacity ? Math.min(100, Math.round((sold / capacity) * 100)) : 0 %>"></b></div>
          </div>
        <% } %>

        <div class="card" id="inscricao">
          <% if (closed) { %>
            <div class="closed">
              <h2>Inscrições encerradas</h2>
              <p>Este evento já aconteceu. Entre na comunidade para saber dos próximos.</p>
              <a class="btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
            </div>
          <% } else if (left <= 0) { %>
            <div class="closed">
              <h2>Vagas esgotadas</h2>
              <p>Os <%= capacity %> ingressos gratuitos acabaram. Entre na comunidade e fique por dentro dos próximos eventos em primeira mão.</p>
              <a class="btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
            </div>
          <% } else { %>
            <h2>Garanta sua vaga</h2>
            <p class="sub">Preencha para receber seu ingresso com QR Code por e-mail. É grátis.</p>

            <% if (error) { %><div class="alert-sp" role="alert"><%= error %></div><% } %>

            <form class="fr" action="/<%= ev.slug %>/inscricao" method="POST" id="form" novalidate>
              <div class="hp" aria-hidden="true"><label>Não preencha <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label>Nome completo
                <input type="text" name="nome" required maxlength="80" autocomplete="name" value="<%= values.nome || '' %>" />
              </label>
              <label>WhatsApp (com DDD)
                <input type="tel" name="whatsapp" required inputmode="numeric" autocomplete="tel" placeholder="(11) 99999-9999" value="<%= values.whatsapp || '' %>" />
              </label>
              <label>E-mail
                <input type="email" name="email" required maxlength="120" autocomplete="email" placeholder="para receber o ingresso" value="<%= values.email || '' %>" />
              </label>
              <label>CPF
                <input type="text" name="cpf" required inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" maxlength="14" value="<%= values.cpf || '' %>" />
              </label>

              <div class="qty">
                <span class="lab">Quantos ingressos?<small>Até <%= Math.min(maxPer, left) %> por CPF</small></span>
                <div class="stepper">
                  <button type="button" id="minus" aria-label="Menos um ingresso">−</button>
                  <span id="qval"><%= Math.min(Math.max(parseInt(values.quantidade, 10) || 1, 1), Math.min(maxPer, left)) %></span>
                  <button type="button" id="plus" aria-label="Mais um ingresso">+</button>
                </div>
              </div>
              <input type="hidden" name="quantidade" id="qin" value="<%= Math.min(Math.max(parseInt(values.quantidade, 10) || 1, 1), Math.min(maxPer, left)) %>" />

              <label class="check">
                <input type="checkbox" name="consent" <%= values.consent ? 'checked' : '' %> />
                <span>Concordo em informar meus dados para receber o ingresso e avisos sobre este evento, conforme a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a>.</span>
              </label>

              <button type="submit" class="cta" id="go">
                <span class="lbl"><span id="cta-text">Garantir minha vaga</span><small id="cta-sub">Gratuito · 1 ingresso</small></span>
                <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </button>
            </form>
            <p class="fine">Cada ingresso é pessoal e vale para uma entrada. Se não puder ir, avise para liberar a vaga.</p>
          <% } %>
        </div>
      </div>
    </section>

    <section class="more">
      <div class="wrap">
        <h2>Fique por dentro</h2>
        <p>Entre na comunidade no WhatsApp e receba as novidades em primeira mão.</p>
        <a class="btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="links">
        <a href="/meus-ingressos">Meus ingressos</a>
        <a href="/politica-de-privacidade">Privacidade</a>
        <a href="/termos-de-uso">Termos</a>
      </div>
      <p class="small"><%= ev.name %> · <%= ev.venue %> · <%= ev.dateLabel %></p>
    </div>
  </footer>

  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      var fine = window.matchMedia('(hover: hover)').matches;
      function rnd(a, b) { return a + Math.random() * (b - a); }
      function pick(a) { return a[Math.floor(Math.random() * a.length)]; }

      // ----- rising notes and twinkling stars
      var SVG = {
        note: function (c) { return '<svg viewBox="0 0 24 24"><path d="M9 18V5l11-2v13" fill="none" stroke="' + c + '" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/><circle cx="6" cy="18" r="3" fill="' + c + '"/><circle cx="17" cy="16" r="3" fill="' + c + '"/></svg>'; },
        star: function (c) { return '<svg viewBox="0 0 24 24"><path d="M12 1l2.6 8.4L23 12l-8.4 2.6L12 23l-2.6-8.4L1 12l8.4-2.6z" fill="' + c + '"/></svg>'; }
      };
      var layer = document.getElementById('layer');
      if (layer && !reduce) {
        var small = window.matchMedia('(max-width: 560px)').matches;
        var n = small ? 12 : 22;
        for (var i = 0; i < n; i++) {
          var kind = i % 3 === 0 ? 'note' : 'star';
          var el = document.createElement('div');
          el.className = 'fl ' + kind;
          el.style.setProperty('--x', rnd(2, 97) + '%');
          el.style.setProperty('--s', (kind === 'note' ? rnd(20, 34) : rnd(8, 18)) + 'px');
          el.style.setProperty('--d', rnd(16, 36) + 's');
          el.style.setProperty('--delay', (-rnd(0, 36)) + 's');
          el.style.setProperty('--dx', rnd(-80, 80) + 'px');
          el.style.setProperty('--sw', rnd(1.8, 4.6) + 's');
          el.style.setProperty('--o', rnd(0.45, 0.95).toFixed(2));
          el.innerHTML = SVG[kind](pick(['#E5A71B', '#FFFFFF', '#F6C441']));
          layer.appendChild(el);
        }
        if (fine) {
          var ticking = false, px = 0, py = 0;
          window.addEventListener('pointermove', function (e) {
            px = (e.clientX / innerWidth - 0.5) * 2; py = (e.clientY / innerHeight - 0.5) * 2;
            if (!ticking) { ticking = true; requestAnimationFrame(function () { ticking = false; layer.style.transform = 'translate3d(' + (px * -16) + 'px,' + (py * -10) + 'px,0)'; }); }
          }, { passive: true });
        }
      }

      // ----- availability bar + days left
      var bar = document.querySelector('.bar b');
      if (bar) {
        if (reduce) bar.style.transition = 'none';
        var fill = function () { bar.style.width = bar.getAttribute('data-pct') + '%'; };
        setTimeout(fill, 300);
      }
      var dl = document.getElementById('days-left');
      var startAt = Date.parse('<%= ev.startAt || '' %>');
      if (dl && !Number.isNaN(startAt)) {
        var days = Math.ceil((startAt - Date.now()) / 86400000);
        dl.textContent = days > 1 ? 'faltam ' + days + ' dias' : days === 1 ? 'é amanhã' : 'é hoje';
      }

      // ----- form behaviour
      var form = document.getElementById('form');
      if (!form) return;
      var max = <%= Math.min(maxPer, left) %>;
      var qin = document.getElementById('qin');
      var qval = document.getElementById('qval');
      var minus = document.getElementById('minus');
      var plus = document.getElementById('plus');
      var sub = document.getElementById('cta-sub');
      function setQty(n) {
        n = Math.max(1, Math.min(max, n));
        qin.value = n; qval.textContent = n;
        sub.textContent = 'Gratuito · ' + n + (n === 1 ? ' ingresso' : ' ingressos');
        if (n <= 1) minus.setAttribute('disabled', ''); else minus.removeAttribute('disabled');
        if (n >= max) plus.setAttribute('disabled', ''); else plus.removeAttribute('disabled');
      }
      minus.addEventListener('click', function () { setQty(parseInt(qin.value, 10) - 1); });
      plus.addEventListener('click', function () { setQty(parseInt(qin.value, 10) + 1); });
      setQty(parseInt(qin.value, 10) || 1);

      var cpf = form.elements.cpf;
      cpf.addEventListener('input', function () {
        var d = cpf.value.replace(/\D/g, '').slice(0, 11);
        cpf.value = d.replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d{1,2})$/, '$1-$2');
      });
      var tel = form.elements.whatsapp;
      tel.addEventListener('input', function () {
        var d = tel.value.replace(/\D/g, '').slice(0, 11);
        tel.value = d.length > 6 ? '(' + d.slice(0, 2) + ') ' + d.slice(2, d.length > 10 ? 7 : 6) + '-' + d.slice(d.length > 10 ? 7 : 6)
          : d.length > 2 ? '(' + d.slice(0, 2) + ') ' + d.slice(2) : d;
      });

      var go = document.getElementById('go');
      function confetti(x, y) {
        if (reduce) return;
        var colors = ['#E5A71B', '#FFFFFF', '#F6C441', '#7C6CFF', '#F6C441'];
        for (var i = 0; i < 26; i++) {
          var c = document.createElement('span');
          c.className = 'confetti-bit';
          c.style.left = x + 'px'; c.style.top = y + 'px';
          c.style.background = colors[i % colors.length];
          c.style.setProperty('--cx', (Math.random() * 300 - 150) + 'px');
          c.style.setProperty('--cy', (Math.random() * -220 - 30) + 'px');
          c.style.setProperty('--cr', (Math.random() * 720 - 360) + 'deg');
          document.body.appendChild(c);
          setTimeout(function (el) { el.remove(); }, 1000, c);
        }
      }
      go.addEventListener('pointerdown', function (e) {
        if (reduce) return;
        var r = go.getBoundingClientRect();
        var size = Math.max(r.width, r.height) * 1.6;
        var rp = document.createElement('span');
        rp.className = 'ripple';
        rp.style.width = rp.style.height = size + 'px';
        rp.style.left = (e.clientX - r.left - size / 2) + 'px';
        rp.style.top = (e.clientY - r.top - size / 2) + 'px';
        go.appendChild(rp);
        setTimeout(function () { rp.remove(); }, 700);
        confetti(e.clientX, e.clientY);
      });

      form.addEventListener('submit', function (e) {
        var msg = null;
        if (form.elements.nome.value.trim().length < 2) msg = 'Informe seu nome completo.';
        else if (form.elements.whatsapp.value.replace(/\D/g, '').length < 10) msg = 'Informe seu WhatsApp com DDD.';
        else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.elements.email.value.trim())) msg = 'Informe um e-mail válido.';
        else if (cpf.value.replace(/\D/g, '').length !== 11) msg = 'Informe o CPF completo.';
        else if (!form.elements.consent.checked) msg = 'Marque a autorização para continuar.';
        if (msg) {
          e.preventDefault();
          var box = document.querySelector('.alert-sp') || document.createElement('div');
          box.className = 'alert-sp'; box.setAttribute('role', 'alert'); box.textContent = msg;
          form.parentNode.insertBefore(box, form);
          box.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
          return;
        }
        go.classList.add('loading');
        document.getElementById('cta-text').textContent = 'Enviando...';
      });
    })();
  </script>
</body>
</html>
