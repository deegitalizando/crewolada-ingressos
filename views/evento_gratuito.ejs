<% const slugUp = ev.slug.toUpperCase(); %>
<% const maxPer = ev.maxPerCpf || 4; %>
<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title><%= ev.name %> · <%= ev.dateLabel %> · Inscrição gratuita</title>
  <meta name="description" content="<%= ev.tagline %>. <%= ev.name %>, <%= ev.dateLabel %>, <%= ev.timeLabel %>, <%= ev.venue %>. Ingresso gratuito e limitado a <%= capacity %> vagas." />
  <meta property="og:type" content="website" />
  <meta property="og:title" content="<%= ev.tagline %> · <%= ev.name %> · <%= ev.dateLabel %>" />
  <meta property="og:description" content="Ingresso gratuito e limitado a <%= capacity %> vagas. <%= ev.venue %>, <%= ev.timeLabel.toLowerCase() %>." />
  <meta property="og:image" content="<%= baseUrl %>/img/logo.jpg" />
  <meta name="twitter:card" content="summary" />
  <meta name="theme-color" content="#000000" />
  <%- include('partials/head') %>
  <link rel="preload" href="/fonts/bricolage-grotesque.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="stylesheet" href="/fonts/fonts.css" />
  <style>
    :root { --accent: #E5A71B; }
    html { scroll-behavior: smooth; }
    body.sp {
      --bg: #000000; --ink: #FFFFFF; --muted: #9a9a9a; --gold: #E5A71B; --gold-hi: #F6C441; --pink: #FF1F8E; --blue: #1E90FF;
      --line: rgba(229, 167, 27, 0.55); --ease: cubic-bezier(0.22, 1, 0.36, 1);
      margin: 0; min-height: 100vh; color: var(--ink); font-family: 'DM Sans', system-ui, sans-serif; font-size: 17px; line-height: 1.6;
      background: #000; overflow-x: hidden; -webkit-font-smoothing: antialiased;
    }
    .sp *, .sp *::before, .sp *::after { box-sizing: border-box; }
    .sp h1, .sp h2 { font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif; margin: 0; letter-spacing: -0.035em; line-height: 0.98; }
    .sp p { margin: 0; }
    .sp a { color: inherit; }
    .wrap { width: min(980px, 100% - 40px); margin-inline: auto; position: relative; z-index: 3; }

    /* ---------- backdrop: same equalizer as /links (icons come from crew-fx.js) ---------- */
    .scene { position: fixed; inset: 0; pointer-events: none; z-index: 0; overflow: hidden; }
    .eq { position: absolute; left: 0; right: 0; bottom: 0; height: 15vh; display: flex; align-items: flex-end; gap: 7px; padding-inline: 10px; opacity: 0.38; }
    .eq i { flex: 1; min-width: 4px; border-radius: 3px 3px 0 0; background: linear-gradient(180deg, var(--gold-hi), rgba(229, 167, 27, 0.25)); height: 8%; animation: bounce var(--d, 1s) ease-in-out var(--dl, 0s) infinite alternate; }
    .eq i:nth-child(7n+3) { background: linear-gradient(180deg, var(--pink), rgba(255, 31, 142, 0.2)); }
    .eq i:nth-child(7n+6) { background: linear-gradient(180deg, var(--blue), rgba(30, 144, 255, 0.2)); }
    @keyframes bounce { from { height: 6%; } to { height: var(--h, 70%); } }

    /* ---------- header ---------- */
    .top .wrap { display: flex; align-items: center; justify-content: space-between; gap: 12px; height: 72px; }
    .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 19px; letter-spacing: -0.02em; }
    .brand img { width: 40px; height: 40px; border-radius: 50%; object-fit: cover; box-shadow: 0 0 0 2px rgba(229, 167, 27, 0.6); }
    .top a.links { color: var(--muted); text-decoration: none; font-size: 15px; font-weight: 700; }
    .top a.links:hover { color: #fff; }

    /* ---------- hero ---------- */
    .sp-hero { padding-block: 24px 40px; text-align: center; }
    .kick { display: flex; align-items: center; justify-content: center; gap: 14px; font-size: 12px; letter-spacing: 0.32em; text-transform: uppercase; color: #fff; font-weight: 500; }
    .kick span { flex: none; width: 44px; height: 1.5px; background: var(--gold); }
    .sp h1.big { font-size: clamp(2.9rem, 11vw, 6.5rem); font-weight: 800; margin: 20px 0 18px; color: var(--ink); }
    .sp h1.big .thin { display: block; font-weight: 200; font-style: italic; color: var(--gold); }
    .sp .lead { max-width: 34em; margin-inline: auto; color: #e8e8e8; font-size: clamp(1.0625rem, 2.4vw, 1.25rem); }
    .sp .tagline { margin-top: 18px; font-size: 12px; letter-spacing: 0.34em; text-transform: uppercase; color: #e8e8e8; font-weight: 500; }
    .tagline b { color: var(--gold); padding: 0 0.35em; }

    .facts { width: min(520px, 100%); margin: 28px auto 0; display: grid; grid-template-columns: auto 1fr; text-align: left;
      border: 1.5px solid var(--line); border-radius: 4px; background: rgba(0, 0, 0, 0.78); backdrop-filter: blur(4px); }
    .fact { padding: 14px 18px; }
    .fact + .fact { border-left: 1.5px solid var(--line); }
    .fact .l { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
    .fact .v { display: block; margin-top: 2px; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 22px; letter-spacing: 0.02em; text-transform: uppercase; line-height: 1.15; }
    .fact .v i { font-style: normal; color: var(--gold); }
    .fact .v.sm { font-size: 16px; }
    .fact .hr { display: block; margin-top: 3px; font-size: 13px; color: #cfcfcf; }

    .urgent {
      display: inline-flex; align-items: center; gap: 10px; margin-top: 24px; padding: 10px 18px; border-radius: 2px;
      background: linear-gradient(180deg, var(--gold-hi), var(--gold)); color: #000; font-weight: 800; font-size: 12px; letter-spacing: 0.16em; text-transform: uppercase; max-width: 100%;
      animation: glow 2.4s ease-in-out infinite;
    }
    .urgent svg { width: 18px; height: 18px; fill: #000; animation: flick 1.1s ease-in-out infinite alternate; transform-origin: 50% 90%; }
    @keyframes glow { 0%, 100% { box-shadow: 0 0 0 0 rgba(229, 167, 27, 0.55); } 50% { box-shadow: 0 0 0 9px rgba(229, 167, 27, 0); } }
    @keyframes flick { from { transform: scale(0.92) rotate(-4deg); } to { transform: scale(1.12) rotate(4deg); } }

    .meter { width: min(520px, 100%); margin: 18px auto 0; }
    .meter .row { display: flex; justify-content: space-between; font-size: 11px; font-weight: 700; letter-spacing: 0.16em; text-transform: uppercase; color: var(--gold); margin-bottom: 8px; }
    .meter .row strong { color: var(--ink); }
    .bar { height: 4px; border-radius: 2px; background: rgba(255, 255, 255, 0.14); overflow: hidden; }
    .bar b { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--gold), var(--gold-hi)); box-shadow: 0 0 10px rgba(229, 167, 27, 0.7); transition: width 1.4s var(--ease); }

    /* ---------- form ---------- */
    .card { width: min(520px, 100%); margin: 32px auto 0; padding: 26px 22px; text-align: left; border-radius: 4px; border: 1.5px solid var(--line);
      background: rgba(0, 0, 0, 0.78); backdrop-filter: blur(6px); }
    .card h2 { font-size: 1.9rem; letter-spacing: 0.02em; text-transform: uppercase; margin-bottom: 6px; }
    .card h2 span { color: var(--gold); }
    .sp .card .sub { color: var(--muted); font-size: 14px; margin-bottom: 18px; }
    .fr { display: grid; gap: 14px; }
    .fr label { display: block; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: var(--gold); }
    .fr input[type="text"], .fr input[type="tel"], .fr input[type="email"] {
      display: block; width: 100%; margin-top: 6px; padding: 15px 16px; border-radius: 4px; border: 1.5px solid var(--line); background: #000;
      color: #fff; font-size: 16px; font-family: inherit; letter-spacing: normal; text-transform: none; transition: border-color 0.25s, box-shadow 0.25s;
    }
    .fr input:focus { outline: none; border-color: var(--gold-hi); box-shadow: 0 0 0 3px rgba(229, 167, 27, 0.18); }
    .fr input::placeholder { color: rgba(255, 255, 255, 0.35); }
    .qty { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 12px 16px; border-radius: 4px; border: 1.5px solid var(--line); }
    .qty .lab { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: 0.04em; text-transform: uppercase; line-height: 1.2; }
    .qty .lab small { display: block; margin-top: 2px; font-family: 'DM Sans', sans-serif; font-weight: 700; color: var(--gold); font-size: 11px; letter-spacing: 0.16em; }
    .stepper { display: flex; align-items: center; gap: 14px; }
    .stepper button { all: unset; box-sizing: border-box; cursor: pointer; width: 42px; height: 42px; border-radius: 50%; border: 1.5px solid var(--line); color: var(--gold-hi); display: grid; place-items: center; font-size: 22px; transition: border-color 0.3s, transform 0.4s var(--ease); }
    .stepper button:hover { border-color: var(--gold-hi); transform: scale(1.08); }
    .stepper button:focus-visible { outline: 2px solid #fff; outline-offset: 2px; }
    .stepper button[disabled] { opacity: 0.3; cursor: not-allowed; transform: none; }
    .stepper span { min-width: 26px; text-align: center; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 26px; }
    .fr .check { display: flex; flex-direction: row; gap: 12px; align-items: flex-start; font-weight: 400; font-size: 13px; letter-spacing: normal; text-transform: none; color: var(--muted); line-height: 1.5; }
    .fr .check input { width: 20px; height: 20px; min-width: 20px; padding: 0; margin: 2px 0 0; flex: none; accent-color: var(--gold); background: none; border: 0; }
    .fr .check a { color: var(--gold); }
    .hp { position: absolute; left: -9999px; height: 0; overflow: hidden; }
    .alert-sp { border: 1px solid #fb7185; background: rgba(251, 113, 133, 0.12); color: #fecdd3; border-radius: 4px; padding: 12px 16px; font-size: 14px; margin-bottom: 14px; }

    .cta {
      all: unset; box-sizing: border-box; cursor: pointer; position: relative; overflow: hidden; display: flex; align-items: center; gap: 14px; width: 100%; min-height: 76px;
      padding: 14px 18px; border-radius: 4px; border: 1.5px solid var(--gold-hi); color: #000; text-align: left;
      background: linear-gradient(180deg, var(--gold-hi), var(--gold)); transition: transform 0.18s var(--ease), border-color 0.25s;
      animation: glow 2.4s ease-in-out 1s infinite; -webkit-tap-highlight-color: transparent; user-select: none;
    }
    .cta::before { content: ''; position: absolute; top: 0; bottom: 0; width: 60px; left: -90px; pointer-events: none; background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent); transform: skewX(-20deg); animation: shine 3.4s ease-in-out 1.2s infinite; }
    @keyframes shine { 0% { left: -90px; } 40%, 100% { left: 120%; } }
    .cta:hover { transform: translateY(-3px); border-color: #fff; }
    .cta:active { transform: translateY(1px); }
    .cta:focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
    .cta .lbl { position: relative; z-index: 1; flex: 1; display: flex; flex-direction: column; gap: 1px; }
    .cta .lbl small { order: -1; font-family: 'DM Sans', sans-serif; font-size: 11px; font-weight: 700; letter-spacing: 0.2em; text-transform: uppercase; color: rgba(0, 0, 0, 0.7); }
    .cta .lbl > span { font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 21px; letter-spacing: 0.05em; text-transform: uppercase; line-height: 1.15; }
    .cta .go { position: relative; z-index: 1; flex: none; width: 40px; height: 40px; border-radius: 50%; background: #000; color: var(--gold-hi); display: grid; place-items: center; }
    .cta .go svg { width: 20px; height: 20px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; animation: nudge 1.4s ease-in-out infinite; }
    @keyframes nudge { 0%, 100% { transform: translateX(-2px); } 50% { transform: translateX(3px); } }
    .cta.loading { pointer-events: none; animation: none; filter: saturate(0.8); }
    .cta.loading .go { animation: spinr 0.8s linear infinite; }
    @keyframes spinr { to { transform: rotate(360deg); } }
    .ripple { position: absolute; border-radius: 50%; background: rgba(255, 255, 255, 0.7); transform: scale(0); animation: rip 0.65s ease-out forwards; pointer-events: none; }
    @keyframes rip { to { transform: scale(1); opacity: 0; } }
    .confetti-bit { position: fixed; z-index: 90; width: 9px; height: 14px; border-radius: 2px; pointer-events: none; animation: conf 0.9s ease-out forwards; }
    @keyframes conf { to { transform: translate(var(--cx), var(--cy)) rotate(var(--cr)); opacity: 0; } }
    .sp .fine { text-align: center; font-size: 13px; color: var(--muted); margin-top: 22px; }

    .closed { text-align: center; padding: 8px 0 4px; }
    .card.soldout { border-color: #D7141A; background: #D7141A; }
    .card.soldout .closed h2 { font-size: clamp(1.7rem, 6vw, 2.3rem); letter-spacing: 0.04em; text-transform: uppercase; }
    .sp .card.soldout .closed p { color: #fff; opacity: 0.92; }
    .card.soldout .btn-line { background: #fff; color: #D7141A; border-color: #fff; }
    .soldout-band { display: inline-block; margin-top: 24px; padding: 10px 22px; background: #D7141A; color: #fff; border: 2px solid #fff; border-radius: 2px;
      font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 15px; letter-spacing: 0.14em; text-transform: uppercase; transform: rotate(-2deg); }
    .closed h2 { font-size: 2rem; }
    .sp .closed p { color: #e8e8e8; margin-top: 10px; }
    .btn-line {
      display: inline-flex; align-items: center; justify-content: center; margin-top: 20px; padding: 16px 26px; border-radius: 4px; border: 1.5px solid var(--line); background: rgba(0, 0, 0, 0.78);
      text-decoration: none; font-family: 'Bricolage Grotesque', sans-serif; font-weight: 800; font-size: 16px; letter-spacing: 0.05em; text-transform: uppercase; transition: border-color 0.25s, transform 0.3s var(--ease), box-shadow 0.3s;
    }
    .btn-line:hover { border-color: var(--gold-hi); transform: translateY(-3px); box-shadow: 0 10px 30px -12px rgba(229, 167, 27, 0.55); }

    .more { text-align: center; padding-block: 56px 24px; }
    .more h2 { font-size: clamp(1.5rem, 4vw, 2.25rem); letter-spacing: 0.02em; text-transform: uppercase; }
    .more h2 span { color: var(--gold); }
    .sp .more p { color: var(--muted); max-width: 30em; margin: 10px auto 0; }
    .foot { padding-block: 28px 150px; }
    .foot .links { display: flex; flex-wrap: wrap; justify-content: center; gap: 8px 24px; font-size: 14px; color: var(--muted); }
    .foot .links a { text-decoration: none; transition: color 0.3s; }
    .foot .links a:hover { color: var(--ink); }
    .sp .foot .small { text-align: center; font-size: 12px; color: var(--muted); margin-top: 14px; }

    @media (min-width: 900px) { .card { padding: 34px; } }
    @media (max-width: 480px) { .kick { letter-spacing: 0.24em; font-size: 11px; } .kick span { width: 28px; } .fact { padding: 12px 14px; } .fact .v { font-size: 19px; } }
    @media (prefers-reduced-motion: reduce) {
      .eq i, .urgent, .urgent svg, .cta, .cta::before, .cta .go svg { animation: none !important; }
      html { scroll-behavior: auto; }
    }
  </style>
</head>
<body class="sp">
  <div class="scene" aria-hidden="true">
    <div class="eq" id="eq"></div>
  </div>

  <header class="top">
    <div class="wrap">
      <a class="brand" href="/<%= ev.slug %>"><img src="/img/logo.jpg" alt="" width="40" height="40" /> Crewolada</a>
      <a class="links" href="/links">&larr; Links</a>
    </div>
  </header>

  <main>
    <section class="sp-hero">
      <div class="wrap">
        <p class="kick"><span></span><%= ev.note %><span></span></p>
        <h1 class="big">Pela <span class="thin">1ª vez</span> em São Paulo</h1>
        <p class="lead">A festa de Black Music Cristã que une música, comunhão e comunidade chega a Osasco. Uma noite para viver junto, com entrada gratuita.</p>
        <p class="tagline">Música<b>•</b>Cultura<b>•</b>Fé<b>•</b>Propósito</p>

        <div class="facts">
          <span class="fact"><span class="l">Data</span><span class="v"><%= ev.dateLabel.slice(0, 2) %><i>/</i><%= ev.dateLabel.slice(3, 5) %></span><span class="hr"><%= weekday %> · <%= ev.timeLabel.toLowerCase() %></span></span>
          <span class="fact"><span class="l">Local</span><span class="v sm">Igreja Somos Betel</span><span class="hr">Osasco/SP</span></span>
        </div>

        <% if (!closed && left <= 0) { %><span class="soldout-band">Ingressos esgotados</span><% } %>
        <% if (!closed && left > 0) { %>
          <span class="urgent"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/></svg>Gratuito e limitado · <%= capacity %> vagas</span>
          <div class="meter">
            <div class="row"><span><strong><%= left %></strong> de <%= capacity %> vagas disponíveis</span><span id="days-left"></span></div>
            <div class="bar" aria-hidden="true"><b data-pct="<%= capacity ? Math.min(100, Math.round((sold / capacity) * 100)) : 0 %>"></b></div>
          </div>
        <% } %>

        <div class="card<%= !closed && left <= 0 ? ' soldout' : '' %>" id="inscricao">
          <% if (closed) { %>
            <div class="closed">
              <h2>Inscrições encerradas</h2>
              <p>Este evento já aconteceu. Entre na comunidade para saber dos próximos.</p>
              <a class="btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
            </div>
          <% } else if (left <= 0) { %>
            <div class="closed">
              <h2>Ingressos esgotados</h2>
              <p>Os <%= capacity %> ingressos gratuitos acabaram. Entre na comunidade e fique por dentro dos próximos eventos em primeira mão.</p>
              <a class="btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
            </div>
          <% } else { %>
            <h2>Garanta sua <span>vaga</span></h2>
            <p class="sub">Preencha para receber seu ingresso com QR Code por e-mail. É grátis.</p>

            <% if (error) { %><div class="alert-sp" role="alert"><%= error %></div><% } %>

            <form class="fr" action="/<%= ev.slug %>/inscricao" method="POST" id="form" novalidate>
              <div class="hp" aria-hidden="true"><label>Não preencha <input type="text" name="website" tabindex="-1" autocomplete="off" /></label></div>
              <label>Nome completo
                <input type="text" name="nome" required maxlength="80" autocomplete="name" value="<%= values.nome || '' %>" />
              </label>
              <label>WhatsApp (com DDD)
                <input type="tel" name="whatsapp" required inputmode="numeric" autocomplete="tel" placeholder="(11) 99999-9999" value="<%= values.whatsapp || '' %>" />
              </label>
              <label>E-mail
                <input type="email" name="email" required maxlength="120" autocomplete="email" placeholder="para receber o ingresso" value="<%= values.email || '' %>" />
              </label>
              <label>CPF
                <input type="text" name="cpf" required inputmode="numeric" autocomplete="off" placeholder="000.000.000-00" maxlength="14" value="<%= values.cpf || '' %>" />
              </label>

              <div class="qty">
                <span class="lab">Quantos ingressos?<small>Até <%= Math.min(maxPer, left) %> por CPF</small></span>
                <div class="stepper">
                  <button type="button" id="minus" aria-label="Menos um ingresso">−</button>
                  <span id="qval"><%= Math.min(Math.max(parseInt(values.quantidade, 10) || 1, 1), Math.min(maxPer, left)) %></span>
                  <button type="button" id="plus" aria-label="Mais um ingresso">+</button>
                </div>
              </div>
              <input type="hidden" name="quantidade" id="qin" value="<%= Math.min(Math.max(parseInt(values.quantidade, 10) || 1, 1), Math.min(maxPer, left)) %>" />

              <label class="check">
                <input type="checkbox" name="consent" <%= values.consent ? 'checked' : '' %> />
                <span>Concordo em informar meus dados para receber o ingresso e avisos sobre este evento, conforme a <a href="/politica-de-privacidade" target="_blank">Política de Privacidade</a>.</span>
              </label>

              <button type="submit" class="cta" id="go">
                <span class="lbl"><span id="cta-text">Garantir minha vaga</span><small id="cta-sub">Gratuito · 1 ingresso</small></span>
                <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg></span>
              </button>
            </form>
            <p class="fine">Cada ingresso é pessoal e vale para uma entrada. Se não puder ir, avise para liberar a vaga.</p>
          <% } %>
        </div>
      </div>
    </section>

    <section class="more">
      <div class="wrap">
        <h2>Fique por <span>dentro</span></h2>
        <p>Entre na comunidade no WhatsApp e receba as novidades em primeira mão.</p>
        <a class="btn-line" href="<%= communityUrl %>" target="_blank" rel="noopener">Entrar na comunidade</a>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap">
      <div class="links">
        <a href="/meus-ingressos">Meus ingressos</a>
        <a href="/politica-de-privacidade">Privacidade</a>
        <a href="/termos-de-uso">Termos</a>
      </div>
      <p class="small"><%= ev.name %> · <%= ev.venue %> · <%= ev.dateLabel %></p>
    </div>
  </footer>

  <script>
    (function () {
      var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      // ----- equalizer bars (same as /links)
      var eq = document.getElementById('eq');
      if (eq && !reduce) {
        var n = Math.max(14, Math.min(44, Math.floor(window.innerWidth / 15)));
        for (var i = 0; i < n; i++) {
          var b = document.createElement('i');
          b.style.setProperty('--h', (25 + Math.random() * 70).toFixed(0) + '%');
          b.style.setProperty('--d', (0.6 + Math.random() * 0.9).toFixed(2) + 's');
          b.style.setProperty('--dl', (-Math.random() * 1.5).toFixed(2) + 's');
          eq.appendChild(b);
        }
      }

      // ----- availability bar + days left
      var bar = document.querySelector('.bar b');
      if (bar) {
        if (reduce) bar.style.transition = 'none';
        var fill = function () { bar.style.width = bar.getAttribute('data-pct') + '%'; };
        setTimeout(fill, 300);
      }
      var dl = document.getElementById('days-left');
      var startAt = Date.parse('<%= ev.startAt || '' %>');
      if (dl && !Number.isNaN(startAt)) {
        var days = Math.ceil((startAt - Date.now()) / 86400000);
        dl.textContent = days > 1 ? 'faltam ' + days + ' dias' : days === 1 ? 'é amanhã' : 'é hoje';
      }

      // ----- form behaviour
      var form = document.getElementById('form');
      if (!form) return;
      var max = <%= Math.min(maxPer, left) %>;
      var qin = document.getElementById('qin');
      var qval = document.getElementById('qval');
      var minus = document.getElementById('minus');
      var plus = document.getElementById('plus');
      var sub = document.getElementById('cta-sub');
      function setQty(n) {
        n = Math.max(1, Math.min(max, n));
        qin.value = n; qval.textContent = n;
        sub.textContent = 'Gratuito · ' + n + (n === 1 ? ' ingresso' : ' ingressos');
        if (n <= 1) minus.setAttribute('disabled', ''); else minus.removeAttribute('disabled');
        if (n >= max) plus.setAttribute('disabled', ''); else plus.removeAttribute('disabled');
      }
      minus.addEventListener('click', function () { setQty(parseInt(qin.value, 10) - 1); });
      plus.addEventListener('click', function () { setQty(parseInt(qin.value, 10) + 1); });
      setQty(parseInt(qin.value, 10) || 1);

      var cpf = form.elements.cpf;
      cpf.addEventListener('input', function () {
        var d = cpf.value.replace(/\D/g, '').slice(0, 11);
        cpf.value = d.replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d)/, '$1.$2').replace(/(\d{3})(\d{1,2})$/, '$1-$2');
      });
      var tel = form.elements.whatsapp;
      tel.addEventListener('input', function () {
        var d = tel.value.replace(/\D/g, '').slice(0, 11);
        tel.value = d.length > 6 ? '(' + d.slice(0, 2) + ') ' + d.slice(2, d.length > 10 ? 7 : 6) + '-' + d.slice(d.length > 10 ? 7 : 6)
          : d.length > 2 ? '(' + d.slice(0, 2) + ') ' + d.slice(2) : d;
      });

      var go = document.getElementById('go');
      function confetti(x, y) {
        if (reduce) return;
        var colors = ['#E5A71B', '#FFFFFF', '#F6C441', '#FF1F8E', '#1E90FF'];
        for (var i = 0; i < 26; i++) {
          var c = document.createElement('span');
          c.className = 'confetti-bit';
          c.style.left = x + 'px'; c.style.top = y + 'px';
          c.style.background = colors[i % colors.length];
          c.style.setProperty('--cx', (Math.random() * 300 - 150) + 'px');
          c.style.setProperty('--cy', (Math.random() * -220 - 30) + 'px');
          c.style.setProperty('--cr', (Math.random() * 720 - 360) + 'deg');
          document.body.appendChild(c);
          setTimeout(function (el) { el.remove(); }, 1000, c);
        }
      }
      go.addEventListener('pointerdown', function (e) {
        if (reduce) return;
        var r = go.getBoundingClientRect();
        var size = Math.max(r.width, r.height) * 1.6;
        var rp = document.createElement('span');
        rp.className = 'ripple';
        rp.style.width = rp.style.height = size + 'px';
        rp.style.left = (e.clientX - r.left - size / 2) + 'px';
        rp.style.top = (e.clientY - r.top - size / 2) + 'px';
        go.appendChild(rp);
        setTimeout(function () { rp.remove(); }, 700);
        confetti(e.clientX, e.clientY);
      });

      form.addEventListener('submit', function (e) {
        var msg = null;
        if (form.elements.nome.value.trim().length < 2) msg = 'Informe seu nome completo.';
        else if (form.elements.whatsapp.value.replace(/\D/g, '').length < 10) msg = 'Informe seu WhatsApp com DDD.';
        else if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(form.elements.email.value.trim())) msg = 'Informe um e-mail válido.';
        else if (cpf.value.replace(/\D/g, '').length !== 11) msg = 'Informe o CPF completo.';
        else if (!form.elements.consent.checked) msg = 'Marque a autorização para continuar.';
        if (msg) {
          e.preventDefault();
          var box = document.querySelector('.alert-sp') || document.createElement('div');
          box.className = 'alert-sp'; box.setAttribute('role', 'alert'); box.textContent = msg;
          form.parentNode.insertBefore(box, form);
          box.scrollIntoView({ block: 'center', behavior: reduce ? 'auto' : 'smooth' });
          return;
        }
        go.classList.add('loading');
        document.getElementById('cta-text').textContent = 'Enviando...';
      });
    })();
  </script>
</body>
</html>
