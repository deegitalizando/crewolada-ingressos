<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Afiliados - Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
  <style>
    .af-sum { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 10px; margin: 0 16px 14px; }
    .af-sum .s { background: #1a1a1a; border: 1px solid var(--card-border); border-radius: 10px; padding: 12px; }
    .af-sum .s span { display: block; font-size: 11px; color: var(--text-dim); text-transform: uppercase; letter-spacing: .05em; }
    .af-sum .s b { display: block; font-size: 22px; margin-top: 2px; }
    .af-sum .s.hi b { color: var(--accent); }
    .acts { display: flex; flex-wrap: wrap; gap: 6px; align-items: center; }
    .acts form { display: inline-flex; gap: 6px; align-items: center; margin: 0; }
    .acts button { width: auto; margin: 0; padding: 6px 10px; font-size: 12px; }
    .acts input[type=text] { width: 120px; padding: 6px 8px; font-size: 12px; }
    .pill { font-size: 11px; font-weight: 800; text-transform: uppercase; padding: 2px 8px; border-radius: 999px; }
    .pill.pendente { background: rgba(255,255,255,.1); } .pill.liberada { background: rgba(229,167,27,.25); color: var(--accent); } .pill.paga { background: rgba(34,197,94,.2); color: #86efac; } .pill.cancelada { background: rgba(239,68,68,.2); color: #fecaca; }
    .mono { font-family: ui-monospace, monospace; font-size: 12px; word-break: break-all; }
    td small { color: var(--text-dim); }
  </style>
</head>
<body>
  <div class="page page-wide">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row">
      <a href="/admin" class="tab">Vendas</a>
      <a href="/admin/eventos" class="tab">Eventos</a>
      <a href="/admin/ingressos" class="tab">Ingressos</a>
      <a href="/admin/cortesias" class="tab">Cortesias</a>
      <a href="/admin/contatos" class="tab">Convites</a>
      <a href="/admin/afiliados" class="tab active">Afiliados</a>
      <a href="/admin/avisos" class="tab">Avisos</a>
      <a href="/admin/links" class="tab">Links</a>
      <a href="/admin/mensagens" class="tab">E-mail e WhatsApp</a>
      <a href="/contabilidade" class="tab">Contabilidade</a>
      <a href="/admin/relatorio" class="tab">Relatório</a>
      <a href="/admin/pesquisa" class="tab">Pesquisa</a>
      <a href="/downloads" class="tab">Músicas</a>
    </nav>

    <% const msgs = { pago: 'Repasse registrado: as comissões disponíveis desse afiliado foram marcadas como pagas.', 'sem-saldo': 'Esse afiliado não tem saldo disponível para pagar.', status: 'Status do afiliado atualizado.', senha: 'Nova senha gerada (veja abaixo).', cancelada: 'Comissão cancelada.', 'nao-encontrado': 'Afiliado não encontrado.' }; %>
    <% if (msg && msgs[msg]) { %><div class="alert" style="margin:0 16px 12px; background:rgba(34,197,94,0.15); border-color:#22c55e; color:#86efac"><%= msgs[msg] %><% if (novaSenha) { %> Senha temporária: <strong class="mono"><%= novaSenha %></strong> (envie ao afiliado; ele só verá isso agora).<% } %></div><% } %>

    <div class="af-sum">
      <div class="s hi"><span>A pagar agora</span><b><%= money(totais.aPagar) %></b></div>
      <div class="s"><span>A liberar (carência)</span><b><%= money(totais.pendente) %></b></div>
      <div class="s"><span>Já pago</span><b><%= money(totais.pago) %></b></div>
      <div class="s"><span>Afiliados</span><b><%= linhas.length %></b></div>
    </div>

    <main class="card">
      <h3 style="margin-top:0">Afiliados</h3>
      <p class="hint" style="margin-top:0; text-align:left">Comissão <%= info.pct %>% · link válido <%= info.dias %> dias · carência <%= info.carencia %> dias · saque mínimo R$ <%= String(info.minSaque).replace('.', ',') %> · divisão <%= info.modo %>. Pague por Pix na chave abaixo e depois clique em <strong>Registrar pagamento</strong>. <a href="/admin/afiliados/exportar.csv" style="color:var(--accent)">Baixar planilha (CSV)</a> · <a href="/afiliados" target="_blank" style="color:var(--accent)">Ver página pública</a></p>
      <% if (linhas.length === 0) { %>
        <p class="hint">Ninguém se cadastrou ainda. A página pública é <strong>/afiliados</strong>.</p>
      <% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Afiliado</th><th>Cliques / vendas</th><th>A pagar</th><th>A liberar</th><th>Pago</th><th>Pix</th><th>Ações</th></tr></thead>
        <tbody>
          <% linhas.forEach(function(l) { %>
            <tr>
              <td><strong><%= l.nome %></strong><% if (l.status !== 'ativo') { %> <span class="pill cancelada">bloqueado</span><% } %><br /><small><%= l.email %> · <%= l.whatsapp %></small><br /><small class="mono"><%= l.codigo %></small></td>
              <td><%= l.r.visitantes %> pessoas<br /><small><%= l.r.vendas %> vendas</small></td>
              <td><strong><%= money(l.r.liberada) %></strong><% if (l.r.liberada >= info.minSaque) { %><br /><span class="pill liberada">pode pagar</span><% } %></td>
              <td><%= money(l.r.pendente) %></td>
              <td><%= money(l.r.paga) %></td>
              <td class="mono"><%= l.pix ? l.pix.tipo + ': ' + l.pix.chave : '-' %><% if (l.banco && (l.banco.banco || l.banco.conta)) { %><br /><small><%= l.banco.banco %> ag <%= l.banco.agencia %> cc <%= l.banco.conta %></small><% } %><br /><small>CPF <%= l.cpf %></small></td>
              <td>
                <div class="acts">
                  <% if (l.r.liberada > 0) { %>
                    <form action="/admin/afiliados/<%= l.id %>/pagar" method="POST" onsubmit="return confirm('Confirma que você JÁ FEZ o Pix de <%= money(l.r.liberada) %> para <%= l.nome.replace(/'/g, '') %>?')">
                      <input type="text" name="obs" placeholder="obs (opcional)" maxlength="120" />
                      <button type="submit">Registrar pagamento</button>
                    </form>
                  <% } %>
                  <form action="/admin/afiliados/<%= l.id %>/status" method="POST"><input type="hidden" name="status" value="<%= l.status === 'ativo' ? 'bloqueado' : 'ativo' %>" /><button type="submit" class="btn-secondary"><%= l.status === 'ativo' ? 'Bloquear' : 'Reativar' %></button></form>
                  <form action="/admin/afiliados/<%= l.id %>/senha" method="POST" onsubmit="return confirm('Gerar uma nova senha para este afiliado?')"><button type="submit" class="btn-secondary">Nova senha</button></form>
                </div>
              </td>
            </tr>
          <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </main>

    <main class="card" style="margin-top:14px">
      <h3 style="margin-top:0">Últimas comissões</h3>
      <% if (comissoes.length === 0) { %><p class="hint">Sem comissões ainda.</p><% } else { %>
      <div class="table-wrap"><table>
        <thead><tr><th>Data</th><th>Afiliado</th><th>Venda</th><th>Comissão</th><th>Parte</th><th>Status</th><th></th></tr></thead>
        <tbody>
          <% comissoes.forEach(function(c) { %>
            <tr><td><%= c.em %></td><td><%= c.nome %></td><td><%= money(c.valorVenda) %></td><td><strong><%= money(c.valor) %></strong></td><td><%= Math.round(c.parte * 100) %>% (<%= c.cliques %> clique<%= c.cliques === 1 ? '' : 's' %>)</td>
            <td><span class="pill <%= c.situacao %>"><%= c.situacao %></span></td>
            <td><% if (c.status === 'ativa') { %><form action="/admin/afiliados/comissoes/<%= encodeURIComponent(c.id) %>/cancelar" method="POST" onsubmit="return confirm('Cancelar esta comissão?')" style="margin:0"><button type="submit" class="btn-secondary" style="width:auto;margin:0;padding:4px 10px;font-size:12px">Cancelar</button></form><% } %></td></tr>
          <% }) %>
        </tbody>
      </table></div>
      <% } %>
    </main>

    <% if (pagamentos.length) { %>
    <main class="card" style="margin-top:14px">
      <h3 style="margin-top:0">Repasses registrados</h3>
      <div class="table-wrap"><table>
        <thead><tr><th>Data</th><th>Afiliado</th><th>Valor</th><th>Obs.</th></tr></thead>
        <tbody><% pagamentos.forEach(function(p) { %><tr><td><%= p.quando %></td><td><%= p.nome %></td><td><strong><%= money(p.valor) %></strong></td><td><%= p.obs || '' %></td></tr><% }) %></tbody>
      </table></div>
    </main>
    <% } %>
  </div>
</body>
</html>
