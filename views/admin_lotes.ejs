<!DOCTYPE html>
<html lang="pt-BR">
<head>
  <title>Lotes - Painel Admin - <%= eventInfo.name %></title>
  <%- include('partials/head') %>
</head>
<body>
  <div class="page page-wide">
    <header class="hero hero-sm">
      <img class="logo logo-sm" src="/img/logo.jpg" alt="<%= eventInfo.name %>" />
      <h1>Painel Admin</h1>
      <form action="/admin/logout" method="POST" class="logout-form">
        <button type="submit" class="link-btn">Sair</button>
      </form>
    </header>

    <nav class="tabs-row">
      <a href="/admin" class="tab">Vendas</a>
      <a href="/admin/lotes" class="tab active">Lotes</a>
      <a href="/admin/mensagens" class="tab">E-mail e WhatsApp</a>
    </nav>

    <main class="card">
      <h3>Lotes de ingresso</h3>
      <p class="hint" style="margin-top:0">
        <%= soldCount %> ingresso<%= soldCount === 1 ? '' : 's' %> ja vendido<%= soldCount === 1 ? '' : 's' %> no total.
        O preco cobrado segue a ordem dos lotes abaixo: o lote 1 vale ate sua quantidade se esgotar, depois passa pro lote 2, e assim por diante.
      </p>

      <% if (saved) { %>
        <div class="alert" style="background:rgba(34,197,94,0.15);border-color:#22c55e;color:#86efac">Salvo com sucesso.</div>
      <% } %>

      <form action="/api/admin/lotes" method="POST" id="lotes-form">
        <div id="lotes-rows"></div>
        <div class="btn-row" style="margin-top:12px">
          <button type="button" class="btn-secondary" id="add-lote">+ Adicionar lote</button>
        </div>
        <button type="submit" style="margin-top:20px">Salvar lotes</button>
      </form>
    </main>
  </div>

  <template id="lote-row-template">
    <div class="lote-row" style="display:flex; gap:8px; align-items:flex-end; margin-bottom:12px; flex-wrap:wrap">
      <label style="flex:2; min-width:140px">
        Nome
        <input type="text" class="lote-name" placeholder="1o Lote" required />
      </label>
      <label style="flex:1; min-width:100px">
        Quantidade
        <input type="number" class="lote-quantity" min="1" required />
      </label>
      <label style="flex:1; min-width:100px">
        Preco (R$)
        <input type="number" class="lote-price" min="0" step="0.01" required />
      </label>
      <button type="button" class="btn-secondary remove-lote" style="margin-top:0; width:auto; padding:12px 16px">Remover</button>
    </div>
  </template>

  <script>
    const lotesData = <%- JSON.stringify(lotes) %>;
    const rowsContainer = document.getElementById('lotes-rows');
    const template = document.getElementById('lote-row-template');

    function addRow(lote) {
      const clone = template.content.cloneNode(true);
      const row = clone.querySelector('.lote-row');
      row.querySelector('.lote-name').value = lote?.name || '';
      row.querySelector('.lote-quantity').value = lote?.quantity ?? '';
      row.querySelector('.lote-price').value = lote?.price ?? '';
      row.querySelector('.remove-lote').addEventListener('click', () => row.remove());
      rowsContainer.appendChild(clone);
    }

    (lotesData.length ? lotesData : [{}]).forEach(addRow);

    document.getElementById('add-lote').addEventListener('click', () => addRow());

    document.getElementById('lotes-form').addEventListener('submit', (e) => {
      e.preventDefault();
      const rows = rowsContainer.querySelectorAll('.lote-row');
      const params = new URLSearchParams();
      rows.forEach((row, i) => {
        params.append(`lotes[${i}][name]`, row.querySelector('.lote-name').value);
        params.append(`lotes[${i}][quantity]`, row.querySelector('.lote-quantity').value);
        params.append(`lotes[${i}][price]`, row.querySelector('.lote-price').value);
      });
      fetch('/api/admin/lotes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
        body: params.toString(),
      }).then(() => { window.location.href = '/admin/lotes?saved=1'; });
    });
  </script>
</body>
</html>
